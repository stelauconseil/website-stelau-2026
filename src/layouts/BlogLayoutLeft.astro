---
import Icon from '@/components/Icon/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';import {Image} from 'astro:assets';import {getEntries,type CollectionEntry} from 'astro:content';import {href,categoriesHref,categoryLabel,dateLabel,type Locale} from '@/config/site';import {readingTime} from '@/js/blogUtils';
interface Props {post:CollectionEntry<'blog'>;lang:Locale;headings:{depth:number;slug:string;text:string}[];}
const {post,lang,headings}=Astro.props;const authors=await getEntries(post.data.authors);const fr=lang==='fr';
---
<BaseLayout title={post.data.title} description={post.data.description} lang={lang} image={post.data.heroImage?.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BlogPosting',headline:post.data.title,description:post.data.description,datePublished:post.data.pubDate.toISOString(),dateModified:(post.data.updatedDate||post.data.pubDate).toISOString(),author:authors.map(a=>({'@type':'Person',name:a.data.name})),publisher:{'@type':'Organization',name:'Stelau'},inLanguage:lang}).replace(/</g,'\u003c')}/>
  <header class="container page-intro article-intro"><a class="back-link" href={href(lang,'blog')}>← {fr?'Retour au Blog':'Back to journal'}</a><div class="article-categories">{post.data.categories.map(c=><a href={categoriesHref(lang,c)} class="icon-text"><Icon name="tags" size={18}/>{categoryLabel(c,lang)}</a>)}</div><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><div class="article-meta">{authors.map(a=><a href={a.data.authorLink} target="_blank" rel="noopener noreferrer"><Image src={a.data.avatar} alt="" width={40} format="webp"/>{a.data.name}</a>)}<time class="icon-text" datetime={post.data.pubDate.toISOString()}><Icon name="calendar-days" size={18}/>{dateLabel(post.data.pubDate,lang)}</time><span class="icon-text"><Icon name="clock" size={18}/>{readingTime(post.body)} min {fr?'de lecture':'read'}</span></div></header>
  {post.data.heroImage&&<div class="container article-cover"><Image src={post.data.heroImage} alt={post.data.title} width={1400} format="webp"/></div>}
  <article class="container article-grid"><aside class="article-aside" data-pagefind-ignore><p class="eyebrow icon-eyebrow"><Icon name="list" size={20}/>{fr?'Dans cet article':'In this article'}</p><nav aria-label={fr?'Sommaire de l’article':'Article contents'}>{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav></aside><div class="prose"><slot/>{post.data.updatedDate&&<p class="article-update">{fr?'Mis à jour le':'Updated on'} {dateLabel(post.data.updatedDate,lang)}</p>}<a class="back-link" href={href(lang,'blog')}>← {fr?'Tous les articles':'All articles'}</a></div></article>
</BaseLayout>
