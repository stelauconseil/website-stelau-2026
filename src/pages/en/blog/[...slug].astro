---
import {render} from 'astro:content';import BlogLayout from '@/layouts/BlogLayoutLeft.astro';import {getAllPosts,postSlug} from '@/js/blogUtils';
export async function getStaticPaths(){return (await getAllPosts('en')).map(post=>({params:{slug:postSlug(post)},props:{post}}));}
const {post}=Astro.props;const {Content,headings}=await render(post);
---
<BlogLayout post={post} headings={headings} lang="en"><Content/></BlogLayout>
