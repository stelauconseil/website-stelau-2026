---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Page from '@/components/Expertise/ExpertiseDetail.astro';
import {expertises} from '@/data/expertises';
export function getStaticPaths(){return expertises.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
---
<BaseLayout lang="fr" title={item.fr.title} description={item.fr.description}><Page lang="fr" slug={item.slug}/></BaseLayout>
