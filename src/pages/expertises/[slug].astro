---
import Page from '@/components/Expertise/ExpertiseRedirect.astro';
import type {ExpertiseSection} from '@/config/site';
import {expertises} from '@/data/expertises';
export function getStaticPaths(){return expertises.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
---
<Page lang="fr" slug={item.slug as ExpertiseSection}/>
