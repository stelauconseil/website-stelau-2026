---
import type { Locale } from '@/config/site';
const { lang } = Astro.props as { lang: Locale };
const fr = lang === 'fr';
const choices = [
  { value: 'system', label: fr ? 'Système' : 'System' },
  { value: 'light', label: fr ? 'Clair' : 'Light' },
  { value: 'dark', label: fr ? 'Sombre' : 'Dark' },
];
---
<div class="theme-picker" data-theme-picker data-label={fr?'Choisir le thème':'Choose colour theme'}>
  <button id="theme-trigger" class="icon-button theme-trigger" type="button" aria-label={fr?'Choisir le thème':'Choose colour theme'} aria-haspopup="menu" aria-expanded="false" aria-controls="theme-options" data-theme-trigger>
    <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
    <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M20.7 13.2A9 9 0 0 1 10.8 3.3a9 9 0 1 0 9.9 9.9Z"/></svg>
  </button>
  <div id="theme-options" class="theme-options" role="menu" aria-labelledby="theme-trigger" hidden>
    {choices.map(choice=><button class="theme-option" type="button" role="menuitemradio" aria-checked="false" tabindex="-1" data-theme-option={choice.value} data-label={choice.label}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        {choice.value==='system'?<><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></>:choice.value==='light'?<><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></>:<path d="M20.7 13.2A9 9 0 0 1 10.8 3.3a9 9 0 1 0 9.9 9.9Z"/>}
      </svg>
      <span>{choice.label}</span>
      <svg class="theme-check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>
    </button>)}
  </div>
</div>
<script>
  const picker = document.querySelector<HTMLElement>('[data-theme-picker]');
  const trigger = picker?.querySelector<HTMLButtonElement>('[data-theme-trigger]');
  const menu = picker?.querySelector<HTMLElement>('[role="menu"]');
  const options = [...(picker?.querySelectorAll<HTMLButtonElement>('[data-theme-option]') || [])];
  const media = matchMedia('(prefers-color-scheme: dark)');
  function applyTheme(preference: string, persist = false) {
    const pref = ['system','light','dark'].includes(preference) ? preference : 'system';
    document.documentElement.dataset.theme = pref;
    document.documentElement.classList.toggle('dark', pref === 'dark' || (pref === 'system' && media.matches));
    for (const option of options) option.setAttribute('aria-checked', String(option.dataset.themeOption === pref));
    const selected = options.find(option => option.dataset.themeOption === pref);
    if (trigger) {
      const label = `${picker?.dataset.label} (${selected?.dataset.label})`;
      trigger.setAttribute('aria-label', label);
      trigger.title = label;
    }
    if (persist) try { localStorage.setItem('stelau-theme',pref); } catch {}
  }
  function closeMenu(returnFocus = false) {
    if (menu) menu.hidden = true;
    trigger?.setAttribute('aria-expanded','false');
    if (returnFocus) trigger?.focus();
  }
  function openMenu(last = false) {
    if (!menu) return;
    menu.hidden = false;
    trigger?.setAttribute('aria-expanded','true');
    (last ? options.at(-1) : options.find(option => option.getAttribute('aria-checked') === 'true') || options[0])?.focus();
  }
  applyTheme(document.documentElement.dataset.theme || 'system');
  media.addEventListener('change', () => {
    if (document.documentElement.dataset.theme === 'system') applyTheme('system');
  });
  trigger?.addEventListener('click', () => menu?.hidden ? openMenu() : closeMenu());
  trigger?.addEventListener('keydown', event => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault(); openMenu(event.key === 'ArrowUp');
    }
  });
  for (const option of options) option.addEventListener('click', () => {
    applyTheme(option.dataset.themeOption || 'system',true); closeMenu(true);
  });
  menu?.addEventListener('keydown', event => {
    const index = options.indexOf(document.activeElement as HTMLButtonElement);
    const next = event.key === 'ArrowDown' ? (index+1)%options.length : event.key === 'ArrowUp' ? (index+options.length-1)%options.length : event.key === 'Home' ? 0 : event.key === 'End' ? options.length-1 : undefined;
    if (next !== undefined) { event.preventDefault(); options[next]?.focus(); }
    if (event.key === 'Tab') closeMenu();
  });
  document.addEventListener('pointerdown', event => {
    if (!picker?.contains(event.target as Node)) closeMenu();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu && !menu.hidden) { event.preventDefault(); closeMenu(true); }
  });
  picker?.addEventListener('focusout', event => {
    if (!picker.contains(event.relatedTarget as Node | null)) closeMenu();
  });
</script>
