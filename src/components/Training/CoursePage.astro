---
import {Image} from 'astro:assets';
import PrimitiveBadges from './PrimitiveBadges.astro';
import interceptionImage from '@/assets/images/training/atelier-dh-war.webp';
import puzzleImage from '@/assets/images/training/atelier-wannacry-puzzle.webp';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import CourseScene from './CourseScene.astro';
import TrainingNav from './TrainingNav.astro';
import WorkshopTeaser from './WorkshopTeaser.astro';
import {href,openidTrainingHref,type Locale} from '@/config/site';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
const gameRules='https://github.com/stelauconseil/EGE-Introduction-Cryptographie-Moderne/blob/main/Ateliers-Jeux/DH%20War%20-%20Ennemy%20in%20the%20Middle/Stelau-EGE%20-DH%20War-%20Ennemy%20in%20the%20Middle.pdf';
const puzzleStory='https://github.com/stelauconseil/EGE-Introduction-Cryptographie-Moderne/blob/main/Ateliers-Jeux/Wannacry%20Nightmare%20Puzzle/README.md';
const workshop=fr?[
 ['certificate','01','Un certificat, c’est déjà un assemblage.','Une identité, une clé publique et la signature d’une autorité. Le fichier se construit sous vos yeux, de l’empreinte à la vérification.'],
 ['tls','02','Une connexion sécurisée a une architecture.','Établissement de clés, authentification, chiffrement et dérivation : repérer le rôle de chaque brique dans TLS.'],
 ['aes','03','Un bit change. Tout se propage.','Substitution, décalage des lignes, mélange des colonnes, clé de tour : les octets d’AES se transforment réellement.'],
 ['totp','04','Le temps entre dans le calcul.','Un secret partagé, un compteur temporel et un HMAC : suivre le calcul d’un code TOTP et sa fenêtre de renouvellement.'],
]:[
 ['certificate','01','A certificate is already an assembly.','An identity, a public key and an authority’s signature. Watch the file take shape, from the digest to verification.'],
 ['tls','02','A secure connection has an architecture.','Key agreement, authentication, encryption and derivation: identify what each component contributes to TLS.'],
 ['aes','03','One bit changes. The effect spreads.','Substitution, row shifting, column mixing and round keys: watch AES bytes actually change.'],
 ['totp','04','Time becomes part of the calculation.','A shared secret, a time counter and an HMAC: follow a TOTP code calculation and its renewal window.'],
];
---
<section class="container page-intro training-intro"><TrainingNav lang={lang} current="crypto"/><div class="training-intro-top"><p class="eyebrow icon-eyebrow"><Icon name="graduation-cap" size={24}/>{fr?'Cours Stelau / EPITA · EGE · ESG':'Stelau courses / EPITA · EGE · ESG'}</p><PrimitiveBadges lang={lang}/></div><div class="training-hero-grid"><h1>{fr?'La cryptographie':'Cryptography'}<br/><em>{fr?'prend forme.':'takes shape.'}</em></h1><div><p class="lead">{fr?'Les algorithmes sont des briques. Comprendre comment on les assemble, c’est commencer à comprendre la sécurité d’un système.':'Algorithms are building blocks. Understanding how they fit together is the first step towards understanding a system’s security.'}</p><p class="training-hero-meta">{fr?'Plus de quinze ans de transmission, nourris par les missions de terrain de Stelau.':'Over fifteen years of teaching, informed by Stelau’s work in the field.'}</p></div></div><div class="training-actions"><a class="button" href="#primitives">{fr?'Voir les cinq primitives':'Watch the five primitives'}<Arrow/></a><a class="text-link" href="#pedagogie">{fr?'Découvrir le cours':'Explore the course'}<Arrow/></a><WorkshopTeaser lang={lang}/></div></section>

<section class="container training-primitives" id="primitives" aria-labelledby="primitives-title"><div class="training-section-heading"><div><p class="eyebrow">01 / {fr?'Le langage commun':'The common language'}</p><h2 id="primitives-title">{fr?'Cinq primitives.':'Five primitives.'}<br/><em>{fr?'Déjà tout un monde.':'A whole world of possibilities.'}</em></h2></div><p>{fr?'Chiffrement symétrique, asymétrique, hachage, établissement de clés et génération d’aléa : voir les données circuler, les clés intervenir et les résultats apparaître.':'Symmetric and asymmetric cryptography, hashing, key agreement and randomness: watch data move, keys come into play and results appear.'}</p></div><CourseScene scene="primitives" id="primitives-scene" lang={lang}/><p class="training-fineprint">{fr?'Scènes originales du cours, animées en GSAP. Valeurs et paramètres simplifiés pour comprendre les mécanismes ; les exemples SHA-1 et Diffie-Hellman à petits nombres ont une vocation pédagogique.':'Original GSAP course scenes. Values and parameters are simplified to explain the mechanisms; SHA-1 and small-number Diffie–Hellman examples are for teaching.'}</p></section>

<section class="container training-section training-manifesto" id="pedagogie"><div><p class="eyebrow">02 / {fr?'Le vrai fil conducteur':'The guiding idea'}</p><h2>{fr?'La sécurité se joue':'Security depends on'}<br/><em>{fr?'dans les assemblages.':'the assembly.'}</em></h2></div><div><p>{fr?'Un certificat est un fichier statique. Un passeport électronique enchaîne des protocoles pour vérifier une puce, établir un canal protégé et contrôler l’accès à ses données, dont les empreintes biométriques sensibles. Entre les deux, les mêmes questions reviennent.':'A certificate is a static file. An electronic passport combines protocols to authenticate a chip, establish a protected channel and control access to its data, including sensitive biometric fingerprints. The same questions connect them.'}</p><div class="training-questions"><p><span>01</span>{fr?'Qui possède quelle clé ?':'Who holds which key?'}</p><p><span>02</span>{fr?'Qu’est-ce qui est signé, chiffré ou vérifié ?':'What is signed, encrypted or verified?'}</p><p><span>03</span>{fr?'Que se passe-t-il si une brique manque ?':'What happens when a component is missing?'}</p></div><p>{fr?'Le cours donne les repères pour lire ces montages et en discuter les garanties comme les limites.':'The course provides the foundations for reading these constructions and discussing their guarantees and limitations.'}</p></div></section>

<section class="container training-section training-workshop" aria-labelledby="workshop-title"><div class="training-section-heading"><div><p class="eyebrow">03 / {fr?'Dans le cours':'Inside the course'}</p><h2 id="workshop-title">{fr?'Les montages':'The constructions'}<br/><em>{fr?'se construisent devant vous.':'take shape in front of you.'}</em></h2></div></div>
 {workshop.map(([scene,num,title,copy])=><article class="training-scene-article" id={`atelier-${scene}`}><div class="training-scene-intro"><p class="eyebrow">{num} / {scene==='certificate'?'X.509':scene==='tls'?'TLS':scene==='aes'?'AES-128':'RFC 6238'}</p><h3>{title}</h3><p>{copy}</p></div><CourseScene scene={scene as 'certificate'|'tls'|'aes'|'totp'} lang={lang}/>{scene==='certificate'&&<p class="training-fineprint">{fr?'Modèle pédagogique : la signature porte sur les données affichées. Un certificat X.509 réel suit une structure ASN.1 et des règles de validation supplémentaires.':'Teaching model: the signature covers the displayed data. A real X.509 certificate uses an ASN.1 structure and requires additional validation rules.'}</p>}{scene==='totp'&&<p class="training-fineprint">{fr?'Les deux premières lignes illustrent des hachages simplifiés. Le calcul détaillé du bas suit RFC 6238 : HMAC, compteur de 30 secondes et troncature dynamique. Un code TOTP est calculé localement ; ce n’est pas un SMS.':'The first two rows illustrate simplified hashes. The lower calculation follows RFC 6238: HMAC, a 30-second counter and dynamic truncation. A TOTP code is computed locally; it is not an SMS.'}</p>}{scene==='tls'&&<p class="training-fineprint">{fr?'La nomenclature des suites illustre notamment TLS 1.2. En TLS 1.3, l’échange de clés et l’authentification sont négociés séparément. Le schéma simplifie les échanges.':'Cipher-suite names include TLS 1.2 examples. TLS 1.3 negotiates key exchange and authentication separately. The diagram simplifies the exchanges.'}</p>}</article>)}
</section>

<section class="container training-section" id="ateliers-jeux" aria-labelledby="teaching-title"><div class="training-section-heading"><div><p class="eyebrow">04 / {fr?'Comprendre en pratiquant':'Learning by doing'}</p><h2 id="teaching-title">{fr?'À vous':'Your turn'}<br/><em>{fr?'d’assembler.':'to assemble.'}</em></h2></div><p>{fr?'Le syllabus EGE associe cours illustrés et ateliers en équipe. Aucun bagage théorique en cryptographie n’est requis pour commencer : la progression va des cinq briques aux systèmes qui les combinent.':'The EGE syllabus combines illustrated teaching with team workshops. No prior theoretical knowledge of cryptography is required: the course progresses from the five building blocks to systems that combine them.'}</p></div><div class="training-games"><article><Icon name="binoculars" size={34}/><p class="eyebrow">{fr?'Atelier / Interception':'Workshop / Interception'}</p><h3>{fr?'« Attaque-moi si tu peux ! »':'“Attack me if you can!”'}</h3><figure class="training-game-image training-game-sheets"><Image src={interceptionImage} alt={fr?'Les quatre fiches du jeu DH War : consignes, rôles et tables utilisées pour l’atelier d’interception.':'The four DH War game sheets: instructions, roles and tables used in the interception workshop.'} width={730} widths={[360,520,730]} sizes="(max-width:720px) 80vw, 40vw" format="webp" loading="lazy"/></figure><p class="training-game-hook">{fr?'Dix joueurs. Trois rôles. Qui contrôle le message ?':'Ten players. Three roles. Who controls the message?'}</p>
<p class="training-game-copy">{fr?<>Trois à l’<strong>état-major</strong> transmettent les ordres ; trois <strong>commandos</strong> doivent les exécuter ; quatre <strong>ennemis</strong> interceptent et falsifient les échanges. Établissez votre secret avec Diffie-Hellman, puis gardez le contact lorsque l’ennemi prend le contrôle du canal. Saurez-vous faire parvenir le véritable ordre d’attaque ?</>:<>Three at <strong>headquarters</strong> issue orders, three <strong>commandos</strong> must carry them out, and four <strong>enemies</strong> intercept and tamper with messages. Agree on a secret using Diffie–Hellman, then keep communicating when the enemy takes over the channel. Can you get the genuine attack order through?</>}</p>
<a class="text-link training-game-link" href={gameRules} target="_blank" rel="noopener noreferrer">{fr?'Les règles du jeu · PDF':'Game rules · PDF in French'}<Arrow/></a></article><article><Icon name="puzzle-piece" size={34}/><p class="eyebrow">{fr?'Atelier / Puzzle cryptographique':'Workshop / Cryptographic puzzle'}</p><h3>WannaCry nightmare</h3><figure class="training-game-image training-game-puzzle"><Image src={puzzleImage} alt={fr?'Les fiches du puzzle WannaCry Nightmare disposées sur une table avec une bougie et un café.':'WannaCry Nightmare puzzle sheets laid out on a table with a candle and a coffee.'} width={423} widths={[280,423]} sizes="(max-width:720px) 80vw, 40vw" format="webp" loading="lazy"/></figure><p class="training-game-hook">{fr?'Un chiffrement solide. Une issue inattendue.':'Strong encryption. An unexpected way out.'}</p>
<p class="training-game-copy">{fr?'2017 : des outils de la NSA divulgués, une attaque mondiale, des fichiers pris en otage… puis des traces de clés privées retrouvées en mémoire sur certains Windows. À cinq, reconstituez l’assemblage de WannaCry et remontez le fil de l’affaire. Comment un chiffrement redoutable a-t-il pu laisser une possibilité de récupérer les fichiers ?':'2017: leaked NSA tools, a global attack, files held hostage… then traces of private keys found in memory on some Windows systems. In a team of five, reconstruct WannaCry’s cryptographic design and follow the trail. How could formidable encryption still leave a chance to recover the files?'}</p>
<a class="text-link training-game-link" href={puzzleStory} target="_blank" rel="noopener noreferrer">{fr?'L’intrigue et les ressources':'Story and resources · in French'}<Arrow/></a></article></div><div class="training-program"><h3>{fr?'Les briques rencontrent la vraie vie.':'The building blocks meet real life.'}</h3><p>{fr?'Titres d’identité, Bitcoin, TLS, VPN, messageries, cachets visibles et signature électronique : des cas concrets pour apprendre à expliquer un mécanisme, pas seulement à citer son nom.':'Identity documents, Bitcoin, TLS, VPNs, messaging, visible digital seals and electronic signatures: practical cases to learn how to explain a mechanism, beyond naming it.'}</p></div></section>

<section class="container training-section training-next"><div><p class="eyebrow icon-eyebrow"><Icon name="flask-vial" size={25}/>{fr?'Pour continuer à expérimenter':'Keep experimenting'}</p><h2>{fr?'Les primitives comprises.':'Understanding the primitives.'}<br/><em>{fr?'Les protocoles à explorer.':'Exploring the protocols.'}</em></h2><p>{fr?'Prolongez le cours avec OIDApp et son CryptoLab : signer, altérer, vérifier et comprendre les protections d’OpenID par la manipulation.':'Continue with OIDApp and its CryptoLab: sign, tamper, verify and learn how OpenID protections work through hands-on experiments.'}</p><a class="button" href={openidTrainingHref(lang)}>{fr?'Découvrir OpenID / CryptoLab':'Explore OpenID / CryptoLab'}<Arrow/></a></div><div class="training-contact"><Icon name="mug-hot" size={42}/><h3>{fr?'Faire vivre ce cours dans votre école ?':'Bring this course to your school?'}</h3><p>{fr?'EPITA, EGE, ESG : le contenu s’adapte au public et au temps disponible. Échangeons sur votre programme.':'At EPITA, EGE and ESG, the content adapts to the audience and available time. Let’s discuss your programme.'}</p><a class="text-link" href={href(lang,'contact')}>{fr?'Contacter Stelau':'Contact Stelau'}<Arrow/></a></div></section>
<style>
 .training-intro-top{display:flex;align-items:center;justify-content:space-between;gap:24px}.training-intro-top>.eyebrow{margin:0}.training-game-image{display:flex;align-items:center;justify-content:center;height:210px;margin:24px 0;border:1px solid var(--line);border-radius:10px;overflow:hidden}.training-game-image :global(img){display:block;width:100%;height:100%;object-fit:contain}.training-game-sheets{background:#ededed}.training-game-puzzle{background:#2d1d11}@media(max-width:720px){.training-intro-top{flex-direction:column;align-items:flex-start;gap:22px}.training-game-image{height:190px;margin:22px 0}}
 .training-intro{padding-bottom:55px}.training-hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:70px;align-items:end;margin-top:24px}.training-hero-grid h1{font-size:clamp(45px,5.4vw,78px)}.training-hero-grid .lead{font-size:22px;line-height:1.65;max-width:580px}.training-hero-meta{font-size:14px;line-height:1.8;margin-top:22px}.training-actions{display:flex;flex-wrap:wrap;align-items:center;gap:28px;margin-top:35px}.training-primitives{padding-bottom:25px;scroll-margin-top:35px}.training-section{padding-top:80px;padding-bottom:35px;scroll-margin-top:35px}.training-section-heading{display:grid;grid-template-columns:1.05fr 1fr;gap:70px;align-items:end;margin-bottom:32px}.training-section-heading h2{font-size:clamp(34px,3.6vw,48px);margin-top:16px}.training-section-heading>p{font-size:17px;line-height:1.9}.training-fineprint{font-size:12px;line-height:1.9;margin-top:15px;color:var(--muted)}.training-manifesto{display:grid;grid-template-columns:1fr 1.1fr;gap:80px;border-top:1px solid var(--line);margin-top:60px}.training-manifesto h2{font-size:clamp(34px,3.7vw,50px);margin-top:18px}.training-manifesto>div>p:not(.eyebrow){font-size:18px;line-height:1.95}.training-questions{margin:28px 0 30px;border-top:1px solid var(--line)}.training-questions p{display:flex;align-items:baseline;gap:18px;padding:15px 0;border-bottom:1px solid var(--line);font-size:19px;color:var(--ink)}.training-questions span{font:12px var(--font-mono);color:var(--brand);flex-shrink:0}.training-scene-article{padding:38px 0 22px}.training-scene-intro{display:grid;grid-template-columns:130px minmax(0,.95fr) minmax(0,1fr);gap:30px;align-items:start;margin-bottom:24px}.training-scene-intro .eyebrow{padding-top:7px;color:var(--brand)}.training-scene-intro h3{font-size:27px;line-height:1.25}.training-scene-intro>p:last-child{font-size:16px;line-height:1.85}.training-games{display:grid;grid-template-columns:1fr 1fr;gap:26px}.training-games article{display:flex;flex-direction:column;min-width:0;padding:32px;background:var(--surface);border:1px solid var(--line);border-radius:15px}.training-games .eyebrow{font-size:11px;margin-top:25px}.training-games h3{font-size:28px;margin:14px 0 18px}.training-games .training-game-hook{font-size:18px;line-height:1.55;font-weight:600;color:var(--ink);margin:0 0 14px}.training-games .training-game-copy{font-size:16px;line-height:1.9;margin:0 0 25px}.training-game-copy strong{color:var(--ink);font-weight:600}.training-games .training-game-link{font-size:14px;align-self:flex-start;margin-top:auto}.training-game-image{flex-shrink:0}.training-program{margin-top:32px;padding:28px 0;border-top:1px solid var(--line)}.training-program h3{font-size:26px;margin-bottom:16px}.training-program>p:not(.training-fineprint){font-size:17px;line-height:1.9;max-width:920px}.training-next{display:grid;grid-template-columns:1.4fr 1fr;gap:70px;border-top:1px solid var(--line);margin-top:45px;padding-bottom:90px}.training-next h2{font-size:clamp(32px,3.5vw,46px);margin-top:20px}.training-next>div>p:not(.eyebrow){font-size:16px;line-height:1.9;margin:23px 0}.training-next .button{margin-top:8px}.training-contact{padding:30px;border-radius:15px;border:1px solid var(--line);background:var(--soft)}.training-contact h3{margin-top:24px;font-size:27px;line-height:1.25}.training-contact p{font-size:15px!important}.training-contact .text-link{margin-top:10px}@media(max-width:1000px){.training-hero-grid,.training-section-heading,.training-manifesto,.training-next{gap:35px}.training-hero-grid .lead{font-size:19px}.training-scene-intro{grid-template-columns:90px 1fr;gap:14px 24px}.training-scene-intro>p:last-child{grid-column:2}}@media(max-width:720px){.training-hero-grid,.training-section-heading,.training-manifesto,.training-next{grid-template-columns:1fr;gap:26px}.training-hero-grid h1{font-size:clamp(44px,10vw,64px)}.training-intro{padding-bottom:38px}.training-section{padding-top:50px;padding-bottom:20px}.training-section-heading h2{font-size:36px}.training-section-heading>p{font-size:16px}.training-manifesto{margin-top:30px}.training-manifesto>div>p:not(.eyebrow){font-size:16px}.training-questions p{font-size:17px}.training-scene-intro{grid-template-columns:1fr;gap:13px}.training-scene-intro>p:last-child{grid-column:1}.training-scene-intro h3{font-size:26px}.training-scene-article{padding-top:28px}.training-games{grid-template-columns:1fr;gap:18px}.training-games article{padding:25px}.training-next{padding-bottom:60px;margin-top:25px}.training-next h2{font-size:34px}.training-fineprint{font-size:11px}.training-actions{gap:20px}.training-actions .text-link{font-size:14px}}
</style>
