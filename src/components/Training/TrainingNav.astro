---
import {formationHref,openidTrainingHref,type Locale} from '@/config/site';
const {lang,current}=Astro.props as {lang:Locale;current:'crypto'|'openid'};
---
<nav class="training-nav" aria-label={lang==='fr'?'Nos formations':'Our training'}><a href={formationHref(lang)} aria-current={current==='crypto'?'page':undefined}>{lang==='fr'?'Cryptographie moderne':'Modern cryptography'}</a><a href={openidTrainingHref(lang)} aria-current={current==='openid'?'page':undefined}>OpenID / CryptoLab <span aria-hidden="true">→</span></a></nav>
<style>.training-nav{display:flex;flex-wrap:wrap;gap:12px 28px;margin-bottom:36px}.training-nav a{font-size:13px;color:var(--muted);padding-bottom:8px;border-bottom:1px solid var(--line)}.training-nav a[aria-current]{color:var(--brand);border-color:var(--brand)}.training-nav a:hover{color:var(--ink)}.training-nav span{margin-left:9px}@media(max-width:720px){.training-nav{gap:15px 25px;margin-bottom:28px}.training-nav a{font-size:12px}}</style>
