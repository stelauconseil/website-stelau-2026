---
import {Image} from 'astro:assets';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import {externalLearning,type Locale} from '@/config/site';
import screenLight from '@/assets/images/training/atelier-crypto-light.png';
import screenDark from '@/assets/images/training/atelier-crypto-dark.png';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
const root=externalLearning.cryptoWorkshop;
const families=fr?['Chiffrement symétrique','Hachage, MAC et dérivation','Établissement de clés','Chiffrement asymétrique','Signatures','Aléa et générateurs']:['Symmetric encryption','Hashing, MACs and derivation','Key agreement','Asymmetric encryption','Signatures','Randomness and generators'];
---
<section class="container crypto-workshop" id="atelier-crypto" aria-labelledby="crypto-workshop-title" data-crypto-workshop>
 <div class="crypto-workshop-grid"><div class="crypto-workshop-copy"><p class="eyebrow">05 / {fr?'L’Atelier crypto en ligne':'The online cryptography workshop'}</p><h2 id="crypto-workshop-title">{fr?'Les algorithmes.':'The algorithms.'}<br/><em>{fr?'Entre vos mains.':'In your hands.'}</em></h2><p>{fr?'Le cours continue sur crypto.stelau.com. Chiffrez, déchiffrez, signez, altérez un bit et vérifiez. Les calculs s’exécutent dans votre navigateur ; les clés, les messages et les résultats se lisent octet par octet.':'Continue the course at crypto.stelau.com. Encrypt, decrypt, sign, flip a bit and verify. Calculations run in your browser; inspect keys, messages and results byte by byte.'}</p><ul class="crypto-workshop-families" aria-label={fr?'Six familles à explorer':'Six families to explore'}>{families.map(label=><li>{label}</li>)}</ul><a class="button" href={root} target="_blank" rel="noopener noreferrer">{fr?'Ouvrir l’Atelier crypto':'Open Atelier crypto'}<Arrow/></a>{!fr&&<p class="crypto-workshop-language">The Atelier crypto interface is currently in French.</p>}</div>
 <figure class="crypto-workshop-screen"><div class="crypto-workshop-browser"><span class="mono">crypto.stelau.com</span><span>{fr?'L’atelier en action':'The workshop in action'}</span></div><a href={root} target="_blank" rel="noopener noreferrer" aria-label={fr?'Explorer l’Atelier crypto en ligne':'Explore the online Atelier crypto'}><Image class="crypto-workshop-light" src={screenLight} alt={fr?'Accueil de l’Atelier crypto : familles d’algorithmes et animation du chiffrement hybride.':'Atelier crypto home screen showing algorithm families and an animated hybrid encryption example.'} width={1280} widths={[480,800,1280]} sizes="(max-width:720px) calc(100vw - 44px), 55vw" format="webp" loading="lazy"/><Image class="crypto-workshop-dark" src={screenDark} alt={fr?'L’Atelier crypto en thème sombre.':'Atelier crypto in the dark theme.'} width={1280} widths={[480,800,1280]} sizes="(max-width:720px) calc(100vw - 44px), 55vw" format="webp" loading="lazy"/></a><figcaption>{fr?'Des bancs d’essai, les formats des octets, les planches du cours et une frise historique.':'Hands-on labs, byte formats, course reference sheets and a historical timeline.'}</figcaption></figure></div>
</section>
<section class="container crypto-workshop-choices" id="choisir-et-verifier" aria-labelledby="crypto-workshop-choices-title">
 <div class="crypto-workshop-heading"><div><p class="eyebrow">06 / {fr?'Choisir et vérifier':'Choose and verify'}</p><h2 id="crypto-workshop-choices-title">{fr?'Comparer les garanties.':'Compare the guarantees.'}<br/><em>{fr?'Remonter jusqu’au code.':'Trace them back to the code.'}</em></h2></div><p>{fr?'Distinguer ce qu’il faut écarter, comprendre les constructions actuelles et vérifier ce que fait réellement une implémentation : l’atelier relie ces trois réflexes.':'Identify what to avoid, understand current constructions and inspect what an implementation actually does: the workshop connects these three habits.'}</p></div>
 <div class="crypto-workshop-cards">
  <article class="crypto-workshop-avoid"><Icon name="microscope" size={31}/><span class="crypto-workshop-tag">{fr?'À ne pas reproduire':'What to avoid'}</span><h3>{fr?'Comprendre pourquoi ça casse.':'Understand why it breaks.'}</h3><p>{fr?'ECB, RSA brut, générateurs prédictibles : manipuler leurs limites et observer les structures révélées, les falsifications ou les secrets retrouvés.':'ECB, textbook RSA and predictable generators: explore their limits and observe leaked patterns, forgeries or recovered secrets.'}</p><a class="text-link" href={root+'#/algo/ecb'} target="_blank" rel="noopener noreferrer">{fr?'Explorer les limites d’ECB':'Explore ECB’s limitations'}<Arrow/></a></article>
  <article class="crypto-workshop-current"><Icon name="file-check" size={31}/><span class="crypto-workshop-tag">{fr?'Constructions actuelles':'Current constructions'}</span><h3>{fr?'Des garanties, sous conditions.':'Guarantees, with conditions.'}</h3><p>{fr?'AES-GCM, ChaCha20-Poly1305, HPKE et mécanismes post-quantiques : relier leurs garanties aux paramètres, à la gestion des clés et au contexte d’utilisation.':'AES-GCM, ChaCha20-Poly1305, HPKE and post-quantum mechanisms: connect their guarantees to parameters, key management and the context of use.'}</p><a class="text-link" href={root+'#/algo/gcm'} target="_blank" rel="noopener noreferrer">{fr?'Essayer AES-GCM':'Try AES-GCM'}<Arrow/></a></article>
  <article class="crypto-workshop-source"><Icon name="brackets-curly" size={31}/><span class="crypto-workshop-tag">{fr?'Le code exécuté':'The code that runs'}</span><h3>{fr?'Ce que vous voyez est ce qui tourne.':'See the code behind the result.'}</h3><p>{fr?'L’onglet « Le code » expose les extraits TypeScript issus des sources : appels WebCrypto, bibliothèques @noble et implémentations pédagogiques. Des octets affichés au code qui les produit.':'The “Le code” tab displays TypeScript excerpts from the source files: WebCrypto calls, @noble libraries and teaching implementations. Follow the displayed bytes back to the code that produces them.'}</p><a class="text-link" href={root+'#/algo/sha256'} target="_blank" rel="noopener noreferrer">{fr?'Explorer SHA-256 et son code':'Explore SHA-256 and its code'}<Arrow/></a></article>
 </div>
</section>
<style>
 .crypto-workshop{padding-top:65px;padding-bottom:28px;margin-top:30px;border-top:1px solid var(--line);scroll-margin-top:35px}.crypto-workshop-grid{display:grid;grid-template-columns:.9fr 1.2fr;gap:48px;align-items:center}.crypto-workshop-copy h2{font-size:clamp(32px,3.6vw,48px);margin:18px 0 24px}.crypto-workshop-copy>p:not(.eyebrow){font-size:17px;line-height:1.9}.crypto-workshop-families{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:24px 0 27px}.crypto-workshop-families li{font:10px/1.5 var(--font-mono);padding:7px 9px;border:1px solid var(--line);border-radius:6px;color:var(--muted);background:var(--surface)}.crypto-workshop-copy .button{max-width:100%;white-space:normal}.crypto-workshop-copy .crypto-workshop-language{font-size:12px!important;line-height:1.7;margin-top:14px;color:var(--muted)}
 .crypto-workshop-screen{margin:0;min-width:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--surface);box-shadow:0 20px 50px #00000008}.crypto-workshop-browser{display:flex;justify-content:space-between;gap:14px;padding:14px 18px;border-bottom:1px solid var(--line);font-size:10px;color:var(--muted)}.crypto-workshop-browser .mono{color:var(--brand)}.crypto-workshop-screen :global(img){display:block;width:100%;height:auto}.crypto-workshop-screen :global(.crypto-workshop-dark){display:none}:global(.dark) .crypto-workshop-screen :global(.crypto-workshop-light){display:none}:global(.dark) .crypto-workshop-screen :global(.crypto-workshop-dark){display:block}.crypto-workshop-screen figcaption{padding:13px 18px;border-top:1px solid var(--line);font-size:11px;line-height:1.7;color:var(--muted)}
 .crypto-workshop-choices{padding-top:55px;padding-bottom:25px;scroll-margin-top:35px}.crypto-workshop-heading{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:end;margin-bottom:30px}.crypto-workshop-heading h2{font-size:clamp(32px,3.6vw,48px);margin-top:18px}.crypto-workshop-heading>p{font-size:17px;line-height:1.9}.crypto-workshop-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.crypto-workshop-cards article{display:flex;flex-direction:column;min-width:0;padding:29px 25px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.crypto-workshop-tag{align-self:flex-start;display:inline-block;margin:24px 0 17px;padding:5px 8px;border-radius:5px;font:10px/1.5 var(--font-mono);color:var(--brand);background:var(--soft)}.crypto-workshop-avoid .crypto-workshop-tag{color:#a2394f;background:#fff0f2}.crypto-workshop-current .crypto-workshop-tag{color:#256d56;background:#eaf7f0}:global(.dark) .crypto-workshop-avoid .crypto-workshop-tag{color:#f2a5b4;background:#3e2930}:global(.dark) .crypto-workshop-current .crypto-workshop-tag{color:#8bdbb8;background:#223d33}.crypto-workshop-cards h3{font-size:25px;line-height:1.25;margin-bottom:18px}.crypto-workshop-cards p{font-size:15px;line-height:1.9;margin:0 0 26px}.crypto-workshop-cards .text-link{align-self:flex-start;font-size:13px;margin-top:auto}.crypto-workshop-cards :global(.arrow){width:19px;height:19px;flex-shrink:0}
 @media(max-width:1000px){.crypto-workshop-grid{gap:28px;grid-template-columns:1fr 1fr}.crypto-workshop-heading{gap:30px}.crypto-workshop-cards{gap:15px}.crypto-workshop-cards article{padding:24px 19px}.crypto-workshop-cards h3{font-size:23px}}@media(max-width:720px){.crypto-workshop{padding-top:42px;margin-top:22px}.crypto-workshop-grid,.crypto-workshop-heading,.crypto-workshop-cards{grid-template-columns:1fr;gap:25px}.crypto-workshop-copy h2,.crypto-workshop-heading h2{font-size:35px}.crypto-workshop-copy>p:not(.eyebrow),.crypto-workshop-heading>p{font-size:16px}.crypto-workshop-families li{font-size:10px}.crypto-workshop-choices{padding-top:38px}.crypto-workshop-cards article{padding:25px}.crypto-workshop-cards h3{font-size:26px}.crypto-workshop-browser{padding:13px;font-size:10px}.crypto-workshop-browser>span:last-child{display:none}.crypto-workshop-screen figcaption{padding:13px;font-size:11px}}
</style>
