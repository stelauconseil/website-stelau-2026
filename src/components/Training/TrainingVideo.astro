---
import type {Locale} from '@/config/site';
interface Props {lang:Locale;src?:string;poster?:string;captions?:string}
const {lang,src,poster,captions}=Astro.props;const fr=lang==='fr';
const title=fr?'L’évaluation du cours, à l’EPITA':'Course assessment at EPITA';
---
<figure class="training-video" data-course-video data-video-state={src?'ready':'pending'}>
 <div class="training-video-kicker"><span>{fr?'En salle / EPITA':'In the classroom / EPITA'}</span>{!src&&<span class="training-video-status">{fr?'Vidéo à venir':'Coming soon'}</span>}</div>
 {src?<video controls muted playsinline preload="none" poster={poster} width="1280" height="720" aria-label={title}>
   <source src={src} type="video/mp4"/>
   {captions&&<track kind="captions" src={captions} srclang={lang} label={fr?'Français':'English'} default/>}
   <p>{fr?'Votre navigateur ne peut pas lire cette vidéo.':'Your browser cannot play this video.'} <a href={src}>{fr?'Ouvrir la vidéo':'Open the video'}</a></p>
  </video>:<div class="training-video-placeholder" role="img" aria-label={fr?'Emplacement de la vidéo de l’évaluation du cours à l’EPITA. Montage en préparation.':'Placeholder for the EPITA course assessment video. Editing in progress.'}>
   <div class="training-video-frame" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="m19 13 17 11-17 11z" fill="currentColor"/><rect x="4" y="4" width="40" height="40" rx="12" stroke="currentColor" stroke-width="1.3"/></svg><span>{fr?'Montage en préparation':'Editing in progress'}</span></div>
   <span class="training-video-mark" aria-hidden="true">STELAU / CRYPTO</span>
  </div>}
 <figcaption>{title}<span>{fr?'Quelques secondes au cœur de la mise en pratique.':'A brief look at putting the course into practice.'}{src&&(fr?' · Vidéo sans son.':' · Silent video.')}</span></figcaption>
</figure>
<style>
 .training-video{width:100%;min-width:0;margin:0;border:1px solid var(--line);border-radius:13px;overflow:hidden;background:var(--surface);box-shadow:0 12px 35px #00000005}
 .training-video-kicker{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 17px;font:11px/1.5 var(--font-mono);color:var(--muted)}.training-video-status{color:var(--brand);white-space:nowrap}
 .training-video-placeholder{aspect-ratio:16/9;position:relative;display:grid;place-items:center;border-block:1px solid var(--line);background:linear-gradient(135deg,color-mix(in srgb,var(--brand) 7%,transparent),transparent 75%),repeating-linear-gradient(0deg,transparent,transparent 23px,color-mix(in srgb,var(--brand) 7%,transparent) 24px),repeating-linear-gradient(90deg,transparent,transparent 23px,color-mix(in srgb,var(--brand) 7%,transparent) 24px),var(--soft)}
 .training-video-frame{display:grid;justify-items:center;gap:12px;color:var(--brand)}.training-video-frame svg{width:53px;height:53px}.training-video-frame span{font:11px/1.5 var(--font-mono)}.training-video-mark{position:absolute;left:17px;bottom:13px;font:9px/1.5 var(--font-mono);letter-spacing:.08em;color:var(--muted)}
 .training-video figcaption{padding:15px 17px;font-size:14px;line-height:1.5;color:var(--ink)}.training-video figcaption span{display:block;font-size:12px;color:var(--muted);margin-top:3px}.training-video video{display:block;width:100%;height:auto;aspect-ratio:16/9;background:var(--soft)}
 @media(max-width:720px){.training-video{max-width:none}.training-video-kicker{font-size:10px}.training-video figcaption{font-size:13px}.training-video figcaption span{font-size:11px}}
</style>
