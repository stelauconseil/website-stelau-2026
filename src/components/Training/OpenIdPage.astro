---
import {Image} from 'astro:assets';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import TrainingNav from './TrainingNav.astro';
import CryptoLab from './CryptoLab';
import labDark from '@/assets/images/training/oidapp-cryptolab-dark.jpg';
import labLight from '@/assets/images/training/oidapp-cryptolab-light.jpg';
import {formationHref,externalLearning,type Locale} from '@/config/site';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
const modules=fr?[
 ['OAuth 2.0','Déléguer un accès.','Rôles, canaux, Authorization Code, PKCE, tokens et contre-mesures.','oauth2','01'],
 ['OpenID Connect','Authentifier une personne.','ID Token, signatures, Discovery, JWKS et contrôles de validation.','oidc','02'],
 ['OID4VCI','Émettre un credential.','Credential Offer, émission, preuve de possession de clé et formats.','oid4vci','03'],
 ['OID4VP','Présenter ce qui est nécessaire.','Requête DCQL, divulgation sélective, key binding et rejeu.','oid4vp','04'],
]:[
 ['OAuth 2.0','Delegate access.','Roles, channels, Authorization Code, PKCE, tokens and countermeasures.','oauth2','01'],
 ['OpenID Connect','Authenticate a person.','ID Tokens, signatures, Discovery, JWKS and validation checks.','oidc','02'],
 ['OID4VCI','Issue a credential.','Credential Offers, issuance, key possession proofs and formats.','oid4vci','03'],
 ['OID4VP','Present what is necessary.','DCQL requests, selective disclosure, key binding and replay.','oid4vp','04'],
];
---
<section class="container page-intro oid-training-intro"><TrainingNav lang={lang} current="openid"/><p class="eyebrow icon-eyebrow"><Icon name="flask-vial" size={25}/>OIDApp / {fr?'Auto-formation interactive':'Interactive self-study'}</p><div class="oid-training-hero"><div><h1>{fr?'Le protocole':'The protocol'}<br/><em>{fr?'au bout des doigts.':'at your fingertips.'}</em></h1><p class="lead">{fr?'Un jeton signé. Un caractère modifié. Une vérification qui échoue. Les protocoles deviennent plus clairs quand on peut éprouver ce qui les protège.':'A signed token. One changed character. A failed verification. Protocols make more sense when you can test what protects them.'}</p><div class="oid-training-actions"><a class="button" href="#cryptolab">{fr?'Essayer le CryptoLab':'Try the CryptoLab'}<Arrow/></a><a class="text-link" href={externalLearning.oidapp} target="_blank" rel="noopener noreferrer">{fr?'Ouvrir OIDApp':'Open OIDApp'}<Arrow/></a></div></div><div class="oid-training-object" aria-hidden="true"><div class="oid-object-label">ES256 / P-256</div><Icon name="brackets-curly" size={76}/><p>header<br/><span>payload</span><br/>signature</p><div class="oid-object-verdict"><Icon name="check" size={18}/><span>{fr?'Comprendre en vérifiant':'Understand by verifying'}</span></div></div></div></section>

<section class="container oid-training-lab" id="cryptolab" aria-labelledby="cryptolab-title"><div class="oid-training-heading"><div><p class="eyebrow">01 / {fr?'Des calculs, pas un décor':'Computation, not decoration'}</p><h2 id="cryptolab-title">{fr?'Signer. Altérer.':'Sign. Tamper.'}<br/><em>{fr?'Vérifier pour de vrai.':'Verify for real.'}</em></h2></div><p>{fr?'Un avant-goût du CryptoLab, intégré ici avec les fonctions WebCrypto d’OIDApp. Les valeurs se calculent dans votre navigateur ; aucun message ni aucune clé ne sont envoyés à un serveur.':'A taste of the CryptoLab, embedded here using OIDApp’s WebCrypto functions. Values are computed in your browser; no messages or keys are sent to a server.'}</p></div><CryptoLab lang={lang} client:visible/><noscript><p>{fr?'Activez JavaScript pour manipuler ce laboratoire, ou consultez les parcours OIDApp.':'Enable JavaScript to use this lab, or explore the OIDApp learning paths.'}</p></noscript></section>

<section class="container oid-training-section" aria-labelledby="oidapp-paths-title"><div class="oid-training-heading"><div><p class="eyebrow">02 / {fr?'Un fil rouge':'One guiding question'}</p><h2 id="oidapp-paths-title">{fr?'Quel problème':'Which security problem'}<br/><em>{fr?'ce mécanisme résout-il ?':'does this mechanism solve?'}</em></h2></div><p>{fr?'OIDApp relie les primitives aux échanges entre acteurs. On suit les messages pas à pas, on inspecte les requêtes et l’on compare des scénarios attaqués et protégés.':'OIDApp connects primitives to exchanges between actors. Follow messages step by step, inspect requests and compare attacked and protected scenarios.'}</p></div><div class="oid-modules">{modules.map(([name,title,copy,slug,num])=><a href={externalLearning.oidapp+slug} target="_blank" rel="noopener noreferrer"><span class="mono">{num}</span><div><p class="eyebrow">{name}</p><h3>{title}</h3><p>{copy}</p></div><Arrow/></a>)}</div></section>

<section class="container oid-training-section" aria-labelledby="oidapp-full-title"><div class="oid-training-heading"><div><p class="eyebrow">03 / {fr?'Le laboratoire complet':'The full laboratory'}</p><h2 id="oidapp-full-title">{fr?'La même clé.':'The same key.'}<br/><em>{fr?'De l’émission à la présentation.':'From issuance to presentation.'}</em></h2></div><div><p>{fr?'Dans le CryptoLab complet : explorer SHA-256 et PKCE, signer en ES256, vérifier une signature d’ID Token, manipuler une preuve de possession et la divulgation sélective. Le parcours Key Binding relie l’émission d’un credential à sa présentation.':'In the full CryptoLab: explore SHA-256 and PKCE, sign with ES256, verify an ID Token’s signature, and experiment with possession proofs and selective disclosure. The Key Binding journey connects credential issuance to presentation.'}</p><a class="text-link" href={externalLearning.oidapp+'labo-crypto#binding'} target="_blank" rel="noopener noreferrer">{fr?'Explorer le parcours Key Binding':'Explore the Key Binding journey'}<Arrow/></a></div></div><figure class="oid-app-screen"><div class="oid-screen-top"><span class="mono">OIDApp / Crypto Lab</span><a href={externalLearning.oidapp+'labo-crypto'} target="_blank" rel="noopener noreferrer">{fr?'Ouvrir l’application':'Open the application'} ↗</a></div><Image class="oid-screen-light" src={labLight} alt={fr?'Capture du CryptoLab OIDApp : hachage SHA-256, parcours Key Binding et navigation des quatre protocoles en thème clair.':'OIDApp CryptoLab screenshot showing SHA-256, the Key Binding journey and the four protocol modules in the light theme.'} widths={[480,900,1280]} sizes="(max-width:720px) 90vw, 92vw" width={1280} format="webp" loading="lazy"/><Image class="oid-screen-dark" src={labDark} alt={fr?'Capture du CryptoLab OIDApp en thème sombre.':'OIDApp CryptoLab screenshot in the dark theme.'} widths={[480,900,1280]} sizes="(max-width:720px) 90vw, 92vw" width={1280} format="webp" loading="lazy"/><figcaption>{fr?'L’application complète est actuellement proposée en français. Les explications et la manipulation intégrée à cette page sont disponibles en FR et EN.':'The full application is currently in French. This page’s explanations and embedded hands-on lab are available in French and English.'}</figcaption></figure></section>

<section class="container oid-training-section oid-training-reasons"><div><Icon name="route" size={34}/><h3>{fr?'Avancer à son rythme.':'Learn at your own pace.'}</h3><p>{fr?'Parcours, quiz et repères de progression accompagnent la découverte. La progression de l’application est conservée localement et peut être exportée.':'Learning paths, quizzes and progress markers guide discovery. The application stores progress locally and lets you export it.'}</p></div><div><Icon name="microscope" size={34}/><h3>{fr?'Observer les limites.':'Explore the limitations.'}</h3><p>{fr?'Une signature valide ne suffit pas à valider un jeton. Les exercices distinguent les contrôles cryptographiques, le contexte de la requête et les règles du protocole.':'A valid signature is not enough to validate a token. The exercises distinguish cryptographic checks, request context and protocol rules.'}</p></div><div><Icon name="book-open" size={34}/><h3>{fr?'Relier aux spécifications.':'Connect to the specifications.'}</h3><p>{fr?'Un glossaire, une carte des spécifications et un comparateur permettent de replacer chaque mécanisme dans l’ensemble.':'A glossary, a specification map and a comparison tool put each mechanism in context.'}</p></div></section>

<section class="container oid-training-close"><div><p class="eyebrow">{fr?'Les briques avant les protocoles':'The building blocks behind the protocols'}</p><h2>{fr?'Besoin de reprendre':'Want to revisit'}<br/><em>{fr?'la cryptographie à la base ?':'the cryptographic foundations?'}</em></h2><a class="text-link" href={formationHref(lang)}>{fr?'Découvrir le cours Stelau':'Explore Stelau’s course'}<Arrow/></a></div><a class="button" href={externalLearning.oidapp+'labo-crypto'} target="_blank" rel="noopener noreferrer">{fr?'Continuer dans le CryptoLab complet':'Continue in the full CryptoLab'}<Arrow/></a></section>
<style>
 .oid-training-intro{padding-bottom:65px}.oid-training-hero{display:grid;grid-template-columns:1.5fr .7fr;gap:85px;align-items:center;margin-top:25px}.oid-training-hero h1{font-size:clamp(46px,5.4vw,78px)}.oid-training-hero .lead{font-size:21px;line-height:1.8;max-width:800px;margin-top:28px}.oid-training-actions{display:flex;align-items:center;flex-wrap:wrap;gap:28px;margin-top:31px}.oid-training-object{--oid-orange:#a65319;padding:35px;border:1px solid var(--line);background:linear-gradient(140deg,var(--soft),var(--surface));border-radius:22px;transform:rotate(3deg);position:relative;max-width:320px;box-shadow:0 15px 45px #00000007}.oid-object-label{font:10px var(--font-mono);color:var(--oid-orange);margin-bottom:25px}.oid-training-object>p{font:25px/1.8 var(--font-mono);color:var(--muted);margin:24px 0}.oid-training-object>p span{color:var(--ink)}.oid-object-verdict{display:flex;align-items:center;gap:9px;border-top:1px solid var(--line);padding-top:17px;font-size:11px;color:var(--brand)}.oid-training-lab{scroll-margin-top:35px;padding-bottom:25px}.oid-training-heading{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end;margin-bottom:32px}.oid-training-heading h2{font-size:clamp(34px,3.6vw,49px);margin-top:17px}.oid-training-heading>p,.oid-training-heading>div>p:not(.eyebrow){font-size:17px;line-height:1.9}.oid-training-heading .text-link{margin-top:22px}.oid-training-section{padding-top:75px;padding-bottom:25px}.oid-modules{display:grid;grid-template-columns:1fr 1fr;gap:0 45px;border-top:1px solid var(--line)}.oid-modules>a{display:grid;grid-template-columns:28px minmax(0,1fr) 24px;align-items:start;gap:18px;padding:33px 0;border-bottom:1px solid var(--line)}.oid-modules>a>span{font-size:11px;color:var(--brand);padding-top:5px}.oid-modules .eyebrow{font-size:11px}.oid-modules h3{font-size:27px;line-height:1.25;margin:14px 0}.oid-modules p:last-child{font-size:15px;line-height:1.8}.oid-modules :global(.arrow){color:var(--brand);width:20px;margin-top:6px}.oid-modules>a:hover h3{color:var(--brand)}.oid-app-screen{margin:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--surface)}.oid-screen-top{display:flex;justify-content:space-between;gap:15px;padding:17px 22px;border-bottom:1px solid var(--line);font-size:11px;color:var(--muted)}.oid-screen-top a{color:var(--brand)}.oid-app-screen :global(img){width:100%;height:auto}.oid-app-screen :global(.oid-screen-dark){display:none}:global(.dark) .oid-app-screen :global(.oid-screen-light){display:none}:global(.dark) .oid-app-screen :global(.oid-screen-dark){display:block}.oid-app-screen figcaption{font-size:12px;color:var(--muted);line-height:1.8;padding:18px 22px}.oid-training-reasons{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:30px;border-top:1px solid var(--line);padding-top:42px}.oid-training-reasons h3{font-size:25px;margin:22px 0 16px;line-height:1.3}.oid-training-reasons p{font-size:15px;line-height:1.9}.oid-training-close{display:flex;align-items:end;justify-content:space-between;gap:55px;padding-top:60px;padding-bottom:90px;margin-top:50px;border-top:1px solid var(--line)}.oid-training-close h2{font-size:clamp(32px,3.2vw,45px);margin:18px 0 25px}.oid-training-close>.button{max-width:390px}:global(.dark) .oid-training-object{--oid-orange:#ffb47b}@media(max-width:1000px){.oid-training-hero{grid-template-columns:1.4fr .65fr;gap:35px}.oid-training-object{padding:26px}.oid-training-heading{gap:35px}.oid-modules{gap:0 28px}.oid-training-reasons{gap:25px}}@media(max-width:720px){.oid-training-hero{grid-template-columns:1fr;gap:30px}.oid-training-object{display:none}.oid-training-hero h1{font-size:clamp(44px,11vw,63px)}.oid-training-hero .lead{font-size:18px}.oid-training-intro{padding-bottom:40px}.oid-training-heading{grid-template-columns:1fr;gap:22px}.oid-training-heading h2{font-size:35px}.oid-training-heading>p,.oid-training-heading>div>p:not(.eyebrow){font-size:16px}.oid-training-section{padding-top:48px}.oid-modules{grid-template-columns:1fr}.oid-modules>a{padding:27px 0;gap:14px}.oid-modules h3{font-size:26px}.oid-screen-top{padding:15px;font-size:10px}.oid-app-screen figcaption{font-size:11px;padding:15px}.oid-training-reasons{grid-template-columns:1fr;gap:28px;margin-top:20px;padding-top:35px}.oid-training-reasons>div{border-bottom:1px solid var(--line);padding-bottom:26px}.oid-training-close{flex-direction:column;align-items:start;gap:25px;padding-top:38px;padding-bottom:60px;margin-top:25px}.oid-training-close h2{font-size:34px}}
</style>
