---
// Decorative cryptographic references match the WebCrypto example on the homepage.
const { variant = 'header' } = Astro.props as { variant?: 'header' | 'footer' };
---
<div class:list={['band-texture', {'band-texture-footer':variant==='footer'}]} aria-hidden="true" data-pagefind-ignore>
  <span class="band-texture-grain"></span>
  <span class="band-texture-code">ECDH · P-256 / deriveKey · deriveBits</span>
  {variant === 'header' && <span class="band-texture-glint"></span>}
</div>
<style>
  .band-texture{position:absolute;inset:0;pointer-events:none;overflow:hidden;mask-image:linear-gradient(90deg,transparent 20%,#000 55%);border-radius:inherit}
  .band-texture-grain{position:absolute;inset:0;background-image:radial-gradient(circle,#d7e3ed20 .7px,transparent 1px),linear-gradient(115deg,transparent 40%,#0069b418 75%,transparent);background-size:18px 18px,100% 100%}
  .band-texture-code{position:absolute;right:5.5%;bottom:7px;font-family:var(--font-mono);font-size:9px;line-height:1.4;letter-spacing:.11em;color:#9ac4e7;opacity:.2;white-space:nowrap}
  .band-texture-glint{position:absolute;top:-45%;bottom:-45%;width:180px;left:48%;background:linear-gradient(90deg,transparent,#75baf01a,transparent);transform:skewX(-24deg);opacity:0;animation:band-glint 4.4s ease-in-out 1}
  .band-texture-footer .band-texture-grain{background-size:26px 26px,100% 100%;background-image:radial-gradient(circle,#d7e3ed18 .7px,transparent 1px),radial-gradient(ellipse at 90% 0%,#0069b414,transparent 70%)}
  .band-texture-footer .band-texture-code{top:22px;bottom:auto;opacity:.18}
  @keyframes band-glint{0%{transform:translateX(-180px) skewX(-24deg);opacity:0}25%{opacity:.5}65%{opacity:.5}100%{transform:translateX(520px) skewX(-24deg);opacity:0}}
  @media(max-width:720px){.band-texture{mask-image:linear-gradient(90deg,transparent 35%,#000 90%)}.band-texture-code{display:none}.band-texture-glint{width:110px}}
  @media(prefers-reduced-motion:reduce){.band-texture-glint{animation:none;display:none}}
</style>
