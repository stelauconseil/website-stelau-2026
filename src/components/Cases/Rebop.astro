---
import {Code} from 'astro:components';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import Decoder from '@/components/Decoder/Decoder';
import RebopScreen from './RebopScreen.astro';
import dashboard from '@/assets/images/rebop/tableau-de-bord.png';
import analysis from '@/assets/images/rebop/analyse-x509.png';
import renewal from '@/assets/images/rebop/comparaison-renouvellement.png';
import timeline from '@/assets/images/rebop/timeline-certificats.png';
import {rebopContent} from '@/data/rebop';
import {href,type Locale} from '@/config/site';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';const c=rebopContent[lang];
const stages=fr?['Découvrir','Lire','Surveiller','Corréler','Agir']:['Discover','Read','Monitor','Correlate','Act'];
const navigation=fr?[['decouverte','Découverte'],['analyse','X.509 & PKI'],['renouvellements','Renouvellements'],['pilotage','Pilotage'],['deploiement','Déploiement'],['decodeur','Décodeur local']]:[['decouverte','Discovery'],['analyse','X.509 & PKI'],['renouvellements','Renewals'],['pilotage','Operations'],['deploiement','Deployment'],['decodeur','Local decoder']];
const asn1=`Certificate ::= SEQUENCE {
  tbsCertificate     TBSCertificate,
  signatureAlgorithm AlgorithmIdentifier,
  signatureValue     BIT STRING
}

-- SubjectPublicKeyInfo, Validity,
-- Extensions: SAN, KU, EKU, AIA, CRL…`;
---
<header class="container page-intro rebop-hero">
 <div><a class="back-link" href={href(lang,'cases')}>← {fr?'Toutes les réalisations':'All projects'}</a><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="file-signature" size={24}/></span>STELAU / CERTIFICATE LIFECYCLE MANAGEMENT</p><h1>reBop<span>{fr?'Le certificat.':'The certificate.'}<br/><em>{fr?'Toute sa vie.':'Its entire lifecycle.'}</em></span></h1><p class="lead">{c.lead}</p><div class="rebop-hero-actions"><a class="button" href="#decodeur">{fr?'Explorer un certificat':'Explore a certificate'}<Arrow/></a><a class="text-link" href="https://www.rebop.io/" target="_blank" rel="noopener noreferrer">{fr?'Découvrir reBop':'Discover reBop'}<Arrow/></a></div></div>
 <aside class="rebop-system" aria-label={fr?'Le cycle de lecture reBop':'The reBop observation lifecycle'}><div class="rebop-system-head"><span class="mono">reBop / CLM</span><span>{fr?'Certificats + contexte':'Certificates + context'}</span></div><div class="rebop-sources"><span><Icon name="globe" size={25}/>{fr?'Services exposés':'Exposed services'}</span><span><Icon name="satellite-dish" size={25}/>{fr?'Sonde interne':'Internal probe'}</span></div><div class="rebop-certificate"><Icon name="file-signature" size={46}/><div><strong>X.509</strong><p>ASN.1 · DER · PEM</p></div><span class="mono">subject<br/>issuer<br/>validity<br/>extensions</span></div><div class="rebop-signals"><div><Icon name="location-dot" size={22}/><b>{fr?'Où ?':'Where?'}</b><span>host · IP · port · path</span></div><div><Icon name="fingerprint" size={22}/><b>{fr?'Lequel ?':'Which?'}</b><span>issuer · serial · key</span></div><div><Icon name="calendar-days" size={22}/><b>{fr?'Quand ?':'When?'}</b><span>notBefore · notAfter</span></div></div><div class="rebop-system-foot"><Icon name="eye" size={23}/><span>{fr?'Observer le déploiement. Comprendre le renouvellement.':'Observe deployment. Understand renewal.'}</span></div></aside>
</header>
<nav class="container rebop-nav" aria-label={fr?'Sur cette page':'On this page'}>{navigation.map(([id,title])=><a href={'#'+id}>{title}<Arrow/></a>)}</nav>
<section class="container rebop-section rebop-position"><p class="eyebrow">01 / {fr?'Un produit Stelau':'A Stelau product'}</p><div class="rebop-split"><h2>{c.position}</h2><div><p>{c.positionText}</p><div class="rebop-flow" aria-label={fr?'Étapes du cycle de vie':'Lifecycle stages'}>{stages.map((s,i)=><span><small class="mono">0{i+1}</small>{s}{i<stages.length-1&&<Arrow/>}</span>)}</div></div></div><RebopScreen lang={lang} image={dashboard} dark title={fr?'Tableau de bord':'Dashboard'} caption={fr?'Échéances, répartition et personnalisation des indicateurs : le patrimoine de certificats devient visible.':'Deadlines, distribution and customisable indicators bring the certificate estate into view.'} alt={fr?'Tableau de bord reBop, indicateurs d’expiration, graphique annuel et réglages d’apparence des widgets.':'reBop dashboard with expiry indicators, annual chart and widget appearance settings.'}/></section>
<section id="decouverte" class="container rebop-section"><div class="rebop-section-heading"><div><p class="eyebrow icon-eyebrow"><Icon name="satellite-dish" size={24}/>02 / {fr?'Découverte & collecte':'Discovery & collection'}</p><h2>{fr?'L’inventaire commence':'Inventory starts'}<br/><em>{fr?'là où vivent les certificats.':'where certificates live.'}</em></h2></div><p>{fr?'Internet, réseau interne, fichiers locaux : un inventaire utile réunit le certificat et les endroits où il est observé. Un nom de fichier ou une date d’expiration ne suffit pas.':'Internet, internal networks and local files: a useful inventory connects certificates with the places where they are observed. A filename or an expiry date is not enough.'}</p></div><div class="rebop-cards">{c.discovery.map(card=><article><Icon name={card.icon} size={32}/><h3>{card.title}</h3><p>{card.text}</p><details><summary>{fr?'Sous le capot':'Technical detail'}<span aria-hidden="true">+</span></summary><p>{card.detail}</p></details></article>)}</div><p class="rebop-source"><a href="https://www.rebop.io/real-time-certificate-monitoring/" target="_blank" rel="noopener noreferrer">{fr?'Découverte et surveillance reBop':'reBop discovery and monitoring'} ↗</a><a href="https://docs.rebop.io/docs/guides/probe/what-is-probe/" target="_blank" rel="noopener noreferrer">{fr?'Fonctionnement de la sonde':'How the probe works'} ↗</a></p></section>
<section id="analyse" class="container rebop-section"><div class="rebop-section-heading"><div><p class="eyebrow icon-eyebrow"><Icon name="microscope" size={24}/>03 / {fr?'Cryptographie appliquée':'Applied cryptography'}</p><h2>{fr?'Lire le certificat.':'Read the certificate.'}<br/><em>{fr?'Comprendre ce qu’il dit.':'Understand what it says.'}</em></h2></div><p>{fr?'Les dates ne sont qu’une partie du sujet. Un certificat X.509 transporte une identité, une clé publique, des usages et des contraintes. Ce sont ces données qu’un CLM doit rendre lisibles.':'Dates are only part of the story. An X.509 certificate carries an identity, a public key, usages and constraints. A CLM must make that information understandable.'}</p></div><div class="rebop-analysis"><div class="rebop-code"><div class="mono">X.509 / RFC 5280</div><Code code={asn1} lang="plaintext" themes={{light:'github-light',dark:'github-dark'}} defaultColor="light"/><a href="https://www.rfc-editor.org/rfc/rfc5280.html#section-4.1" target="_blank" rel="noopener noreferrer">{fr?'Structure d’un certificat':'Certificate structure'} ↗</a></div><div class="rebop-analysis-copy">{c.analysis.map(card=><article><Icon name={card.icon} size={27}/><div><h3>{card.title}</h3><p>{card.text}</p><p class="rebop-detail">{card.detail}</p></div></article>)}</div></div><RebopScreen lang={lang} image={analysis} title={fr?'Analyse X.509':'X.509 analysis'} caption={fr?'Usages de clés, identifiants et informations de l’autorité : explorer les données au-delà des dates.':'Key usages, identifiers and authority information: explore the data beyond dates.'} alt={fr?'Vue détaillée reBop d’un certificat, avec les usages de clés, AKI, SKI et les informations de son autorité.':'Detailed reBop certificate view with key usages, AKI, SKI and issuing authority information.'}/><p class="rebop-source"><a href="https://docs.rebop.io/docs/guides/app/certificates/" target="_blank" rel="noopener noreferrer">{fr?'La vue Certificats dans reBop':'The reBop certificate view'} ↗</a></p></section>
<section id="renouvellements" class="container rebop-section"><div class="rebop-section-heading"><div><p class="eyebrow icon-eyebrow"><Icon name="puzzle-piece" size={24}/>04 / {fr?'Détection des renouvellements':'Renewal detection'}</p><h2>{fr?'Un nouveau certificat.':'A new certificate.'}<br/><em>{fr?'Le bon remplacement ?':'The right replacement?'}</em></h2></div><p>{fr?'Le renouvellement est une relation entre un ancien certificat, un nouveau certificat et leurs emplacements. reBop met cette relation au centre du suivi.':'A renewal links a previous certificate, a new certificate and their locations. reBop places that relationship at the centre of monitoring.'}</p></div><ol class="rebop-renewal">{c.renewal.map((text,i)=><li><span class="mono">0{i+1}</span><p>{text}</p></li>)}</ol><RebopScreen lang={lang} image={renewal} dark title={fr?'Comparer avant de décider':'Compare before deciding'} caption={fr?'Une proposition de renouvellement met les deux certificats face à face, avant acceptation ou rejet.':'A renewal proposal places both certificates side by side before acceptance or rejection.'} alt={fr?'Proposition de renouvellement reBop : comparaison de l’ancien et du nouveau certificat, de leurs identités, emplacements et périodes de validité.':'reBop renewal proposal comparing previous and new certificates, identities, locations and validity periods.'}/><div class="rebop-deploy-delay"><div><span class="mono">Deploy Delay</span><strong>{fr?'Début de validité → déploiement observé':'Start of validity → observed deployment'}</strong></div><p>{fr?'Disposer d’un certificat renouvelé et l’avoir réellement mis en service sont deux étapes différentes. Ce délai aide à mettre en évidence les écarts entre la disponibilité du certificat et son déploiement. La détection d’un renouvellement ne constitue pas une émission ou un déploiement automatique par reBop.':'Obtaining a renewed certificate and actually putting it into service are different steps. This delay highlights the gap between certificate availability and deployment. Detecting a renewal does not mean reBop automatically issues or deploys that certificate.'}</p></div><p class="rebop-source"><a href="https://docs.rebop.io/docs/guides/app/ai-engine/" target="_blank" rel="noopener noreferrer">AI Engine ↗</a><a href="https://www.rebop.io/advanced-features/" target="_blank" rel="noopener noreferrer">{fr?'Renouvellements et Deploy Delay':'Renewals and Deploy Delay'} ↗</a></p></section>
<section id="pilotage" class="container rebop-section"><div class="rebop-section-heading"><div><p class="eyebrow icon-eyebrow"><Icon name="sliders" size={24}/>05 / {fr?'Exploitation & pilotage':'Operations & oversight'}</p><h2>{fr?'La bonne information.':'The right information.'}<br/><em>{fr?'Pour la bonne action.':'For the right action.'}</em></h2></div><p>{fr?'Réduire les angles morts, organiser les échéances et partager les décisions : la lecture technique doit déboucher sur une exploitation maîtrisée.':'Reduce blind spots, organise deadlines and share decisions: technical understanding should lead to controlled operations.'}</p></div><RebopScreen lang={lang} image={timeline} title={fr?'La timeline des échéances':'The expiry timeline'} caption={fr?'Anticiper les expirations et suivre les renouvellements depuis une même vue chronologique.':'Anticipate expirations and track renewals in a single chronological view.'} alt={fr?'Timeline reBop affichant les certificats arrivant à échéance par jour et les statistiques de renouvellement.':'reBop timeline showing certificates approaching expiry by day and renewal statistics.'}/><div class="rebop-cards rebop-operations">{c.operations.map(card=><article><Icon name={card.icon} size={32}/><h3>{card.title}</h3><p>{card.text}</p><details><summary>{fr?'En pratique':'In practice'}<span aria-hidden="true">+</span></summary><p>{card.detail}</p></details></article>)}</div><p class="rebop-source"><a href="https://docs.rebop.io/docs/guides/app/timeline/" target="_blank" rel="noopener noreferrer">Timeline ↗</a><a href="https://docs.rebop.io/docs/guides/app/settings/" target="_blank" rel="noopener noreferrer">{fr?'Profils et journaux':'Profiles and logs'} ↗</a></p></section>
<section id="deploiement" class="container rebop-section"><p class="eyebrow icon-eyebrow"><Icon name="server" size={24}/>06 / {fr?'Architecture de déploiement':'Deployment architecture'}</p><div class="rebop-split"><h2>{fr?'Le CLM, dans':'Your CLM, in'}<br/><em>{fr?'votre contexte.':'your environment.'}</em></h2><div class="rebop-deployment">{c.deployment.map(card=><article><Icon name={card.icon} size={29}/><div><h3>{card.title}</h3><p>{card.text}</p><p class="rebop-detail">{card.detail}</p></div></article>)}</div></div><p class="rebop-source"><a href="https://www.rebop.io/" target="_blank" rel="noopener noreferrer">{fr?'Offres et modalités de déploiement':'Plans and deployment options'} ↗</a></p></section>
<section id="decodeur" class="container rebop-section rebop-lab"><div class="rebop-section-heading"><div><p class="eyebrow icon-eyebrow"><Icon name="flask-vial" size={24}/>07 / {fr?'À vous de lire':'Your turn to explore'}</p><h2>{fr?'Votre certificat.':'Your certificate.'}<br/><em>{fr?'Vos octets. Votre navigateur.':'Your bytes. Your browser.'}</em></h2></div><p>{fr?'Cet atelier Stelau reprend notre application React fondée sur le décodeur ASN.1 de Lapo Luchini. Importez un certificat ou essayez l’exemple fictif : les champs X.509, l’arbre ASN.1 et les octets restent synchronisés à chaque sélection.':'This Stelau workshop adapts our React application built on Lapo Luchini’s ASN.1 decoder. Import a certificate or try the fictional example: X.509 fields, the ASN.1 tree and bytes stay synchronised with each selection.'}</p></div><Decoder lang={lang} client:visible={{rootMargin:'250px'}}/><noscript><p class="rebop-noscript">{fr?'Activez JavaScript pour utiliser le décodeur local. Le reste de la page reste accessible.':'Enable JavaScript to use the local decoder. The rest of this page remains accessible.'}</p></noscript><p class="rebop-sample-note">{fr?'L’exemple est un certificat auto-signé de démonstration pour des noms fictifs. Les QCStatements servent à explorer l’encodage ; ils ne lui confèrent aucune qualification. L’atelier fonctionne indépendamment du service reBop.':'The example is a self-signed demonstration certificate for fictional names. Its QCStatements demonstrate the encoding and do not confer any qualification. This workshop runs independently of the reBop service.'}</p></section>
<section class="container rebop-section rebop-close"><details class="rebop-references"><summary><Icon name="book-open" size={23}/>{fr?'Documentation et références techniques':'Documentation and technical references'}<span aria-hidden="true">+</span></summary><div>{c.references.map(ref=><a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.label}<Arrow/></a>)}</div></details><div class="rebop-cta"><h2>{fr?'Parlons de votre':'Let’s discuss your'}<br/><em>{fr?'patrimoine de certificats.':'certificate estate.'}</em></h2><a class="button" href={href(lang,'contact')}>{fr?'Échanger avec les experts Stelau':'Talk to Stelau’s experts'}<Arrow/></a></div></section>
<style>
 .rebop-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:65px;align-items:center;padding-top:48px;padding-bottom:45px}.rebop-hero .eyebrow{margin-top:30px;font-size:11px}.rebop-hero h1{font-size:clamp(70px,7vw,100px);margin:22px 0 25px}.rebop-hero h1>span{display:block;font-size:clamp(42px,4.7vw,66px);margin-top:20px;line-height:1.1}.rebop-hero .lead{font-size:18px;line-height:1.9}.rebop-hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:24px;margin-top:30px}.rebop-hero-actions .button{gap:16px}.rebop-hero-actions .text-link{gap:12px}.rebop-system{border:1px solid var(--line);border-radius:18px;padding:26px;background:radial-gradient(circle at 1px 1px,var(--line) 1px,transparent 0) 0 0/18px 18px,var(--soft)}.rebop-system-head{display:flex;align-items:center;justify-content:space-between;gap:15px;font-size:11px}.rebop-system-head>.mono{font-size:20px;color:var(--brand)}.rebop-system-head>span:last-child{color:var(--muted)}.rebop-sources{display:flex;gap:12px;margin-top:28px}.rebop-sources>span{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--surface);font-size:12px;flex:1}.rebop-certificate{display:flex;align-items:center;gap:20px;padding:30px 23px;margin:28px 0;border:1px solid var(--brand);border-radius:13px;background:var(--surface)}.rebop-certificate strong{font-size:36px;font-weight:500;letter-spacing:-.03em}.rebop-certificate p{font-size:12px;margin-top:5px}.rebop-certificate>.mono{margin-left:auto;font-size:11px;line-height:1.7;color:var(--muted)}.rebop-signals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.rebop-signals>div{display:flex;flex-direction:column;gap:8px;padding:14px 10px;border:1px solid var(--line);border-radius:9px;background:var(--surface);min-width:0}.rebop-signals b{font-size:15px;font-weight:500}.rebop-signals span{font-size:10px;font-family:var(--font-mono);color:var(--muted);overflow-wrap:anywhere}.rebop-system-foot{display:flex;align-items:center;gap:12px;margin-top:24px;font-size:13px;line-height:1.7;color:var(--muted)}.rebop-nav{display:flex;flex-wrap:wrap;gap:10px;padding-bottom:30px}.rebop-nav a{display:flex;align-items:center;gap:9px;padding:9px 12px;border:1px solid var(--line);border-radius:7px;font-size:12px;background:var(--surface)}.rebop-nav a:hover{border-color:var(--brand)}.rebop-nav :global(.arrow){width:13px;height:13px;color:var(--brand)}.rebop-section{padding-top:55px;padding-bottom:55px;scroll-margin-top:25px}.rebop-section::before{content:'';display:block;height:1px;background:var(--line);margin-bottom:45px}.rebop-section-heading{display:grid;grid-template-columns:1.15fr 1fr;gap:70px;align-items:end;margin-bottom:32px}.rebop-section-heading h2,.rebop-split h2,.rebop-cta h2{font-size:clamp(34px,3.5vw,48px);line-height:1.15}.rebop-section-heading>p,.rebop-split p{font-size:17px;line-height:1.9}.rebop-split{display:grid;grid-template-columns:1fr 1.25fr;gap:70px}.rebop-flow{display:flex;flex-wrap:wrap;gap:16px;margin-top:24px}.rebop-flow>span{display:flex;align-items:center;gap:7px;font-size:13px}.rebop-flow small{font-size:11px;color:var(--brand)}.rebop-flow :global(.arrow){width:13px;height:13px;color:var(--muted)}.rebop-operations{margin-top:32px}.rebop-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.rebop-cards>article{padding:27px;border:1px solid var(--line);border-radius:12px;background:var(--surface);min-width:0}.rebop-cards h3{font-size:24px;line-height:1.25;margin:20px 0 15px}.rebop-cards p{font-size:15px;line-height:1.85}.rebop-cards details{margin-top:23px;border-top:1px solid var(--line);padding-top:15px}.rebop-cards summary{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px;cursor:pointer}.rebop-cards details p{margin-top:14px;font-size:14px}.rebop-cards summary::-webkit-details-marker,.rebop-references summary::-webkit-details-marker{display:none}.rebop-source{display:flex;flex-wrap:wrap;gap:12px 25px;font-size:12px;margin-top:22px}.rebop-source a{border-bottom:1px solid var(--line)}.rebop-source a:hover{color:var(--brand)}.rebop-analysis{display:grid;grid-template-columns:.95fr 1.25fr;gap:50px;align-items:start}.rebop-code{border:1px solid var(--line);border-radius:12px;overflow:hidden;min-width:0;background:var(--surface)}.rebop-code>.mono{padding:17px 22px;border-bottom:1px solid var(--line);font-size:12px;color:var(--muted)}.rebop-code :global(pre){padding:25px 22px;font-size:13px;line-height:1.8;overflow:auto;margin:0;background:var(--surface)!important}.rebop-code>a{display:block;padding:14px 22px;border-top:1px solid var(--line);font-size:12px;color:var(--brand)}:global(.dark) .rebop-code :global(pre),:global(.dark) .rebop-code :global(pre span){color:var(--shiki-dark)!important;background-color:var(--surface)!important}.rebop-analysis-copy>article,.rebop-deployment>article{display:flex;gap:17px}.rebop-analysis-copy>article+article,.rebop-deployment>article+article{margin-top:30px;padding-top:30px;border-top:1px solid var(--line)}.rebop-analysis-copy h3,.rebop-deployment h3{font-size:24px;margin-bottom:12px;line-height:1.25}.rebop-analysis-copy p,.rebop-deployment p{font-size:16px;line-height:1.85}.rebop-detail{font-size:14px!important;margin-top:11px}.rebop-renewal{padding:0;margin:0;list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.rebop-renewal li{display:flex;gap:20px;padding:24px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.rebop-renewal .mono{color:var(--brand);font-size:17px}.rebop-renewal p{font-size:16px;line-height:1.85}.rebop-deploy-delay{padding:28px;background:var(--soft);border:1px solid var(--line);border-radius:12px;margin-top:24px;display:grid;grid-template-columns:.8fr 1.5fr;gap:35px}.rebop-deploy-delay .mono{display:block;color:var(--brand);font-size:13px;margin-bottom:14px}.rebop-deploy-delay strong{display:block;font-size:23px;font-weight:500;line-height:1.45}.rebop-deploy-delay p{font-size:15px;line-height:1.85}.rebop-sample-note,.rebop-noscript{font-size:13px;line-height:1.85;margin-top:18px}.rebop-references{border:1px solid var(--line);border-radius:10px;padding:22px 26px;background:var(--surface)}.rebop-references summary{display:flex;align-items:center;gap:12px;font-size:15px;cursor:pointer}.rebop-references summary>span:last-child{margin-left:auto}.rebop-references>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 30px;padding-top:25px}.rebop-references a{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:14px}.rebop-references :global(.arrow){width:15px;height:15px;color:var(--brand);flex-shrink:0}.rebop-cta{display:flex;align-items:center;justify-content:space-between;gap:35px;padding-top:55px}.rebop-close{padding-bottom:85px}
 @media(max-width:1050px){.rebop-hero{gap:35px}.rebop-cards{grid-template-columns:1fr}.rebop-analysis{grid-template-columns:1fr}.rebop-code{max-width:650px}.rebop-section-heading,.rebop-split{gap:35px}.rebop-certificate>.mono{display:none}}
 @media(max-width:720px){.rebop-hero{grid-template-columns:1fr;gap:30px}.rebop-hero h1{font-size:72px}.rebop-hero h1>span{font-size:42px}.rebop-system{padding:20px}.rebop-system-head{flex-wrap:wrap}.rebop-signals{gap:7px}.rebop-sources{flex-wrap:wrap}.rebop-sources>span{flex:1 1 140px}.rebop-certificate{padding:22px 18px}.rebop-signals b{font-size:14px}.rebop-nav{gap:8px}.rebop-section{padding-top:30px;padding-bottom:30px}.rebop-section::before{margin-bottom:28px}.rebop-section-heading,.rebop-split{grid-template-columns:1fr;gap:23px}.rebop-renewal{grid-template-columns:1fr}.rebop-deploy-delay{grid-template-columns:1fr;gap:20px;padding:24px}.rebop-cards>article{padding:25px}.rebop-cards h3{font-size:24px}.rebop-code :global(pre){font-size:11px;padding:22px 15px}.rebop-cta{align-items:flex-start;flex-direction:column;gap:25px}.rebop-references{padding:20px}.rebop-references>div{grid-template-columns:1fr}.rebop-references summary{font-size:13px}.rebop-analysis-copy p,.rebop-deployment p{font-size:16px}.rebop-close{padding-bottom:60px}}
</style>
