---
import Icon from '@/components/Icon/Icon.astro';
import {caseIcons} from '@/data/icons';
import {getCollection,render} from 'astro:content';import {href,type Locale} from '@/config/site';import {caseStudies} from '@/data/cases';import Arrow from '@/components/Arrow.astro';
const {lang,slug}=Astro.props as {lang:Locale;slug:string};const fr=lang==='fr';const study=caseStudies.find(c=>c.slug===slug)!;const entry=(await getCollection('cases')).find(c=>c.id===`${lang}/${slug}`)!;const {Content}=await render(entry);
---
<div class="container page-intro"><a class="back-link" href={href(lang,'cases')}>← {fr?'Toutes les réalisations':'All projects'}</a><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name={caseIcons[slug]} size={22}/></span>{study.client} / {study.year==='Depuis 2016'&&!fr?'Since 2016':study.year}</p><h1>{study[lang].title}</h1><p class="lead">{study[lang].description}</p></div><section class="container case-detail"><aside class="article-aside"><p class="eyebrow icon-eyebrow"><Icon name="briefcase" size={20}/>{fr?'Le projet':'The project'}</p><dl><dt>Client</dt><dd>{study.client}</dd><dt>{fr?'Période':'Period'}</dt><dd>{study.year==='Depuis 2016'&&!fr?'Since 2016':study.year}</dd></dl><a class="text-link" href={href(lang,'contact')}>{fr?'Un projet similaire ?':'A similar project?'}<Arrow /></a></aside><div class="prose"><Content/></div></section>
