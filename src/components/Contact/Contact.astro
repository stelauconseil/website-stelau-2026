---
import Icon from '@/components/Icon/Icon.astro';
import {companyContact,locationMapUrl} from '@/data/company';import {href,type Locale} from '@/config/site';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
---
<div class="container page-intro"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="comments" size={22}/></span>Contact / {fr?'Le début d’une conversation':'The start of a conversation'}</p><h1>{fr?'Parlons de':'Let’s talk about'}<br/><em>{fr?'ce qui vous occupe.':'what’s on your mind.'}</em></h1><p class="lead">{fr?'Un projet à construire, une situation à analyser, une certification à préparer ? Échangez avec nos experts en cybersécurité.':'A project to build, a situation to analyse, a certification to prepare? Talk to our cybersecurity experts.'}</p></div><section class="container contact-grid"><div class="contact-details"><p class="eyebrow">{fr?'Un contact direct':'Get in touch directly'}</p><a class="contact-email icon-text" href="mailto:contact@stelau.com"><Icon name="envelope" size={24}/>contact@stelau.com</a><a class="icon-text" href={'tel:'+companyContact.phone}><Icon name="phone" size={20}/>{companyContact.phoneLabel}</a><div class="locations-card"><h2 class="eyebrow">{fr?'Nos implantations':'Our locations'} / {companyContact.country}</h2><ul class="contact-locations">{companyContact.locations.map(city=><li><a class="icon-text" href={locationMapUrl(city)} target="_blank" rel="noopener noreferrer"><Icon name="location-dot" size={20}/><span>{city}</span><span class="location-arrow" aria-hidden="true">↗</span></a></li>)}</ul></div><p>{fr?'Nous pouvons commencer par un échange, puis travailler avec vos équipes, sur place ou à distance.':'We can start with a conversation, then work with your teams, on site or remotely.'}</p></div><form class="contact-form" action="https://formspree.io/f/mpwzwkkd" method="POST"><input type="hidden" name="_subject" value="Contact site Stelau"/><div class="form-row"><label>{fr?'Prénom':'First name'}<input name="firstname" autocomplete="given-name" required/></label><label>{fr?'Nom':'Last name'}<input name="lastname" autocomplete="family-name" required/></label></div><label>{fr?'Votre email professionnel':'Your work email'}<input type="email" name="email" autocomplete="email" required/></label><label>{fr?'Votre organisation':'Your organisation'} <span>({fr?'facultatif':'optional'})</span><input name="company" autocomplete="organization"/></label><label>{fr?'Ce dont vous aimeriez parler':'What you’d like to discuss'}<textarea name="message" rows="5" required></textarea></label><label class="honeypot" aria-hidden="true">Leave this empty<input name="_gotcha" tabindex="-1" autocomplete="off"/></label><p class="form-privacy">{fr?'Ces informations nous permettent de répondre à votre demande.':'We use this information to respond to your enquiry.'} <a href={href(lang,'privacy')}>{fr?'Confidentialité':'Privacy policy'}</a>.</p><button class="button" type="submit">{fr?'Envoyer mon message':'Send my message'}<Icon name="paper-plane" size={20}/></button></form></section>
