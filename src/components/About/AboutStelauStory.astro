---
import Icon from '@/components/Icon/Icon.astro';
import {Image} from 'astro:assets';
import Arrow from '@/components/Arrow.astro';
import {cyberInsuranceHref,type Locale} from '@/config/site';
import {team} from '@/data/team';
import StelauHistory from './StelauHistory.astro';
import office from '@/assets/images/office-verdure.png';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
---
<section class="container page-intro"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="users" size={22}/></span>{fr?'À propos / L’équipe Stelau':'About / The Stelau team'}</p><h1>{fr?'Des expertises pointues.':'Deep expertise.'}<br/><em>{fr?'Des personnes accessibles.':'Approachable people.'}</em></h1><p class="lead">{fr?'Depuis 2002, Stelau réunit des ingénieurs consultants et des experts en cybersécurité pour accompagner les organisations qui construisent la confiance numérique. Notre expertise se nourrit du terrain, de l’expérimentation et du partage des connaissances.':'Since 2002, Stelau has brought together consulting engineers and cybersecurity experts to support organisations building digital trust. Our expertise grows through practical experience, experimentation and sharing knowledge.'}</p></section>
<section class="container about-story"><Image src={office} alt={fr?'Trois membres souriants de l’équipe Stelau à leurs postes de travail, dans un bureau lumineux agrémenté de plantes.':'Three smiling Stelau team members at their workstations in a bright office with plants.'} width={1400} widths={[600,1000,1400]} sizes="(max-width: 720px) 100vw, (max-width: 1360px) 90vw, 1250px" format="webp"/><div class="story-caption"><span class="mono">STELAU / {fr?'AU QUOTIDIEN':'EVERY DAY'}</span><p>{fr?'Une plateforme de confiance commence par une équipe en qui avoir confiance.':'A trusted platform starts with a team you can trust.'}</p></div></section>
<section class="container section-space"><div class="section-heading"><div><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="seedling" size={22}/></span>{fr?'Notre approche':'Our approach'}</p><h2>{fr?'L’expertise de terrain,':'Hands-on expertise,'}<br/><em>{fr?'comme point de départ.':'as a starting point.'}</em></h2></div><p>{fr?'Derrière FullVerify et nos missions de conseil, d’audit et de développement, il y a le même collectif d’ingénieurs. Une équipe qui relie les standards à vos usages.':'FullVerify brings our expertise to digital verification. The same team applies that knowledge across Stelau’s consulting, audit and development work.'}</p></div><div class="approach-grid"><div><span class="approach-marker mono"><Icon name="layer-group" size={28}/>01</span><h3>{fr?'Des standards aux usages':'From standards to real use'}</h3><p>{fr?'eIDAS, OID4VP, ISO 18013-5, EUDI Wallet : nous étudions les standards et les mettons à l’épreuve dans des implémentations concrètes.':'We study eIDAS, OID4VP, ISO 18013-5 and EUDI Wallet standards, then put them to the test through real implementations.'}</p></div><div><span class="approach-marker mono"><Icon name="pen-nib" size={28}/>02</span><h3>{fr?'Une analyse qui se partage':'Analysis you can share'}</h3><p>{fr?'Nous rendons les sujets techniques compréhensibles. Rapports, notes, ateliers et documentation permettent aux équipes de décider et de progresser.':'We make technical subjects understandable. Reports, papers, workshops and documentation help teams make decisions and move forward.'}</p><a class="text-link insurance-about-link" href={cyberInsuranceHref(lang)}>{fr?'Notre expertise pour l’assurance':'Our expertise for insurance'}<Arrow /></a></div><div><span class="approach-marker mono"><Icon name="shish-kebab" size={28}/>03</span><h3>{fr?'La technique et le collectif':'Technology and teamwork'}</h3><p>{fr?'Nous travaillons au contact de vos équipes. L’IA nous aide à explorer et à rédiger, avec des sources vérifiées et une relecture par nos ingénieurs.':'We work alongside your teams. AI helps us explore and write, supported by verified sources and reviews by our engineers.'}</p></div></div></section>
<section class="container section-space"><div class="section-heading"><div><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="users" size={22}/></span>{fr?'Les visages derrière les projets':'The people behind the projects'}</p><h2>{fr?'Faisons':'Let’s'}<br/><em>{fr?'connaissance.':'meet.'}</em></h2></div><p>{fr?'Des ingénieurs consultants et des experts en cybersécurité, des parcours différents et une même envie de faire du travail solide.':'Consulting engineers and cybersecurity experts with different backgrounds and a shared commitment to sound work.'}</p></div><div class="team-grid">{team.map((m,i)=>{const Card=m.url?'a':'article';return <Card class="team-card" href={m.url} target={m.url?'_blank':undefined} rel={m.url?'noopener noreferrer':undefined}>
  <div class="team-card-top"><span class="team-card-label mono"><span class="team-card-brand">STELAU </span>/ {String(i+1).padStart(2,'0')}</span>{m.url&&<Arrow />}</div>
  <div class="team-photo"><Image src={m.image} alt={m.name} width={400} format="webp"/></div>
  <div class="team-card-info"><h3>{m.name}</h3><p>{m[lang]}</p></div>
  {m.url&&<span class="team-card-link">{fr?'Profil LinkedIn':'LinkedIn profile'}<Arrow /></span>}
</Card>})}</div></section>
<StelauHistory lang={lang}/>
<style>
 @media(max-width:720px){.about-story :global(img){height:auto;aspect-ratio:4/3;object-position:center}}
</style>
