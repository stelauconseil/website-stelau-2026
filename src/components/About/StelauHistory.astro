---
import {Image} from 'astro:assets';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import founders from '@/assets/images/stelau-terrain/fondateurs-stelau.jpeg';
import {historyFor} from '@/data/history';
import {group} from '@/data/company';
import type {Locale} from '@/config/site';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
---
<section id="histoire" class="container section-space stelau-history" aria-labelledby="history-title">
 <div class="history-main">
 <div class="history-intro">
  <p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="calendar-days" size={22}/></span>{fr?'Notre histoire':'Our story'}</p>
  <h2 id="history-title">{fr?'Depuis 2002.':'Since 2002.'}<br/><em>{fr?'Et demain, ensemble.':'And a shared future.'}</em></h2>
  <p>{fr?'Une histoire d’expertise, de confiance et de collectif. Nicolas Chalanset et Benoit Leger-Derville ont créé Stelau avec une même envie : comprendre les sujets difficiles et faire avancer les projets.':'A story of expertise, trust and teamwork. Nicolas Chalanset and Benoit Leger-Derville founded Stelau with a shared ambition: understand difficult subjects and help projects move forward.'}</p>
  <figure><Image src={founders} alt={fr?'Benoit Leger-Derville et Nicolas Chalanset, les deux fondateurs de Stelau, réunis lors d’un événement professionnel.':'Benoit Leger-Derville and Nicolas Chalanset, Stelau’s two founders, together at a professional event.'} widths={[480,800,1200]} sizes="(max-width:720px) 90vw, 43vw" width={1200} format="webp" loading="lazy"/><figcaption><span class="mono">STELAU / {fr?'LES FONDATEURS':'THE FOUNDERS'}</span><span>Benoit Leger-Derville & Nicolas Chalanset</span></figcaption></figure>
  <a class="text-link" href={group[lang].announcement} target="_blank" rel="noopener noreferrer">{group[lang].cta}<Arrow/></a>
 </div>
 <ol class="history-timeline" aria-label={fr?'Les grandes étapes de Stelau':'Stelau milestones'}>{historyFor(lang).map(m=><li><span class="history-year mono"><time datetime={m.year}>{m.year}</time></span><div><h3>{m.title}</h3><p>{m.text}</p></div></li>)}</ol>
 </div>
 <p class="history-sources">{fr?'Quelques repères de notre parcours.':'Selected milestones from our journey.'} <a href="https://web.archive.org/web/20250410072609/https://www.stelau.com/" target="_blank" rel="noopener noreferrer">{fr?'Notre site en 2025':'Our website in 2025'} ↗</a> · <a href="https://www.ege.fr/ecole/corps-professoral/benoit-leger-derville" target="_blank" rel="noopener noreferrer">{fr?'Parcours et enseignement':'Career and teaching'} ↗</a> · <a href="https://www.linkedin.com/in/legerderville/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></p>
</section>
<style>
 .stelau-history{border-top:1px solid var(--line)}.history-main{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}.history-intro{position:sticky;top:30px}.history-intro h2{margin:22px 0;font-size:clamp(38px,4vw,52px);line-height:1.13}.history-intro>p:not(.eyebrow){font-size:16px;line-height:1.9;max-width:600px}.history-intro figure{margin:30px 0 24px}.history-intro :global(img){width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:center 55%;border-radius:12px}.history-intro figcaption{display:flex;flex-direction:column;gap:9px;margin-top:15px;font-size:13px;line-height:1.7;color:var(--muted)}.history-intro figcaption .mono{font-size:11px;color:var(--brand)}.history-intro .text-link{font-size:14px;gap:12px}.history-timeline{list-style:none;margin:0;padding:3px 0 0 28px;border-left:1px solid var(--line)}.history-timeline li{position:relative;padding:0 0 35px}.history-timeline li::before{content:'';position:absolute;left:-34px;top:4px;width:11px;height:11px;border-radius:50%;background:var(--paper);border:2px solid var(--brand);box-shadow:0 0 0 5px var(--paper)}.history-timeline li:last-child{padding-bottom:0}.history-timeline li:last-child::before{background:var(--brand)}.history-year{display:block;font-size:14px;color:var(--brand);margin-bottom:12px}.history-timeline h3{font-size:23px;line-height:1.25;margin:0 0 13px;letter-spacing:-.025em}.history-timeline p{font-size:15px;line-height:1.85;margin:0;color:var(--muted)}.history-sources{margin:35px 0 0;padding-top:22px;border-top:1px solid var(--line);font-size:12px;line-height:1.9;color:var(--muted)}.history-sources a{border-bottom:1px solid var(--line)}
 @media(max-width:1000px){.history-main{gap:40px}.history-timeline{padding-left:24px}.history-timeline li::before{left:-30px}}
 @media(max-width:720px){.history-main{grid-template-columns:1fr;gap:38px}.history-intro{position:static}.history-intro h2{font-size:38px}.history-intro :global(img){object-position:center}.history-timeline{margin-left:6px}.history-timeline h3{font-size:22px}.history-sources{margin-top:38px}}
</style>
