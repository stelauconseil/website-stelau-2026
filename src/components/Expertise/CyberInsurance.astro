---
import {Image} from 'astro:assets';
import Arrow from '@/components/Arrow.astro';
import ExpertiseSimulation from './ExpertiseSimulation.astro';
import incidentTeam from '@/assets/images/expertise-cyber/equipe-gestion-incident.jpg';
import collectiveAnalysis from '@/assets/images/expertise-cyber/analyse-collective.jpg';
import expertPortrait from '@/assets/images/expertise-cyber/regard-expert.jpg';
import interviewPoster from '@/assets/images/expertise-cyber/poster-entretien-ixi-plus.jpg';
import Icon from '@/components/Icon/Icon.astro';
import { href, type Locale } from '@/config/site';
const { lang } = Astro.props as { lang: Locale };
const fr = lang === 'fr';
const sections = [
  { id: 'entretien', fr: 'L’entretien IXI-Plus', en: 'The IXI-Plus interview' },
  { id: 'metier', fr: 'Un métier, une responsabilité', en: 'A profession, a responsibility' },
  { id: 'deontologie', fr: 'Déontologie et vérité', en: 'Ethics and truth' },
  { id: 'materialite', fr: 'Matérialité et mécanismes', en: 'Evidence and mechanisms' },
  { id: 'causalite', fr: 'Causalité et sinistre', en: 'Causation and loss' },
  { id: 'missions', fr: 'Nos missions avec IXI-Plus', en: 'Our work with IXI-Plus' },
  { id: 'dire', fr: 'Du constat au dire', en: 'From findings to a submission' },
  { id: 'transmission', fr: 'Transmettre le métier', en: 'Passing on the profession' },
];
const questionIcons = ['magnifying-glass','share-nodes','link'] as const;
const questions = fr ? [
  ['01 / Matérialité', 'Quels faits établissent l’attaque ?', 'Identifier, examiner et documenter les traces disponibles.'],
  ['02 / Mécanismes', 'Comment a-t-elle fonctionné ?', 'Reconstituer la chronologie et expliquer les mécanismes techniques.'],
  ['03 / Causalité', 'A-t-elle causé le sinistre ?', 'Examiner le lien entre les événements et les dommages déclarés.'],
] : [
  ['01 / Evidence', 'What establishes that an attack occurred?', 'Identify, examine and document the available evidence.'],
  ['02 / Mechanisms', 'How did it work?', 'Reconstruct the timeline and explain the technical mechanisms.'],
  ['03 / Causation', 'Did it cause the loss?', 'Examine the link between events and the reported damage.'],
];
---
<section class="container page-intro insurance-intro">
  <a class="back-link" href={href(lang,'expertise')+'conseil/'}>← {fr?'Conseil & expertise':'Advice & expertise'}</a>
  <p class="eyebrow">IXI-Plus / {fr?'Expertise professionnelle':'Professional expertise'}</p>
  <h1>{fr?'Expertise cybersécurité.':'Cybersecurity expertise.'}<br/><em>{fr?'Pour l’assurance.':'For insurance.'}</em></h1>
  <p class="lead">{fr?<Fragment>Établir les faits, comprendre les mécanismes d’une attaque et examiner leur <strong class="insurance-emphasis">lien causal</strong> avec un sinistre. Au sein du réseau IXI-Plus, Stelau apporte une expertise technique guidée par la rigueur, la déontologie et la manifestation de la vérité.</Fragment>:<Fragment>Establish the facts, understand an attack’s mechanisms and examine their <strong class="insurance-emphasis">causal link</strong> to a loss. Within the IXI-Plus network, Stelau provides technical expertise guided by rigour, professional ethics and a commitment to establishing the truth.</Fragment>}</p>
</section>
<section id="entretien" class="container insurance-interview" aria-labelledby="interview-title">
 <div class="interview-card">
  <div class="interview-player"><video controls playsinline preload="none" poster={interviewPoster.src} width="1138" height="640" aria-label={fr?'Entretien IXI-Plus : le métier d’expert cyber':'IXI-Plus interview: the cybersecurity expert profession (in French)'}><source src="/media/expertise-cyber/entretien-ixi-plus-expert-cyber.mp4" type="video/mp4"/><p>{fr?'Votre navigateur ne peut pas lire cette vidéo.':'Your browser cannot play this video.'} <a href="/media/expertise-cyber/entretien-ixi-plus-expert-cyber.mp4">{fr?'Ouvrir l’entretien':'Open the interview'}</a></p></video></div>
  <div class="interview-copy"><p class="eyebrow icon-eyebrow"><Icon name="comments" size={24}/>IXI-Plus / 02:51</p><h2 id="interview-title">{fr?'L’expertise, racontée par ceux qui la pratiquent.':'Expertise, in the words of a practitioner.'}</h2><p>{fr?'Un entretien IXI-Plus pour découvrir le métier d’expert cyber et mettre un visage sur cette pratique professionnelle.':'An IXI-Plus interview introducing the cybersecurity expert profession and the people behind it.'}</p><span class="interview-language">{fr?'Entretien en français':'Interview in French'}</span></div>
 </div>
</section>
<section class="container insurance-questions" aria-label={fr?'Les trois questions de l’expertise':'Three questions guiding an expert assessment'}>
  {questions.map(([label,title,description],i)=><div class="insurance-question"><div class="insurance-question-top"><p class="eyebrow">{label}</p><span class="insurance-icon-tile"><Icon name={questionIcons[i]} size={38}/></span></div><h2>{title}</h2><p>{description}</p></div>)}
</section>
<div class="container article-grid section-space insurance-article">
  <aside class="article-aside" data-pagefind-ignore><nav aria-label={fr?'Sur cette page':'On this page'}>{sections.map(s=><a href={'#'+s.id}>{s[lang]}</a>)}</nav><a class="text-link insurance-contact-link" href={href(lang,'contact')}>{fr?'Parlons de votre mission':'Discuss your assignment'}<Arrow /></a></aside>
  <div class="prose insurance-copy">
    <section id="metier">
      <h2 class="insurance-section-title"><span class="insurance-heading-icon"><Icon name="briefcase" size={28}/></span><span>{fr?'Un métier, une responsabilité.':'A profession, a responsibility.'}</span></h2>
      <p>{fr?<Fragment>Être expert en cybersécurité mobilise une compétence technique, une expérience de terrain et une méthode d’investigation. Cela engage aussi une responsabilité professionnelle : examiner les faits avec <strong class="insurance-emphasis">discernement</strong>, expliciter son raisonnement et rendre des <strong class="insurance-emphasis">conclusions étayées</strong>, compréhensibles et vérifiables.</Fragment>:<Fragment>Working as a cybersecurity expert calls for technical competence, practical experience and an investigative method. It also entails professional responsibility: <strong class="insurance-emphasis">examine facts carefully</strong>, explain the reasoning and produce <strong class="insurance-emphasis">substantiated</strong>, understandable and verifiable conclusions.</Fragment>}</p>
      <p>{fr?'Cette activité d’expertise pour l’assurance s’exerce dans le cadre d’une mission définie avec le mandant. Elle se distingue de l’expertise judiciaire confiée par un juge à un expert désigné par un tribunal. Son cadre propre n’atténue ni les exigences de rigueur ni l’engagement déontologique de l’expert.':'This work for insurance is carried out within the scope of an agreed assignment. It is distinct from a judicial expert assessment commissioned by a judge through appointment by a court in France. Its own framework carries demanding standards of rigour and professional ethics.'}</p>
    </section>
    <figure class="insurance-photo"><Image src={expertPortrait} alt={fr?'Un professionnel travaille sur son ordinateur portable, avec deux collègues en arrière-plan.':'A professional working on a laptop, with two colleagues in the background.'} widths={[480,900,1400]} sizes="(min-width: 900px) 65vw, 100vw" width={1400} format="webp" loading="lazy"/><figcaption>{fr?'Le discernement, au cœur de la pratique.':'Sound judgement at the heart of professional practice.'}<span>Illustration</span></figcaption></figure>
    <section id="deontologie">
      <h2 class="insurance-section-title"><span class="insurance-heading-icon"><Icon name="compass" size={28}/></span><span>{fr?'La manifestation de la vérité comme engagement.':'A commitment to establishing the truth.'}</span></h2>
      <p>{fr?<Fragment>Notre démarche vise à contribuer à la <strong class="insurance-emphasis">manifestation de la vérité</strong> : établir ce que les éléments disponibles permettent de démontrer, examiner les hypothèses concurrentes et signaler ce qui demeure incertain.</Fragment>:<Fragment>Our approach seeks to <strong class="insurance-emphasis">establish the truth</strong>: determine what the available evidence supports, examine competing hypotheses and identify what remains uncertain.</Fragment>}</p>
      <p class="insurance-principle">{fr?<Fragment><strong>Les conclusions suivent les faits</strong>, y compris lorsqu’ils conduisent à revoir l’hypothèse initiale.</Fragment>:<Fragment><strong>Conclusions follow the facts</strong>, including when those facts require the initial hypothesis to be revised.</Fragment>}</p>
      <ul class="insurance-ethics">
        <li class="ethics-card"><span class="ethics-icon"><Icon name="eye" size={28}/></span><h3>{fr?'Objectivité et impartialité':'Objectivity and impartiality'}</h3><p>{fr?'Conserver son indépendance de jugement et identifier les conflits d’intérêts.':'Exercise independent judgement and identify conflicts of interest.'}</p></li>
        <li class="ethics-card"><span class="ethics-icon"><Icon name="clipboard-check" size={28}/></span><h3>{fr?'Rigueur et traçabilité':'Rigour and traceability'}</h3><p>{fr?'Documenter les sources, les opérations réalisées et le raisonnement qui relie les constats aux conclusions.':'Document sources, investigative steps and the reasoning connecting findings to conclusions.'}</p></li>
        <li class="ethics-card"><span class="ethics-icon"><Icon name="file-check" size={28}/></span><h3>{fr?'Confidentialité':'Confidentiality'}</h3><p>{fr?'Protéger les informations et les données confiées dans le cadre de la mission.':'Protect the information and data entrusted to the expert during the assignment.'}</p></li>
        <li class="ethics-card"><span class="ethics-icon"><Icon name="users" size={28}/></span><h3>{fr?'Compétence et mesure':'Competence and sound judgement'}</h3><p>{fr?'Respecter le périmètre de la mission, reconnaître ses limites et mobiliser les compétences complémentaires nécessaires.':'Respect the scope of the assignment, acknowledge limitations and bring in additional expertise when needed.'}</p></li>
      </ul>
      <p>{fr?'Les constats, les hypothèses et les conclusions sont distingués dans le rapport. Les observations des interlocuteurs concernés sont examinées dans le cadre prévu par la mission.':'Findings, hypotheses and conclusions are distinguished in the report. Observations from relevant participants are examined within the framework of the assignment.'}</p>
    </section>
    <section id="materialite">
      <h2 class="insurance-section-title"><span class="insurance-heading-icon"><Icon name="magnifying-glass" size={28}/></span><span>{fr?'Matérialiser l’attaque et expliquer ses mécanismes.':'Establish evidence of the attack and explain its mechanisms.'}</span></h2>
      <p>{fr?<Fragment>Une <strong class="insurance-emphasis">attaque déclarée</strong> appelle une investigation. Journaux techniques, traces réseau, fichiers, configurations, sauvegardes et autres artefacts numériques peuvent contribuer à en établir la <strong class="insurance-emphasis">matérialité</strong>. Leur origine, leur intégrité et les conditions de leur collecte doivent être documentées pour permettre d’apprécier leur portée.</Fragment>:<Fragment>A <strong class="insurance-emphasis">reported attack</strong> calls for investigation. Logs, network traces, files, configurations, backups and other digital artefacts can help <strong class="insurance-emphasis">establish whether it occurred</strong>. Their origin, integrity and collection conditions need to be documented so their significance can be assessed.</Fragment>}</p>
      <ol class="insurance-method" aria-label={fr?'Repères de méthode':'Method at a glance'} data-pagefind-ignore>
        <li><Icon name="magnifying-glass" size={24}/><span>{fr?'Examiner':'Examine'}</span></li>
        <li><Icon name="share-nodes" size={24}/><span>{fr?'Reconstituer':'Reconstruct'}</span></li>
        <li><Icon name="clipboard-check" size={24}/><span>{fr?'Documenter':'Document'}</span></li>
      </ol>
      <p>{fr?'L’analyse cherche à reconstituer la chronologie, les accès utilisés, les actions réalisées et les systèmes affectés. Elle examine les mécanismes susceptibles d’expliquer les faits et les autres causes possibles, comme une panne, une erreur humaine ou une mauvaise configuration.':'The analysis seeks to reconstruct the timeline, access paths, actions taken and affected systems. It examines mechanisms that could explain the findings alongside other possible causes, such as equipment failure, human error or misconfiguration.'}</p>
      <p>{fr?<Fragment>La disponibilité et la qualité des traces conditionnent ce qui peut être établi. Chaque conclusion précise les éléments qui la soutiennent et les <strong class="insurance-emphasis">limites de l’analyse</strong>.</Fragment>:<Fragment>The availability and quality of evidence determine what can be established. Each conclusion identifies its supporting evidence and the <strong class="insurance-emphasis">limits of the analysis</strong>.</Fragment>}</p>
    </section>
    <figure class="insurance-photo"><Image src={incidentTeam} alt={fr?'Des professionnels en bureau échangent par téléphone et travaillent sur leurs ordinateurs.':'Office professionals making phone calls and working at their computers.'} widths={[480,900,1400]} sizes="(min-width: 900px) 65vw, 100vw" width={1400} format="webp" loading="lazy"/><figcaption>{fr?'Recueillir les éléments. Comprendre les faits.':'Gather the material. Understand the facts.'}<span>Illustration</span></figcaption></figure>
    <section id="causalite">
      <h2 class="insurance-section-title"><span class="insurance-heading-icon"><Icon name="link" size={28}/></span><span>{fr?'Relier les mécanismes aux dommages. Ou écarter ce lien.':'Connect the mechanisms to the damage. Or rule out that link.'}</span></h2>
      <p>{fr?<Fragment>La présence d’une attaque et celle d’un dommage ne suffisent pas à établir une relation de <strong class="insurance-emphasis">cause à effet</strong>. L’expert examine l’enchaînement technique qui pourrait relier les événements observés à une interruption d’activité, une perte de données, une altération de systèmes ou d’autres dommages déclarés.</Fragment>:<Fragment>The occurrence of an attack and the existence of damage do not, on their own, establish <strong class="insurance-emphasis">cause and effect</strong>. The expert examines the technical sequence that could connect observed events to business interruption, data loss, system alteration or other reported damage.</Fragment>}</p>
      <p>{fr?'Cette recherche de causalité confronte la chronologie, les mécanismes identifiés, l’étendue des effets et les explications alternatives. Elle permet de distinguer les conséquences imputables à l’attaque de celles liées à d’autres événements ou à des défaillances préexistantes.':'Assessing causation involves comparing the timeline, identified mechanisms, extent of the effects and alternative explanations. This helps distinguish consequences attributable to the attack from those associated with other events or pre-existing failures.'}</p>
      <div class="insurance-conclusion"><ul class="insurance-statuses" aria-label={fr?'Conclusions possibles sur le lien causal':'Possible conclusions about causation'} data-pagefind-ignore>
        <li><Icon name="check" size={18}/><span>{fr?'Lien établi':'Link established'}</span></li>
        <li><Icon name="xmark" size={18}/><span>{fr?'Lien écarté':'Link ruled out'}</span></li>
        <li><Icon name="question" size={18}/><span>{fr?'Lien indéterminé':'Link undetermined'}</span></li>
      </ul><p>{fr?'Selon les éléments disponibles, l’expertise peut établir un lien causal, l’écarter ou conclure qu’il reste indéterminé. L’absence de traces suffisantes ne constitue pas, à elle seule, la preuve qu’aucune attaque n’a eu lieu.':'Depending on the available evidence, the assessment may establish a causal link, rule it out or conclude that it remains undetermined. Insufficient evidence does not, by itself, prove that no attack occurred.'}</p></div>
    </section>
    <section id="missions">
      <h2 class="insurance-section-title"><span class="insurance-heading-icon"><Icon name="file-check" size={28}/></span><span>{fr?'Une expertise technique au sein du réseau IXI-Plus.':'Technical expertise within the IXI-Plus network.'}</span></h2>
      <p>{fr?<Fragment>Stelau apporte ses compétences en cybersécurité aux missions du réseau IXI-Plus auprès des acteurs de l’assurance. Les interventions peuvent porter sur la prévention des risques, la <strong class="insurance-emphasis">recherche des causes d’un sinistre</strong>, l’analyse de ses conséquences et les mesures de réparation ou de prévention adaptées.</Fragment>:<Fragment>Stelau contributes its cybersecurity skills to IXI-Plus network assignments for the insurance sector. Work may cover risk prevention, <strong class="insurance-emphasis">investigation of the causes of a loss</strong>, analysis of its consequences and appropriate recovery or preventive measures.</Fragment>}</p>
      <p>{fr?'Les dimensions techniques sont mises en relation avec les autres compétences nécessaires à la mission, notamment financières, industrielles et de gestion de crise. Le rapport expose le périmètre, les éléments examinés, les constats, le raisonnement causal, les limites et les recommandations. Il éclaire les décisions des acteurs de l’assurance.':'Technical findings are considered alongside other expertise needed for the assignment, including financial, industrial and crisis management skills. The report sets out the scope, material examined, findings, causal reasoning, limitations and recommendations. It informs decisions by participants in the insurance sector.'}</p>
    </section>
    <ExpertiseSimulation lang={lang} kind="rapport"/>
    <section id="dire">
     <h2 class="insurance-section-title"><span class="insurance-heading-icon"><Icon name="comments" size={28}/></span><span>{fr?'Du constat technique au dire argumenté.':'From technical findings to a reasoned submission.'}</span></h2>
     <p>{fr?'Dans le cadre distinct d’une expertise judiciaire, une partie peut adresser à l’expert désigné des observations écrites, communément appelées « dires ». Une analyse technique permet d’étayer ces observations : citer les pièces, préciser les faits, examiner les hypothèses et formuler les points qui appellent une réponse.':'In the separate framework of a French judicial expert assessment, a party may send written observations to the appointed expert, commonly called a “dire”. Technical analysis can support those observations by citing exhibits, specifying facts, examining hypotheses and setting out points requiring a response.'}</p>
     <p>{fr?<Fragment>Le <strong class="insurance-emphasis">dire</strong> porte les observations de la partie ; il se distingue du rapport rédigé par l’expert judiciaire. La simulation ci-dessous illustre ce cheminement avec un dossier fictif.</Fragment>:<Fragment>The <strong class="insurance-emphasis">submission</strong> sets out a party’s observations; it is distinct from the judicial expert’s report. The simulation below illustrates this process using a fictional case.</Fragment>}</p>
     <ExpertiseSimulation lang={lang} kind="dire"/>
    </section>
    <figure class="insurance-photo"><Image src={collectiveAnalysis} alt={fr?'Une équipe examine ensemble des informations affichées sur un ordinateur portable.':'A team examining information together on a laptop.'} widths={[480,900,1400]} sizes="(min-width: 900px) 65vw, 100vw" width={1400} format="webp" loading="lazy"/><figcaption>{fr?'Confronter les regards. Transmettre la méthode.':'Compare perspectives. Pass on the method.'}<span>Illustration</span></figcaption></figure>
    <section id="transmission">
      <h2 class="insurance-section-title"><span class="insurance-heading-icon"><Icon name="users" size={28}/></span><span>{fr?'Transmettre la pratique du métier.':'Passing on professional practice.'}</span></h2>
      <p>{fr?'Devenir expert pour l’assurance demande de compléter ses compétences en cybersécurité par l’apprentissage de l’investigation, de l’analyse causale, de la rédaction de rapports et de la déontologie. L’expérience des experts de Stelau constitue un socle pour transmettre cette pratique aux ingénieurs consultants et accompagner leur progression.':'Becoming an expert for insurance requires cybersecurity skills to be complemented by training in investigation, causal analysis, report writing and professional ethics. The experience of Stelau’s experts provides a foundation for passing on this practice to consulting engineers and supporting their development.'}</p>
      <p>{fr?<Fragment>Cette progression associe apprentissage, analyse de cas et travail aux côtés de praticiens expérimentés. Elle développe la capacité à <strong class="insurance-emphasis">argumenter une conclusion</strong>, à la confronter aux faits et à reconnaître ce que l’on ne peut pas démontrer.</Fragment>:<Fragment>This development combines learning, case analysis and work alongside experienced practitioners. It builds the ability to <strong class="insurance-emphasis">justify a conclusion</strong>, test it against the facts and recognise what cannot be demonstrated.</Fragment>}</p>
    </section>
    <div class="insurance-next"><p>{fr?'Une mission d’expertise à préparer ou une situation à analyser ?':'An expert assignment to prepare or a situation to analyse?'}</p><a class="button" href={href(lang,'contact')}>{fr?'Échanger avec nos experts':'Talk to our experts'}<Arrow /></a></div>
    <p class="insurance-photo-note">{fr?'En raison de la forte confidentialité des dossiers d’expertise, les photographies prises par Stelau lors de ses missions sont conservées dans ses archives professionnelles et ne peuvent pas figurer sur son site web. Les trois photographies utilisées ici sont des illustrations.':'Because expert case files are highly confidential, photographs taken by Stelau during its assignments are retained in its professional archives and cannot appear on its website. The three photographs shown here are illustrations.'}</p>
    <div class="insurance-references" data-pagefind-ignore><p>{fr?'Repères complémentaires':'Further reading'}</p><ul><li><a href="https://www.service-public.gouv.fr/particuliers/vosdroits/F2161" target="_blank" rel="noopener noreferrer">{fr?'Service Public — le cadre de l’expertise judiciaire':'Service Public — the framework for judicial expertise in France'} ↗</a></li><li><a href="https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000006410415" target="_blank" rel="noopener noreferrer">{fr?'Code de procédure civile — article 276, observations des parties':'French Code of Civil Procedure — Article 276, parties’ observations'} ↗</a></li><li><a href="https://csrc.nist.gov/pubs/sp/800/86/final" target="_blank" rel="noopener noreferrer">NIST SP 800-86 — Guide to Integrating Forensic Techniques into Incident Response ↗</a></li></ul></div>
  </div>
</div>
<style>
  .insurance-intro,.insurance-copy{--editorial-saffron:#ebc55a;--editorial-annotation:#ebc55a70;--editorial-wash:#ebc55a17}
  :global(.dark) .insurance-intro,:global(.dark) .insurance-copy{--editorial-saffron:#d8ad48;--editorial-annotation:#d8ad4870;--editorial-wash:#d8ad4817}
  .insurance-emphasis{color:var(--ink);font-weight:600;background:linear-gradient(transparent 67%,var(--editorial-annotation) 67%,var(--editorial-annotation) 95%,transparent 95%);box-decoration-break:clone;-webkit-box-decoration-break:clone}
  .insurance-copy .insurance-principle{border-left:3px solid var(--editorial-saffron);padding:16px 22px;background:var(--editorial-wash);margin:24px 0 28px}
  .insurance-interview{padding-bottom:42px;scroll-margin-top:120px}
  .interview-card{display:grid;grid-template-columns:1.7fr 1fr;align-items:center;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--surface)}
  .interview-player{background:#212529;min-width:0}
  .interview-player video{width:100%;aspect-ratio:1138/640;object-fit:contain;margin:0}
  .interview-copy{padding:30px}
  .interview-copy h2{font-size:clamp(24px,2.3vw,34px);line-height:1.2;margin:18px 0}
  .interview-copy>p:not(.eyebrow){font-size:16px;line-height:1.8}
  .interview-language{display:block;font-size:12px;color:var(--muted);margin-top:20px}
  .insurance-copy .insurance-photo{margin:38px 0 44px}
  .insurance-photo>img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:10px}
  .insurance-photo figcaption{display:flex;justify-content:space-between;align-items:start;gap:20px;margin-top:12px;font-size:13px;line-height:1.6;color:var(--muted)}
  .insurance-photo figcaption>span{font-size:11px;white-space:nowrap}
  .insurance-copy .insurance-photo-note{font-size:12px;line-height:1.8;padding-top:24px;border-top:1px solid var(--line);margin-top:32px}
  @media(max-width:1100px){.interview-card{grid-template-columns:1.4fr 1fr}.interview-copy{padding:24px}}
  @media(max-width:900px){.interview-card{grid-template-columns:1fr}.interview-copy{padding:26px}.interview-copy h2{max-width:600px}}
  @media(max-width:720px){.insurance-interview{padding-bottom:28px}.interview-copy{padding:22px}.insurance-photo figcaption{flex-direction:column;gap:5px}.insurance-photo>img{aspect-ratio:4/3}}

  .insurance-intro .back-link{margin-bottom:24px}
  .insurance-intro .lead{max-width:890px}
  .insurance-questions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;padding-bottom:26px}
  .insurance-question{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:26px}
  .insurance-question:nth-child(2){background:var(--soft)}
  .insurance-question-top{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .insurance-icon-tile{display:flex;align-items:center;justify-content:center;width:62px;height:62px;border:1px solid var(--line);border-radius:14px;background:var(--paper);flex-shrink:0}
  .insurance-copy h2.insurance-section-title{display:flex;align-items:flex-start;gap:15px}
  .insurance-heading-icon{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid var(--line);border-radius:10px;background:var(--soft);flex-shrink:0;margin-top:1px}
  .insurance-section-title>span:last-child{align-self:center}
  .insurance-copy ul.insurance-ethics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding:0;list-style:none;margin:28px 0}
  .insurance-copy .ethics-card{margin:0;padding:24px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
  .ethics-icon{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:var(--soft)}
  .insurance-copy .ethics-card h3{font-size:19px;line-height:1.4;letter-spacing:-.025em;margin:18px 0 10px;color:var(--ink)}
  .insurance-copy .ethics-card p{font-size:inherit;line-height:1.8;margin:0}
