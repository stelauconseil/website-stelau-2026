---
import {Image} from 'astro:assets';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import CrisisPreparation from './CrisisPreparation.astro';
import {href,cyberInsuranceHref,type Locale} from '@/config/site';
import type {IconName} from '@/data/icons';
import room from '@/assets/images/exercices-crise-cyber/salle-gestion-crise.png';
import technical from '@/assets/images/audits-certification/auditeur-travail-technique.jpg';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
const partner='https://www.linkedin.com/in/g%C3%A9raud-de-vaublanc-0b203618/';
const stages:{icon:IconName;title:string;text:string}[]=fr?[
 {icon:'compass',title:'Concevoir le scénario.',text:'Attaque, accident, menace interne : nos consultants construisent les situations que votre organisation souhaite travailler. Notre expérience des attaques et sinistres réels nourrit leur pertinence, en tenant compte de vos activités et de vos objectifs.'},
 {icon:'file-check',title:'Écrire les supports.',text:'Messages d’information, pièces techniques, fiches de rôle, réponses et chronogramme : chaque artefact est préparé en amont. Émetteur, destinataire, contenu et horaire doivent former un ensemble crédible, cohérent et exploitable par les animateurs.'},
 {icon:'comments',title:'Faire vivre la crise.',text:'Le jour J, Stelau intervient dans la salle de contrôle. Nous jouons les prestataires informatiques, le support utilisateurs, les interlocuteurs régaliens et les personnels impliqués, en distillant les événements cyber et en répondant aux décisions des participants.'}
]:[
 {icon:'compass',title:'Design the scenario.',text:'Attack, accident, insider threat: our consultants design situations your organisation wants to practise. Experience with actual attacks and losses informs their relevance, in light of your operations and objectives.'},
 {icon:'file-check',title:'Write the materials.',text:'Information messages, technical exhibits, role cards, responses and an event schedule: every item is prepared in advance. Sender, recipient, content and timing must form a credible, consistent set that the exercise controllers can use.'},
 {icon:'comments',title:'Bring the crisis to life.',text:'On the day, Stelau works in the exercise control room. We play IT providers, user support, public-authority contacts and personnel involved, introducing cyber events and responding to participants’ decisions.'}
];
const sources=[
 {org:'ANSSI / CCA',title:fr?'Organiser un exercice de gestion de crise cyber':'Organising a cyber crisis management exercise',description:fr?'Objectifs, scénario, chronogramme et animation.':'Objectives, scenario, event schedule and facilitation.',url:'https://messervices.cyber.gouv.fr/guides/organiser-un-exercice-de-gestion-de-crise-cyber'},
 {org:'ANSSI / CDSE',title:fr?'Crise cyber : gestion opérationnelle et stratégique':'Cyber crisis: operational and strategic management',description:fr?'Articuler les cellules et les décisions de crise.':'Coordinate crisis teams and decisions.',url:'https://messervices.cyber.gouv.fr/guides/crise-cyber-les-cles-dune-gestion-operationnelle-et-strategique'},
 {org:'ANSSI · 2026',title:fr?'Anticiper et gérer sa communication de crise cyber':'Anticipating and managing cyber crisis communication',description:fr?'Préparer les messages et la communication.':'Prepare messages and communication.',url:'https://messervices.cyber.gouv.fr/guides/anticiper-et-gerer-sa-communication-de-crise-cyber'},
 {org:'ENISA · 2026',title:'The ENISA Cybersecurity Exercise Methodology',description:fr?'Planifier, conduire et évaluer un exercice.':'Plan, conduct and evaluate an exercise.',url:'https://www.enisa.europa.eu/publications/the-enisa-cybersecurity-exercise-methodology'}
];
---
<div class="container page-intro crisis-hero"><div><a class="back-link" href={href(lang,'expertise')+'audit/'}>← {fr?'Audits & évaluations':'Audits & assessments'}</a><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="comments" size={24}/></span>{fr?'EXERCICES DE GESTION DE CRISE CYBER':'CYBER CRISIS MANAGEMENT EXERCISES'}</p><h1>{fr?'Exercice,':'Exercise,'}<br/><em>{fr?'exercice…':'exercise…'}</em></h1><p class="crisis-hook">{fr?'Préparer les décisions avant la crise.':'Practise decisions before a crisis.'}</p><p class="lead">{fr?'Stelau conçoit, prépare et anime le volet cybersécurité de vos exercices de gestion de crise. Des scénarios ancrés dans le réel, des supports soignés et une animation qui met vos équipes en situation de décider.':'Stelau designs, prepares and facilitates the cybersecurity side of your crisis management exercises. Scenarios grounded in reality, carefully prepared materials and facilitation that puts your teams in a position to make decisions.'}</p><div class="crisis-actions"><a class="button" href={href(lang,'contact')}>{fr?'Préparer votre exercice':'Plan your exercise'}<Arrow/></a><a class="text-link" href="#preparation">{fr?'Voir les coulisses':'Behind the scenes'}<Arrow/></a></div></div><figure class="crisis-room"><Image src={room} alt={fr?'Une salle de réunion équipée de microphones, vue à travers une paroi vitrée.':'A meeting room equipped with microphones, seen through a glass partition.'} widths={[480,800,1200,1600]} sizes="(max-width:720px) 90vw, 43vw" width={1600} format="webp" loading="eager"/></figure></div>
<aside class="container crisis-partner" aria-label={fr?'Notre partenariat':'Our partnership'}><div class="crisis-partner-card"><Icon name="users" size={34}/><div><p class="eyebrow">{fr?'UNE EXPERTISE COMPLÉMENTAIRE':'COMPLEMENTARY EXPERTISE'}</p><p>{fr?'Avec Géraud de Vaublanc, spécialiste de la stratégie de communication et de la gestion de crise auprès de dirigeants de grands groupes, notamment du CAC 40. Il porte le dispositif global de gestion de crise ; Stelau en construit et anime la dimension cyber.':'With Géraud de Vaublanc, a specialist in communication strategy and crisis management for leaders of major companies, including CAC 40 groups. He leads the overall crisis management framework; Stelau designs and facilitates its cyber dimension.'}</p></div><a class="text-link" href={partner} target="_blank" rel="noopener noreferrer">{fr?'Géraud de Vaublanc':'Géraud de Vaublanc'}<Arrow/></a></div></aside>
<section class="container crisis-section" aria-labelledby="crisis-work"><p class="eyebrow">01 / {fr?'Du scénario à la salle de contrôle':'From scenario to control room'}</p><h2 id="crisis-work">{fr?'Le réalisme se construit.':'Realism takes preparation.'}</h2><div class="crisis-stages">{stages.map((s,i)=><article><div class="crisis-stage-top"><span class="mono">0{i+1}</span><Icon name={s.icon} size={32}/></div><h3>{s.title}</h3><p>{s.text}</p></article>)}</div><a class="text-link crisis-expertise-link" href={cyberInsuranceHref(lang)}>{fr?'L’expérience des attaques et sinistres derrière nos scénarios':'The attack and loss assessment experience behind our scenarios'}<Arrow/></a></section>
<section id="preparation" class="container crisis-section" aria-labelledby="crisis-prepare"><div class="crisis-section-heading"><div><p class="eyebrow">02 / {fr?'La qualité de la préparation':'Quality of preparation'}</p><h2 id="crisis-prepare">{fr?'Quatre jours de crise.':'Four days of crisis.'}<br/><em>{fr?'Une journée pour s’entraîner.':'One day to practise.'}</em></h2></div><p>{fr?'Un scénario peut couvrir quatre jours, week-end compris, joués en une journée. Nous préparons le rythme, les informations disponibles et les interactions, puis vérifions leur cohérence avant la première injection.':'A scenario can span four days, including a weekend, played out in one day. We prepare the pacing, available information and interactions, then check their consistency before the first inject.'}</p></div><CrisisPreparation lang={lang}/><div class="crisis-exercise-convention"><Icon name="circle-info" size={23}/><p><strong>{fr?'« EXERCICE, EXERCICE, EXERCICE ».':'“EXERCISE, EXERCISE, EXERCISE”.'}</strong> {fr?'Cette mention accompagne les communications de jeu pour identifier la simulation. Les consignes et les canaux sont convenus au briefing.':'This marker accompanies exercise communications to identify the simulation. Instructions and communication channels are agreed at the briefing.'}</p></div></section>
<section class="container crisis-section" aria-labelledby="crisis-feedback"><p class="eyebrow">03 / {fr?'Transformer l’exercice en progrès':'Turn practice into progress'}</p><div class="crisis-feedback-grid"><div><h2 id="crisis-feedback">{fr?'Les enseignements':'Lessons'}<br/><em>{fr?'restent après le jeu.':'last beyond the exercise.'}</em></h2><article class="crisis-feedback"><Icon name="comments" size={25}/><div><h3>{fr?'À chaud, juste après.':'Immediately afterwards.'}</h3><p>{fr?'Recueillir les perceptions, restituer les observations et faire émerger les premiers enseignements sur les décisions, les échanges et la coordination.':'Gather perceptions, share observations and identify initial lessons about decisions, information sharing and coordination.'}</p></div></article><article class="crisis-feedback"><Icon name="clipboard-check" size={25}/><div><h3>{fr?'À froid, quelques semaines plus tard.':'A few weeks later.'}</h3><p>{fr?'Recouper la chronologie, analyser les réactions avec recul et formuler des actions d’amélioration concrètes. Les artefacts préparés et les observations donnent au retour d’expérience une base solide.':'Cross-check the timeline, review reactions with perspective and identify practical improvements. Prepared materials and observations give the lessons-learned review a sound basis.'}</p></div></article></div><figure class="crisis-technical"><Image src={technical} alt={fr?'Un professionnel analyse des informations techniques sur ses écrans.':'A professional analysing technical information on screens.'} widths={[480,800,1200]} sizes="(max-width:720px) 90vw, 43vw" width={1200} format="webp"/></figure></div></section>
<section class="container crisis-section crisis-close"><details class="crisis-sources"><summary><Icon name="book-open" size={23}/><span>{fr?'Nos repères méthodologiques : ANSSI et ENISA':'Our methodological references: ANSSI and ENISA'}</span><span class="sources-plus" aria-hidden="true">+</span></summary><p>{fr?'Des repères pour définir les objectifs, structurer le jeu, préparer la communication et organiser les retours d’expérience.':'References for setting objectives, structuring the exercise, preparing communication and organising lessons-learned reviews.'}</p><ul>{sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer"><span class="mono">{s.org}</span><strong>{s.title}</strong><span>{s.description}</span><Arrow/></a></li>)}</ul></details><div class="crisis-call-to-action"><h2>{fr?'Préparons votre prochain exercice.':'Let’s prepare your next exercise.'}</h2><a class="button" href={href(lang,'contact')}>{fr?'Échanger avec Stelau':'Talk to Stelau'}<Arrow/></a></div></section>
<style>
 .crisis-hero{display:grid;grid-template-columns:1.12fr 1fr;gap:65px;align-items:center;padding-top:48px;padding-bottom:38px}.crisis-hero>div{min-width:0}.crisis-hero .eyebrow{font-size:11px;margin-top:30px}.crisis-hero h1{font-size:clamp(52px,5.8vw,82px);line-height:1.05;letter-spacing:-.045em;margin:25px 0}.crisis-hook{font-size:22px;font-weight:550;line-height:1.5;margin:0 0 18px}.crisis-hero .lead{font-size:17px;line-height:1.85;margin:0}.crisis-actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:28px}.crisis-actions .button{font-size:15px;gap:18px}.crisis-actions .text-link{font-size:14px;gap:12px}.crisis-room{margin:0}.crisis-room>img{width:100%;height:555px;object-fit:cover;object-position:65% center;border-radius:14px}
 .crisis-partner{padding-top:10px;padding-bottom:15px}.crisis-partner-card{display:flex;align-items:center;gap:24px;padding:25px 28px;background:var(--soft);border:1px solid var(--line);border-radius:12px}.crisis-partner-card>div{flex:1;min-width:0}.crisis-partner-card .eyebrow{font-size:10px;margin:0 0 8px}.crisis-partner-card p:not(.eyebrow){font-size:14px;line-height:1.85;margin:0;color:var(--muted)}.crisis-partner-card .text-link{font-size:12px;gap:10px;white-space:nowrap}
 .crisis-section{padding-top:45px;padding-bottom:25px;scroll-margin-top:32px}.crisis-section h2{font-size:clamp(30px,3.4vw,44px);line-height:1.2;letter-spacing:-.035em;margin:16px 0 25px}.crisis-section h3{font-size:24px;line-height:1.35;margin:18px 0}.crisis-section p:not(.eyebrow){font-size:16px;line-height:1.85;color:var(--muted)}.crisis-stages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:28px}.crisis-stages article{padding:26px;background:var(--surface);border:1px solid var(--line);border-radius:12px;min-width:0}.crisis-stage-top{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:24px}.crisis-stage-top .mono{font-size:11px;color:var(--muted)}.crisis-stages h3{font-size:24px;margin:0 0 18px;letter-spacing:-.03em}.crisis-stages p{font-size:15px!important;line-height:1.85!important;margin:0}.crisis-expertise-link{font-size:13px;margin-top:23px;gap:12px}.crisis-section-heading{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.crisis-section-heading h2{margin-bottom:0}.crisis-section-heading>p{margin:20px 0 0}
 .crisis-exercise-convention{display:flex;align-items:start;gap:15px;padding:20px 0;border-bottom:1px solid var(--line)}.crisis-exercise-convention :global(.fa-icon){margin-top:3px}.crisis-exercise-convention p{font-size:13px!important;line-height:1.8!important;margin:0}.crisis-exercise-convention strong{font-weight:550;color:var(--ink)}
 .crisis-feedback-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.crisis-feedback-grid h2{margin-bottom:28px}.crisis-feedback{display:flex;gap:18px;align-items:start;margin-top:25px}.crisis-feedback :global(.fa-icon){margin-top:3px}.crisis-feedback h3{font-size:20px;margin:0 0 10px}.crisis-feedback p{font-size:15px!important;line-height:1.85!important;margin:0}.crisis-technical{margin:0}.crisis-technical>img{width:100%;height:400px;object-fit:cover;object-position:58% center;border-radius:14px}
 .crisis-sources{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.crisis-sources summary{display:flex;gap:15px;align-items:center;padding:22px 0;cursor:pointer;list-style:none;font-size:15px}.crisis-sources summary::-webkit-details-marker{display:none}.sources-plus{margin-left:auto;color:var(--brand);font-size:22px}.crisis-sources[open] .sources-plus{transform:rotate(45deg)}.crisis-sources>p{font-size:14px!important;max-width:850px;margin:0 0 20px}.crisis-sources ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:0;margin:0 0 28px}.crisis-sources li{min-width:0}.crisis-sources li a{position:relative;display:flex;flex-direction:column;gap:9px;padding:20px 45px 20px 20px;background:var(--surface);border:1px solid var(--line);border-radius:8px;height:100%}.crisis-sources li a:hover{border-color:var(--brand)}.crisis-sources .mono{font-size:10px;color:var(--brand)}.crisis-sources li strong{font-size:15px;font-weight:550;line-height:1.5}.crisis-sources li span:last-of-type{font-size:12px;color:var(--muted);line-height:1.75}.crisis-sources li :global(.arrow){position:absolute;right:20px;top:20px;width:17px;height:17px;color:var(--brand)}.crisis-close{padding-bottom:75px}.crisis-call-to-action{display:flex;align-items:center;justify-content:space-between;gap:35px;margin-top:40px}.crisis-call-to-action h2{font-size:clamp(28px,3vw,38px);max-width:670px;margin:0}.crisis-call-to-action .button{font-size:15px;flex-shrink:0}
 @media(max-width:1050px){.crisis-hero,.crisis-section-heading,.crisis-feedback-grid{gap:35px}.crisis-hero h1{font-size:68px}.crisis-room>img{height:575px}.crisis-partner-card{gap:20px;flex-wrap:wrap}.crisis-partner-card>div{flex-basis:calc(100% - 60px)}.crisis-partner-card .text-link{margin-left:54px}.crisis-stages{gap:15px}.crisis-stages article{padding:22px}.crisis-stages h3{font-size:22px}.crisis-call-to-action{gap:25px}}
 @media(max-width:720px){.crisis-hero{grid-template-columns:1fr;gap:30px;padding-top:35px;padding-bottom:25px}.crisis-hero h1{font-size:clamp(50px,10vw,70px);margin-top:23px}.crisis-hero .eyebrow{font-size:10px;gap:9px}.crisis-hook{font-size:20px}.crisis-hero .lead{font-size:16px}.crisis-room>img{height:340px;object-position:62% 61%}.crisis-actions{gap:20px;margin-top:25px}.crisis-actions .button{font-size:14px;padding:16px 19px}.crisis-actions .text-link{font-size:13px}.crisis-partner{padding-top:10px}.crisis-partner-card{padding:22px;gap:17px;align-items:start}.crisis-partner-card>div{flex-basis:calc(100% - 54px)}.crisis-partner-card .text-link{margin-left:51px;white-space:normal}.crisis-partner-card p:not(.eyebrow){font-size:13px}.crisis-section{padding-top:35px;padding-bottom:22px}.crisis-section h2{font-size:33px}.crisis-stages{grid-template-columns:1fr;gap:16px}.crisis-stages article{padding:24px}.crisis-stages h3{font-size:25px}.crisis-stage-top{margin-bottom:20px}.crisis-section-heading,.crisis-feedback-grid{grid-template-columns:1fr;gap:10px}.crisis-section-heading>p{margin-top:20px}.crisis-feedback-grid{gap:28px}.crisis-feedback h3{font-size:20px}.crisis-technical>img{height:330px}.crisis-sources summary{font-size:14px;gap:12px}.crisis-sources ul{grid-template-columns:1fr;gap:14px}.crisis-call-to-action{align-items:start;flex-direction:column;gap:25px}.crisis-call-to-action h2{font-size:31px}.crisis-close{padding-bottom:60px}}
 @media(max-width:380px){.crisis-hero h1{font-size:51px}.crisis-hero .eyebrow{font-size:9px}.crisis-section h2,.crisis-call-to-action h2{font-size:30px}.crisis-partner-card{padding:20px}.crisis-room>img{height:310px}}
</style>
