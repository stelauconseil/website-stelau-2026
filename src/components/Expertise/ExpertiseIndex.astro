---
import Icon from '@/components/Icon/Icon.astro';
import {expertiseIcons} from '@/data/icons';
import Arrow from '@/components/Arrow.astro';
import {href,cyberInsuranceHref,type Locale} from '@/config/site';import {expertises} from '@/data/expertises';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
---
<div class="container page-intro"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="compass" size={22}/></span>{fr?'Nos expertises':'Our expertise'}</p><h1>{fr?'Le regard juste.':'A clear perspective.'}<br/><em>{fr?'Le geste précis.':'A precise approach.'}</em></h1><p class="lead">{fr?'Du premier diagnostic au code en production, nos experts en cybersécurité vous accompagnent dans vos projets de sécurité et d’identité numérique. Notre expertise relie l’analyse, le conseil, l’audit et le développement sécurisé.':'From the first assessment to production code, our cybersecurity experts support your security and digital identity projects. Our expertise connects analysis, advice, audits and secure development.'}</p></div>
<section class="container expertise-detail-list">{expertises.map(e=><a class="expertise-detail-row" href={href(lang,'expertise')+e.slug+'/'}><span class="mono">/{e.number}</span><div><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name={expertiseIcons[e.slug]} size={22}/></span>{e[lang].tag}</p><h2>{e[lang].title}</h2><p>{e[lang].description}</p><div class="card-tags">{e.tags.map(t=><span>{t}</span>)}</div></div><Arrow /></a>)}</section>

<section class="container section-space"><a class="insurance-feature" href={cyberInsuranceHref(lang)}><div><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="file-check" size={22}/></span>IXI-Plus / {fr?'Expertise cybersécurité pour l’assurance':'Cybersecurity expertise for insurance'}</p><h2>{fr?'Établir les faits.':'Establish the facts.'}<br/><em>{fr?'Comprendre les causes.':'Understand the causes.'}</em></h2><p>{fr?'Matérialité des attaques, analyse de leurs mécanismes et lien causal avec les dommages : une expertise professionnelle, fondée sur des éléments vérifiables et une déontologie exigeante.':'Evidence of attacks, analysis of their mechanisms and causal links to damage: professional expertise based on verifiable findings and rigorous ethics.'}</p><span class="text-link">{fr?'Découvrir cette activité':'Explore this work'}<Arrow /></span></div><Arrow /></a></section>
