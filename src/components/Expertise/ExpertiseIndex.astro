---
import {Image} from 'astro:assets';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import {href,expertiseSectionHref,type Locale,type ExpertiseSection} from '@/config/site';
import {expertises} from '@/data/expertises';
import {activitiesFor} from '@/data/expertise-catalogue';
import {expertiseIcons} from '@/data/icons';
import codeReview from '@/assets/images/code-review.jpeg';
import auditMeeting from '@/assets/images/audits-certification/ecoute-reunion-audit.jpg';
import workshop from '@/assets/images/workshop.jpeg';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
const photos={conseil:codeReview,audit:auditMeeting,developpement:workshop};
const photoAlts={conseil:fr?'Des collègues réunis autour de leurs ordinateurs pour une revue de code.':'Colleagues gathered around their computers for a code review.',audit:fr?'Un professionnel travaille sur son ordinateur pendant une réunion.':'A professional working on a laptop during a meeting.',developpement:fr?'Un atelier collectif autour de tables de travail.':'A collaborative workshop around work tables.'};
---
<div class="container page-intro"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="compass" size={22}/></span>{fr?'Nos expertises':'Our expertise'}</p><h1>{fr?'Le regard juste.':'A clear perspective.'}<br/><em>{fr?'Le geste précis.':'A precise approach.'}</em></h1><p class="lead">{fr?'Du premier diagnostic au code en production, nos experts en cybersécurité relient conseil, audit et développement sécurisé. Retrouvez ici nos activités et accédez directement à celles qui vous intéressent.':'From the first assessment to production code, our cybersecurity experts connect consulting, audits and secure development. Find our activities here and go directly to the ones that interest you.'}</p><nav class="catalogue-jump" aria-label={fr?'Explorer nos expertises':'Explore our expertise'}>{expertises.map(e=><a href={expertiseSectionHref(lang,e.slug as ExpertiseSection)}><Icon name={expertiseIcons[e.slug]} size={20}/>{e[lang].verb}<Arrow/></a>)}</nav></div>
<div class="container expertise-catalogue">{expertises.map(e=>{const group=e.slug as ExpertiseSection;return <section id={group} class="catalogue-group" aria-labelledby={`catalogue-${group}`}><div class="catalogue-heading"><div><p class="eyebrow icon-eyebrow"><Icon name={expertiseIcons[group]} size={25}/>{e.number} / {e[lang].title}</p><h2 id={`catalogue-${group}`}>{e[lang].verb}</h2><p>{e[lang].description}</p></div><figure><Image src={photos[group]} alt={photoAlts[group]} width={900} widths={[480,900]} sizes="(max-width:720px) 90vw, 360px" format="webp"/></figure></div><div class="catalogue-activities">{activitiesFor(group).map(a=>a.id==='formation'?<article id="formation" class="activity-card formation-card" aria-labelledby="formation-title"><div class="activity-card-top"><Icon name={a.icon} size={30}/><span class="mono">EPITA / EGE</span></div><h3 id="formation-title">{a[lang].label}</h3><p>{a[lang].description}</p><span class="formation-years">{fr?'Plus de 15 ans de transmission':'Over 15 years of teaching'}</span><a class="text-link" href={href(lang,'contact')}>{fr?'Échanger sur nos cours':'Discuss our teaching'}<Arrow/></a></article>:<a class="activity-card" href={a.href(lang)}><div class="activity-card-top"><Icon name={a.icon} size={30}/><Arrow/></div><h3>{a[lang].label}</h3><p>{a[lang].description}</p><span class="activity-open">{fr?'Découvrir cette activité':'Explore this work'}<Arrow/></span></a>)}</div><details class="catalogue-method"><summary>{fr?'Notre approche et nos livrables':'Our approach and deliverables'}<span aria-hidden="true">+</span></summary><p>{e[lang].body}</p><ul>{e[lang].deliverables.map(d=><li><Icon name="check" size={18}/>{d}</li>)}</ul></details></section>})}<div class="catalogue-close"><p>{fr?'Un enjeu traverse plusieurs expertises ? Nous les faisons travailler ensemble.':'Does your challenge span several areas? We bring them together.'}</p><a class="button" href={href(lang,'contact')}>{fr?'Parlons de votre projet':'Let’s discuss your project'}<Arrow/></a></div></div>
<style>
 .catalogue-jump{display:flex;flex-wrap:wrap;gap:12px;margin-top:35px}.catalogue-jump a{display:flex;align-items:center;gap:12px;padding:12px 18px;background:var(--surface);border:1px solid var(--line);border-radius:8px;font-size:14px}.catalogue-jump a:hover{border-color:var(--brand)}.catalogue-jump :global(.arrow){width:16px;height:16px;color:var(--brand)}.expertise-catalogue{padding-bottom:80px}.catalogue-group{padding:48px 0 62px;border-top:1px solid var(--line);scroll-margin-top:30px}.catalogue-heading{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:65px;align-items:center;margin-bottom:30px}.catalogue-heading .eyebrow{font-size:12px;margin-bottom:18px}.catalogue-heading h2{font:italic clamp(44px,5vw,64px)/1.1 Georgia,serif;letter-spacing:-.045em;margin:0 0 23px}.catalogue-heading p:not(.eyebrow){font-size:17px;line-height:1.85;max-width:700px;color:var(--muted)}.catalogue-heading figure{margin:0}.catalogue-heading :global(img){width:100%;height:250px;object-fit:cover;border-radius:12px}.catalogue-activities{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.activity-card{display:flex;flex-direction:column;padding:28px;border:1px solid var(--line);border-radius:12px;background:var(--surface);min-width:0;transition:border-color .2s}.activity-card:hover{border-color:var(--brand)}.activity-card-top{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:25px}.activity-card-top>.mono{font-size:11px;color:var(--muted)}.activity-card :global(.arrow){width:20px;height:20px;color:var(--brand)}.activity-card h3{font-size:25px;line-height:1.25;letter-spacing:-.035em;margin:0 0 15px}.activity-card p{font-size:15px;line-height:1.85;color:var(--muted);margin:0 0 22px}.activity-open{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:17px;margin-top:auto;font-size:13px}.formation-card{background:var(--soft);scroll-margin-top:35px}.formation-years{color:var(--brand);font-size:13px;margin-bottom:18px}.formation-card .text-link{margin-top:auto;align-self:start;font-size:13px}.catalogue-method{margin-top:25px;border-bottom:1px solid var(--line)}.catalogue-method summary{display:flex;justify-content:space-between;gap:15px;padding:16px 0;cursor:pointer;list-style:none;font-size:14px;color:var(--muted)}.catalogue-method summary::-webkit-details-marker{display:none}.catalogue-method summary>span{color:var(--brand);font-size:18px}.catalogue-method[open] summary>span{transform:rotate(45deg)}.catalogue-method p{max-width:800px;font-size:15px;line-height:1.85;margin:12px 0 20px}.catalogue-method ul{display:grid;grid-template-columns:1fr 1fr;list-style:none;gap:14px 25px;padding:0;margin:0 0 26px}.catalogue-method li{display:flex;align-items:start;gap:10px;font-size:14px;color:var(--muted)}.catalogue-method li :global(.fa-icon){margin-top:3px}.catalogue-close{display:flex;justify-content:space-between;align-items:center;gap:35px;border-top:1px solid var(--line);padding-top:30px}.catalogue-close>p{font-size:17px;line-height:1.8;max-width:620px;margin:0}
 @media(max-width:1000px){.catalogue-heading{grid-template-columns:1fr 280px;gap:35px}.catalogue-heading :global(img){height:225px}}
 @media(max-width:720px){.catalogue-heading{grid-template-columns:1fr;gap:22px}.catalogue-heading :global(img){height:220px}.catalogue-heading p:not(.eyebrow){font-size:16px}.catalogue-heading h2{font-size:48px}.catalogue-group{padding:35px 0 45px}.catalogue-activities{grid-template-columns:1fr;gap:16px}.activity-card{padding:24px}.activity-card h3{font-size:24px}.catalogue-method ul{grid-template-columns:1fr}.catalogue-close{align-items:start;flex-direction:column;gap:22px}.catalogue-close>p{font-size:16px}.expertise-catalogue{padding-bottom:60px}.catalogue-jump{gap:8px}.catalogue-jump a{font-size:12px;padding:10px 12px;gap:8px}}
</style>
