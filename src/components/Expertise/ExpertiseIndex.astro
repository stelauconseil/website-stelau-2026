---
import Icon from '@/components/Icon/Icon.astro';
import ExpertiseThumbnail from './ExpertiseThumbnail.astro';
import team from '@/assets/images/wallets-geneve/rencontre-stelau-idakto.jpg';
import conference from '@/assets/images/wallets-geneve/demonstration-conference-identite-numerique.jpg';
import expertPortrait from '@/assets/images/expertise-cyber/regard-expert.jpg';
import {expertiseIcons} from '@/data/icons';
import Arrow from '@/components/Arrow.astro';
import {href,cyberInsuranceHref,walletExpertiseHref,type Locale} from '@/config/site';import {expertises} from '@/data/expertises';
const {lang}=Astro.props as {lang:Locale};const fr=lang==='fr';
---
<div class="container page-intro"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="compass" size={22}/></span>{fr?'Nos expertises':'Our expertise'}</p><h1>{fr?'Le regard juste.':'A clear perspective.'}<br/><em>{fr?'Le geste précis.':'A precise approach.'}</em></h1><p class="lead">{fr?'Du premier diagnostic au code en production, nos experts en cybersécurité vous accompagnent dans vos projets de sécurité et d’identité numérique. Notre expertise relie l’analyse, le conseil, l’audit et le développement sécurisé.':'From the first assessment to production code, our cybersecurity experts support your security and digital identity projects. Our expertise connects analysis, advice, audits and secure development.'}</p></div>
<section class="container expertise-detail-list">
  {expertises.map(e=><a class="expertise-detail-row expertise-with-media" href={href(lang,'expertise')+e.slug+'/'}>
    <span class="mono">/{e.number}</span>
    <div class="expertise-row-copy"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name={expertiseIcons[e.slug]} size={22}/></span>{e[lang].tag}</p><h2>{e[lang].title}</h2><p>{e[lang].description}</p><div class="card-tags">{e.tags.map(t=><span>{t}</span>)}</div></div>
    <div class="expertise-row-media"><ExpertiseThumbnail image={e.slug==='conseil'?team:undefined} alt={fr?'Trois participants réunis lors d’une conférence internationale sur l’identité numérique.':'Three participants together at an international digital identity conference.'} icon={expertiseIcons[e.slug]} label={fr?'Visuel à venir':'Image to come'}/></div>
    <Arrow />
  </a>)}
</section>

<section class="container section-space"><a class="insurance-feature" href={cyberInsuranceHref(lang)}><div class="expertise-feature-copy"><div class="expertise-feature-media"><ExpertiseThumbnail image={expertPortrait} alt={fr?'Portrait d’un professionnel à sa table de travail, utilisé comme illustration.':'Portrait of a professional at a work table, used as an illustration.'} illustration={fr?'Illustration':'Illustration'}/></div><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="file-check" size={22}/></span>IXI-Plus / {fr?'Expertise cybersécurité pour l’assurance':'Cybersecurity expertise for insurance'}</p><h2>{fr?'Établir les faits.':'Establish the facts.'}<br/><em>{fr?'Comprendre les causes.':'Understand the causes.'}</em></h2><p>{fr?'Matérialité des attaques, analyse de leurs mécanismes et lien causal avec les dommages : une expertise professionnelle, fondée sur des éléments vérifiables et une déontologie exigeante.':'Evidence of attacks, analysis of their mechanisms and causal links to damage: professional expertise based on verifiable findings and rigorous ethics.'}</p><span class="text-link">{fr?'Découvrir cette activité':'Explore this work'}<Arrow /></span></div><Arrow /></a></section>

<section class="container section-space"><a class="insurance-feature" href={walletExpertiseHref(lang)}><div class="expertise-feature-copy"><div class="expertise-feature-media"><ExpertiseThumbnail image={conference} alt={fr?'Présentation d’outils d’identité numérique sur scène devant les participants d’une conférence.':'Digital identity tools presented on stage to conference participants.'}/></div><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="wallet" size={22}/></span>{fr?'Wallets / Identité numérique':'Wallets / Digital identity'}</p><h2>{fr?'De la norme':'From standards'}<br/><em>{fr?'à l’interopérabilité.':'to interoperability.'}</em></h2><p>{fr?'Émission, présentation et vérification d’attestations : nos experts relient standards, cryptographie et développement. Avec des essais de terrain, aux côtés de France Identité et de la communauté internationale.':'Credential issuance, presentation and verification: our experts connect standards, cryptography and development, with field testing alongside France Identité and the international community.'}</p><span class="text-link">{fr?'Explorer notre expertise Wallets':'Explore our Wallets expertise'}<Arrow /></span></div><Arrow /></a></section>

<style>
  .expertise-with-media{grid-template-columns:65px minmax(0,1fr) 220px 30px;gap:28px}
  .expertise-row-copy{min-width:0}.expertise-row-media{align-self:start;margin-top:4px}
  .expertise-with-media h2{font-size:clamp(29px,3.2vw,38px)}
  .insurance-feature{display:block;position:relative}
  .expertise-feature-copy{display:flow-root}
  .expertise-feature-media{float:right;width:240px;margin:0 0 22px 36px}
  .insurance-feature> :global(.arrow){position:absolute;right:36px;bottom:36px}
  .insurance-feature .text-link{padding-right:50px}
  @media(max-width:1000px){.expertise-with-media{grid-template-columns:40px minmax(0,1fr) 170px 22px;gap:20px}.expertise-feature-media{width:210px;margin-left:26px}}
  @media(max-width:720px){
    .expertise-with-media{grid-template-columns:35px minmax(0,1fr);gap:20px}
    .expertise-row-media{grid-column:2;grid-row:1;width:150px;justify-self:end;margin-top:0}
    .expertise-row-copy{grid-column:1/-1;grid-row:2}
    .expertise-feature-media{float:none;width:160px;margin:0 0 22px auto}
    .insurance-feature> :global(.arrow){display:none}
    .insurance-feature .text-link{padding-right:0}
  }
</style>
