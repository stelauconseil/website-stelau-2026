---
import Icon from '@/components/Icon/Icon.astro';
import type {Locale} from '@/config/site';
interface Props {lang:Locale; kind:'rapport'|'dire'}
const {lang,kind}=Astro.props;
const fr=lang==='fr';const report=kind==='rapport';
const title=report?(fr?'Des traces au rapport d’expertise.':'From evidence to the expert report.'):(fr?'Des observations à un dire argumenté.':'From observations to a reasoned submission.');
const panels=report?(fr?[
 ['Les pièces','Examiner et préserver','Journaux, sauvegardes et éléments confiés : chaque source est identifiée.'],
 ['La chronologie','Relier les événements','Les constats sont replacés dans le temps, avec leurs limites.'],
 ['La causalité','Confronter les hypothèses','L’attaque, les effets et les autres causes possibles sont examinés.'],
 ['Le rapport','Documenter les conclusions','Sources, constats, raisonnement et limites composent le rapport.']
]:[
 ['The material','Examine and preserve','Logs, backups and entrusted material: each source is identified.'],
 ['The timeline','Connect the events','Findings are placed in time, with their limitations.'],
 ['Causation','Test the hypotheses','The attack, its effects and other possible causes are examined.'],
 ['The report','Document conclusions','Sources, findings, reasoning and limitations make up the report.']
]):(fr?[
 ['Les observations','Lire et questionner','Une partie examine les éléments discutés au cours de l’expertise.'],
 ['Les pièces citées','Étayer chaque point','Les observations sont reliées aux pièces et aux faits vérifiables.'],
 ['Le contradictoire','Formuler les questions','Des explications alternatives et des points à éclaircir sont exposés.'],
 ['Le dire','Adresser les observations','Le dire de la partie est transmis à l’expert judiciaire désigné.']
]:[
 ['The observations','Read and question','A party examines the material discussed during the expert assessment.'],
 ['Referenced exhibits','Support each point','Observations refer to exhibits and verifiable facts.'],
 ['The exchange','Formulate questions','Alternative explanations and points to clarify are presented.'],
 ['The submission','Send the observations','The party’s written submission is sent to the appointed judicial expert.']
]);
const labels=fr?['Pièce A','Pièce B','Pièce C']:['Exhibit A','Exhibit B','Exhibit C'];
const diagramLabels=report?(fr?['Attaque','Effets','Autre cause']:['Attack','Effects','Other cause']):(fr?['Observation','Pièce citée','Question']:['Observation','Exhibit','Question']);
const stem=`/media/expertise-cyber/${kind}-${lang}`;
---
<figure class="expertise-simulation" data-simulation data-kind={kind} data-progress="1" data-lang={lang} data-stage="4">
 <div class="simulation-canvas">
  <header class="simulation-heading"><div><p class="simulation-label">STELAU / {fr?'LE RAISONNEMENT EN MOUVEMENT':'REASONING IN MOTION'}</p><h3>{title}</h3></div><span class="simulation-counter" data-simulation-counter aria-hidden="true">04 / 04</span></header>
  <p class="simulation-fiction">{fr?'Simulation pédagogique · dossier fictif':'Educational simulation · fictional case'}</p>
  <div class="simulation-panels">
   {panels.map(([label,heading,description],i)=><div class="simulation-panel" data-panel={i} data-active="false">
    <div class="simulation-panel-top"><span class="simulation-number">0{i+1}</span><p>{label}</p><Icon name={(['database','clock','share-nodes','file-check'] as const)[i]} size={22}/></div>
    <h4>{heading}</h4>
    {i===0&&<div class="simulation-drawing source-drawing" aria-hidden="true">{labels.map((label,j)=><div class="source-row" style={`--row:${j}`}><span class="source-dot"></span><span>{label}</span><span class="source-line"><i/></span><span class="source-check">✓</span></div>)}</div>}
    {i===1&&<div class="simulation-drawing" aria-hidden="true"><svg viewBox="0 0 340 90"><path class="diagram-grid" d="M20 70H320M20 38H320"/><path class="timeline-track" d="M24 65H310"/><path class="timeline-progress" d="M24 65H310" pathLength="1"/>{[30,120,210,300].map((x,j)=><g><line class="diagram-grid" x1={x} y1="28" x2={x} y2="78"/><circle class="timeline-node" style={`--node:${j}`} cx={x} cy="65" r="6"/><text x={x} y="20" text-anchor="middle">{report?['08:12','08:19','08:24','08:41'][j]:['A','B','C','D'][j]}</text></g>)}</svg></div>}
    {i===2&&<div class="simulation-drawing causation-drawing" aria-hidden="true"><svg viewBox="0 0 340 104"><path class="diagram-grid" d="M45 26H285M45 78H285"/><path class="causation-path" pathLength="1" d="M55 26H280M55 78C155 78 170 26 280 26"/>{[[45,26],[290,26],[45,78]].map(([x,y],j)=><g><circle class="causation-node" cx={x} cy={y} r="9"/><text x={x===290?x-5:x+20} y={y-14} text-anchor={x===290?'end':'start'}>{diagramLabels[j]}</text></g>)}</svg></div>}
    {i===3&&<div class="simulation-drawing document-drawing" aria-hidden="true"><div class="simulation-document"><span class="document-title">{report?(fr?'RAPPORT D’EXPERTISE':'EXPERT REPORT'):(fr?'DIRE À L’EXPERT':'WRITTEN SUBMISSION')}</span>{[0,1,2,3].map(j=><span class="document-line" style={`--document-line:${j}`}><i/></span>)}<span class="document-stamp">{report?(fr?'Conclusions motivées':'Reasoned conclusions'):(fr?'Observations de la partie':'Party’s observations')}</span></div><span class="document-route"><Icon name={report?'clipboard-check':'paper-plane'} size={28}/><span>{report?(fr?'Au mandant':'To the client'):(fr?'À l’expert désigné':'To the appointed expert')}</span></span></div>}
    <p class="simulation-description">{description}</p>
   </div>)}
  </div>
  <footer class="simulation-footer"><span>{report?(fr?'Examiner → Reconstituer → Conclure':'Examine → Reconstruct → Conclude'):(fr?'Observer → Argumenter → Transmettre':'Observe → Explain → Submit')}</span><span class="simulation-signal" aria-hidden="true"><i/><i/><i/><i/></span></footer>
 </div>
 <figcaption class="simulation-caption"><span>{report?(fr?'Les conclusions dépendent des éléments disponibles.':'Conclusions depend on the available evidence.'):(fr?'Le dire est une observation écrite d’une partie ; l’expert judiciaire conduit la mission confiée par le juge.':'A “dire” is a party’s written submission; the judicial expert conducts the court-appointed assessment.')}</span><div class="simulation-controls"><button type="button" data-simulation-toggle aria-pressed="false" aria-label={fr?'Lire l’animation':'Play animation'}>{fr?'Lire l’animation':'Play animation'}</button><button type="button" data-simulation-replay>{fr?'Rejouer':'Replay'}</button><a class="gif-download gif-light" href={stem+'-light.gif'} download>{fr?'GIF':'GIF'} ↓</a><a class="gif-download gif-dark" href={stem+'-dark.gif'} download>GIF ↓</a></div></figcaption>
</figure>
<script>
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
 document.querySelectorAll<HTMLElement>('[data-simulation]').forEach(el=>{
  el.dataset.initialized='true';
  const fr=el.dataset.lang==='fr';const toggle=el.querySelector<HTMLButtonElement>('[data-simulation-toggle]')!;
  let elapsed=0;let previous=0;let frame=0;let playing=false;let visible=false;let manual=false;
  const duration=18000;
  function render(progress:number){
   el.dataset.progress=String(progress);const stage=Math.min(3,Math.floor(progress*4));el.dataset.stage=String(stage+1);
   el.querySelector('[data-simulation-counter]')!.textContent=`0${stage+1} / 04`;
   el.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel,i)=>{
    const value=Math.min(1,Math.max(0,progress*4-i));panel.style.setProperty('--phase',String(value));
    panel.dataset.active=String(stage===i);panel.dataset.complete=String(value===1);
   });
  }
  function button(){toggle.setAttribute('aria-pressed',String(playing));const label=playing?(fr?'Pause':'Pause'):(fr?'Lire l’animation':'Play animation');toggle.textContent=label;toggle.setAttribute('aria-label',label);}
  function stop(){playing=false;cancelAnimationFrame(frame);previous=0;button();}
  function tick(time:number){if(!playing)return;if(previous)elapsed+=Math.min(time-previous,100);previous=time;render(Math.min(1,elapsed/duration));if(elapsed>=duration+2200)elapsed=0;frame=requestAnimationFrame(tick);}
  function start(){if(playing)return;playing=true;previous=0;button();frame=requestAnimationFrame(tick);}
  toggle.addEventListener('click',()=>{manual=true;if(playing)stop();else start();});
  el.querySelector('[data-simulation-replay]')!.addEventListener('click',()=>{manual=true;elapsed=0;render(0);start();});
  el.addEventListener('simulation-seek',(event)=>{manual=true;stop();render((event as CustomEvent<number>).detail);});
  new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(!visible)stop();else if(!manual&&!reduced.matches)start();},{threshold:.15}).observe(el);
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();else if(visible&&!manual&&!reduced.matches)start();});
  reduced.addEventListener('change',()=>{if(reduced.matches){stop();render(1);}else if(visible&&!manual)start();});
  render(reduced.matches?1:0);
 });
</script>
<style>
 .expertise-simulation{margin:32px 0 42px}
 .simulation-canvas{padding:28px;background:var(--paper);border:1px solid var(--line);border-radius:14px;color:var(--ink)}
 .simulation-heading{display:flex;justify-content:space-between;align-items:center;gap:20px}
 .simulation-label{font-family:var(--font-mono);font-size:10px!important;letter-spacing:.08em;margin:0 0 8px!important;line-height:1.6!important}
 .simulation-heading h3{font-size:25px!important;letter-spacing:-.035em;line-height:1.25!important;margin:0!important}
 .simulation-counter{font-family:var(--font-mono);font-size:12px;color:var(--brand);white-space:nowrap;border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:7px 10px}
 .simulation-fiction{font-size:12px!important;margin:10px 0 24px!important;color:var(--muted)}
 .simulation-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
 .simulation-panel{padding:20px;background:var(--surface);border:1px solid var(--line);border-radius:9px;min-width:0;--phase:1}
 .simulation-panel[data-active="true"]{border-color:var(--brand);box-shadow:0 0 0 1px var(--brand)}
 .simulation-panel-top{display:flex;gap:8px;align-items:center}
 .simulation-panel-top p{font-family:var(--font-mono);font-size:10px!important;letter-spacing:.025em;margin:0!important;text-transform:uppercase;line-height:1.5!important}
 .simulation-panel-top :global(.fa-icon){margin-left:auto}
 .simulation-number{font-family:var(--font-mono);font-size:10px;color:var(--brand);background:var(--soft);border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
 .simulation-panel h4{font-size:17px;letter-spacing:-.025em;line-height:1.3;margin:12px 0 8px}
 .simulation-drawing{height:106px;display:flex;align-items:center;margin:8px 0 14px}
 .simulation-drawing svg{width:100%;height:auto;max-height:106px;overflow:visible}
 .simulation-drawing text{font-family:var(--font-mono);font-size:12px;fill:var(--muted)}
 .diagram-grid{stroke:var(--line);fill:none;stroke-width:1}
 .timeline-track{stroke:var(--line);stroke-width:2}
 .timeline-progress,.causation-path{fill:none;stroke:var(--brand);stroke-width:2;stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--phase))}
 .timeline-node{fill:var(--brand);opacity:clamp(.15,calc(var(--phase)*4 - var(--node)),1)}
 .source-drawing{flex-direction:column;align-items:stretch;justify-content:center;gap:9px}
 .source-row{display:flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:11px;color:var(--muted)}
 .source-dot{width:6px;height:6px;border-radius:50%;background:var(--brand)}
 .source-line{flex:1;height:5px;background:var(--soft);border-radius:4px;overflow:hidden}
 .source-line i{display:block;height:100%;background:var(--brand);width:calc(clamp(0,calc(var(--phase)*3 - var(--row)),1)*100%)}
 .source-check{color:var(--brand);opacity:clamp(.15,calc(var(--phase)*3 - var(--row)),1)}
 .causation-node{fill:var(--brand);opacity:calc(.3 + var(--phase)*.7)}
 .document-drawing{gap:14px}
 .simulation-document{flex:1;border:1px solid var(--line);border-radius:5px;background:var(--paper);padding:12px;transform:translateY(calc((1 - var(--phase))*5px));min-width:0}
 .document-title{font-family:var(--font-mono);color:var(--brand);font-size:8px;display:block;margin-bottom:7px;white-space:nowrap}
 .document-line{display:block;height:3px;background:var(--soft);margin:5px 0;border-radius:3px;overflow:hidden}
 .document-line i{display:block;height:100%;width:calc(clamp(0,calc(var(--phase)*4 - var(--document-line)),1)*100%);background:var(--muted);opacity:.55}
 .document-stamp{font-size:8px;color:var(--brand);display:block;opacity:clamp(0,calc(var(--phase)*4 - 3),1)}
 .document-route{display:flex;flex-direction:column;align-items:center;gap:8px;width:85px;text-align:center;opacity:calc(.2 + var(--phase)*.8);font-size:10px;color:var(--muted);line-height:1.4}
 .simulation-description{font-size:13px!important;line-height:1.65!important;margin:0!important}
 .simulation-footer{display:flex;justify-content:space-between;gap:16px;margin-top:22px;border-top:1px solid var(--line);padding-top:16px;font-size:11px;color:var(--muted)}
 .simulation-signal{display:flex;gap:5px;align-items:center}
 .simulation-signal i{width:5px;height:5px;border-radius:50%;background:var(--brand);opacity:.4}
 .simulation-caption{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-top:14px;color:var(--muted);font-size:12px;line-height:1.7}
 .simulation-caption>span{max-width:500px}
 .simulation-controls{display:flex;gap:12px;align-items:center;flex-wrap:wrap;flex-shrink:0}
 .simulation-controls button,.simulation-controls a{border:0;background:none;padding:0;color:var(--brand);font-size:12px;text-decoration:underline;text-underline-offset:4px;white-space:nowrap}
 .simulation-controls button{display:none}
 .expertise-simulation[data-initialized="true"] .simulation-controls button{display:inline}
 .gif-dark{display:none}
 :global(.dark) .gif-light{display:none}
 :global(.dark) .gif-dark{display:inline}
 @media(max-width:1100px){.simulation-caption{flex-direction:column;gap:10px}.simulation-canvas{padding:20px}.simulation-panel{padding:16px}}
 @media(max-width:600px){.simulation-panels{grid-template-columns:1fr}.simulation-heading{align-items:flex-start;gap:12px}.simulation-heading h3{font-size:22px!important}.simulation-counter{font-size:10px;padding:5px 7px}.simulation-canvas{padding:18px}.simulation-drawing{height:104px}.simulation-description{font-size:14px!important}.simulation-footer{font-size:10px;line-height:1.6}.simulation-panel h4{font-size:18px}.simulation-panel-top p{font-size:11px!important}}
</style>
