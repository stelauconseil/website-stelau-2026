---
import Icon from '@/components/Icon/Icon.astro';
import type {Locale} from '@/config/site';
import copy from '@/data/audit-cycle.json';
const {lang}=Astro.props as {lang:Locale};
const fr=lang==='fr';
const content=copy[lang];
const icons=['compass','book-open','magnifying-glass','scale-balanced','file-check','clipboard-check'] as const;
const stem=`/media/audits-certification/demarche-audit-${lang}`;
---
<figure class="audit-cycle" data-audit-cycle data-lang={lang} data-phase="6">
 <header><div><p class="eyebrow">ISO 19011 / {fr?'LA DÉMARCHE EN MOUVEMENT':'THE PROCESS IN MOTION'}</p><h3>{content.title}</h3></div><span class="cycle-counter" data-cycle-counter aria-hidden="true">06 / 06</span></header>
 <div class="cycle-scenes" aria-hidden="true" data-pagefind-ignore>
  {content.steps.map((step,i)=><div class="cycle-scene" data-cycle-scene={i+1}><div class="cycle-document"><span class="mono">0{i+1} / {step[0]}</span><Icon name={icons[i]} size={42}/><strong>{step[2]}</strong><div class="cycle-lines">{[0,1,2].map(j=><span style={`--stroke-index:${j}`}><i/>{(fr?['Exigence','Preuve','Constat']:['Requirement','Evidence','Finding'])[j]}</span>)}</div></div><div class="cycle-reading"><span class="cycle-dots"><i/><i/><i/></span><p>{step[3]}</p><strong>{step[4]}</strong><span>{fr?'Comprendre → Vérifier → Documenter':'Understand → Verify → Document'}</span></div></div>)}
 </div>
 <ol class="cycle-steps">{content.steps.map((step,i)=><li><button type="button" data-cycle-select={i+1} aria-label={`${fr?'Étape':'Step'} ${i+1} : ${step[0]}`} aria-current={i===5?'step':undefined}><span>0{i+1}</span><strong>{step[0]}</strong></button><p>{step[1]}</p></li>)}</ol>
 <figcaption><p>{content.caption}</p><div class="cycle-controls"><button type="button" data-cycle-toggle aria-pressed="false">{fr?'Lire l’animation':'Play animation'}</button><button type="button" data-cycle-replay>{fr?'Rejouer':'Replay'}</button><a class="cycle-gif-light" href={stem+'-light.gif'} download>GIF ↓</a><a class="cycle-gif-dark" href={stem+'-dark.gif'} download>GIF ↓</a></div></figcaption>
</figure>
<script>
 document.querySelectorAll<HTMLElement>('[data-audit-cycle]').forEach(el=>{
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const fr=el.dataset.lang==='fr';
  const toggle=el.querySelector<HTMLButtonElement>('[data-cycle-toggle]')!;
  const selectors=el.querySelectorAll<HTMLButtonElement>('[data-cycle-select]');
  let elapsed=reduced.matches?20000:0,previous=0,frame=0,visible=false,playing=false,requested=!reduced.matches;
  function render(){const phase=Math.min(6,Math.floor(elapsed/4000)+1);el.dataset.phase=String(phase);el.querySelector('[data-cycle-counter]')!.textContent=`0${phase} / 06`;selectors.forEach((button,i)=>{if(i+1===phase)button.setAttribute('aria-current','step');else button.removeAttribute('aria-current');});}
  function sync(){el.dataset.playing=String(playing);toggle.setAttribute('aria-pressed',String(playing));toggle.textContent=playing?'Pause':(fr?'Lire l’animation':'Play animation');}
  function stop(){playing=false;cancelAnimationFrame(frame);previous=0;sync();}
  function tick(time:number){if(!playing)return;if(previous)elapsed+=Math.min(time-previous,100);previous=time;if(elapsed>=24000)elapsed=0;render();frame=requestAnimationFrame(tick);}
  function start(){if(playing||!visible||document.hidden)return;playing=true;previous=0;sync();frame=requestAnimationFrame(tick);}
  toggle.addEventListener('click',()=>{requested=!playing;if(requested)start();else stop();});
  el.querySelector('[data-cycle-replay]')!.addEventListener('click',()=>{elapsed=0;render();requested=true;start();});
  selectors.forEach((button,i)=>button.addEventListener('click',()=>{requested=false;stop();elapsed=i*4000;render();}));
  new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(visible&&requested)start();else stop();},{threshold:.15}).observe(el);
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();else if(requested)start();});
  reduced.addEventListener('change',()=>{requested=!reduced.matches;if(reduced.matches){stop();elapsed=20000;render();}else start();});
  render();sync();
 });
</script>
<style>
 .audit-cycle{background:var(--soft);padding:28px;border:1px solid var(--line);border-radius:16px;margin:30px 0 0}.audit-cycle header{display:flex;justify-content:space-between;align-items:center;gap:20px}.audit-cycle header .eyebrow{font-size:11px;margin:0 0 12px}.audit-cycle header h3{font-size:25px;line-height:1.25;margin:0}.cycle-counter{font:12px var(--font-mono);color:var(--brand);white-space:nowrap}
 .cycle-scenes{margin:28px 0}.cycle-scene{display:none;grid-template-columns:.9fr 1.2fr;gap:45px;align-items:center}.audit-cycle[data-phase="1"] [data-cycle-scene="1"],.audit-cycle[data-phase="2"] [data-cycle-scene="2"],.audit-cycle[data-phase="3"] [data-cycle-scene="3"],.audit-cycle[data-phase="4"] [data-cycle-scene="4"],.audit-cycle[data-phase="5"] [data-cycle-scene="5"],.audit-cycle[data-phase="6"] [data-cycle-scene="6"]{display:grid}
 .cycle-document{padding:22px;background:var(--surface);border:1px solid var(--line);border-radius:12px;display:grid;grid-template-columns:1fr auto;gap:14px 12px}.cycle-document>.mono{font-size:11px;color:var(--muted)}.cycle-document>:global(.fa-icon){grid-column:2;grid-row:1/3;align-self:center}.cycle-document>strong{font-size:19px;line-height:1.4}.cycle-lines{grid-column:1/-1;display:grid;gap:10px;border-top:1px solid var(--line);padding-top:18px}.cycle-lines span{display:flex;align-items:center;gap:14px;font:11px var(--font-mono);color:var(--muted)}.cycle-lines i{height:5px;width:calc(82px - var(--stroke-index)*12px);border-radius:3px;background:var(--brand);opacity:.4}.cycle-reading{display:flex;flex-direction:column;align-items:start;gap:12px}.cycle-reading p{font:12px var(--font-mono)!important;color:var(--muted);margin:0!important}.cycle-reading>strong{font-size:clamp(23px,2.5vw,32px);letter-spacing:-.03em;line-height:1.3}.cycle-reading>span:last-child{font-size:13px;color:var(--muted)}.cycle-dots{display:flex;gap:9px}.cycle-dots i{width:6px;height:6px;background:var(--brand);border-radius:50%;opacity:.4}.audit-cycle[data-playing="true"] .cycle-dots i{animation:cycle-pulse 1.8s infinite}.cycle-dots i:nth-child(2){animation-delay:.3s}.cycle-dots i:nth-child(3){animation-delay:.6s}@keyframes cycle-pulse{50%{opacity:1;transform:translateY(-3px)}}
 .cycle-steps{list-style:none;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px;padding:0;margin:28px 0}.cycle-steps li{min-width:0}.cycle-steps button{display:flex;align-items:center;gap:8px;width:100%;text-align:left;padding:14px 0 8px;border:0;border-top:2px solid var(--line);background:none;color:var(--ink)}.cycle-steps button[aria-current]{border-color:var(--brand);color:var(--brand)}.cycle-steps button:hover{color:var(--brand)}.cycle-steps button span{font:10px var(--font-mono);color:var(--muted)}.cycle-steps button strong{font-size:14px}.cycle-steps p{font-size:12px!important;line-height:1.7!important;margin:6px 0 0}
 .audit-cycle figcaption{border-top:1px solid var(--line);padding-top:20px;display:flex;align-items:center;justify-content:space-between;gap:25px}.audit-cycle figcaption p{font-size:12px!important;line-height:1.8!important;max-width:640px;margin:0}.cycle-controls{display:flex;gap:8px;flex-wrap:wrap;flex-shrink:0}.cycle-controls button,.cycle-controls a{font-size:12px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:6px;padding:9px 12px}.cycle-controls button:hover,.cycle-controls a:hover{border-color:var(--brand)}.cycle-gif-dark{display:none}:global(.dark) .cycle-gif-dark{display:inline-block}:global(.dark) .cycle-gif-light{display:none}
 @media(max-width:1000px){.cycle-steps{grid-template-columns:repeat(3,minmax(0,1fr))}.audit-cycle figcaption{flex-direction:column;align-items:start}.cycle-scene{gap:25px}}
 @media(max-width:600px){.audit-cycle{padding:20px}.audit-cycle header{align-items:start}.audit-cycle header h3{font-size:23px}.cycle-counter{font-size:10px;margin-top:3px}.cycle-scene{grid-template-columns:1fr;gap:24px}.cycle-document{padding:20px}.cycle-reading>strong{font-size:25px}.cycle-reading p{font-size:11px!important}.cycle-reading>span:last-child{font-size:11px}.cycle-steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px}.cycle-steps button strong{font-size:14px}.cycle-controls{gap:7px}.cycle-controls button,.cycle-controls a{font-size:11px;padding:9px 10px}}
 @media(prefers-reduced-motion:reduce){.cycle-dots i{animation:none!important}}
</style>
