---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import Icon from '@/components/Icon/Icon.astro';
import type {IconName} from '@/data/icons';
interface Props { image?:ImageMetadata; alt?:string; icon?:IconName; label?:string; }
const {image,alt='',icon='images',label=''}=Astro.props;
---
<div class:list={['expertise-thumbnail',{'expertise-thumbnail-placeholder':!image}]}>
  {image?<Image src={image} alt={alt} widths={[240,480,720]} sizes="(min-width: 900px) 240px, 160px" width={480} format="webp"/>:<div class="thumbnail-placeholder" aria-hidden="true"><Icon name={icon} size={38}/><span>{label}</span><i></i><i></i></div>}
</div>
<style>
  .expertise-thumbnail{width:100%;aspect-ratio:4/3;position:relative;overflow:hidden;border-radius:12px;border:1px solid var(--line);background:var(--soft);box-shadow:0 5px 16px #21252908}
  .expertise-thumbnail :global(img){display:block;width:100%;height:100%;object-fit:cover}
  .thumbnail-placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:radial-gradient(circle at 1px 1px,var(--line) 1px,transparent 0) 0 0/14px 14px;padding:12px}
  .thumbnail-placeholder span{font-family:var(--font-mono);font-size:10px;line-height:1.5;white-space:nowrap;text-align:center;letter-spacing:.04em;color:var(--muted);background:var(--soft);padding:0 5px;border-radius:4px}
  .thumbnail-placeholder i{display:block;height:3px;width:45%;background:var(--line);border-radius:10px}.thumbnail-placeholder i:last-child{width:30%}
</style>
