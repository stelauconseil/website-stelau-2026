---
import Icon from '@/components/Icon/Icon.astro';
import {expertiseIcons} from '@/data/icons';
import Arrow from '@/components/Arrow.astro';import {href,cyberInsuranceHref,walletExpertiseHref,vdsVerifyHref,type Locale} from '@/config/site';import {expertises} from '@/data/expertises';import {Image} from 'astro:assets';import codeReview from '@/assets/images/code-review.jpeg';
const {lang,slug}=Astro.props as {lang:Locale;slug:string};const fr=lang==='fr';const item=expertises.find(e=>e.slug===slug)!;const e=item[lang];
---
<div class="container page-intro"><a class="back-link" href={href(lang,'expertise')}>← {fr?'Toutes nos expertises':'All expertise'}</a><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name={expertiseIcons[slug]} size={22}/></span>/{item.number} · {e.tag}</p><h1>{e.title}<br/><em>{e.verb}</em></h1><p class="lead">{e.description}</p></div><section class="container detail-grid section-space"><div><h2>{fr?'Une expertise qui se traduit en actions.':'Expertise you can put to work.'}</h2><p>{e.body}</p><h3 class="icon-heading"><Icon name="clipboard-check" size={24}/>{fr?'Ce que nous vous apportons':'What we deliver'}</h3><ul class="deliverables">{e.deliverables.map(d=><li><Icon name="check" size={20}/><span>{d}</span></li>)}</ul>{slug==='conseil'&&<aside class="insurance-callout"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="file-check" size={22}/></span>IXI-Plus / {fr?'Expertise pour l’assurance':'Expertise for insurance'}</p><h3>{fr?'De l’attaque aux faits établis.':'From an attack to established facts.'}</h3><p>{fr?'Nos experts analysent la matérialité des attaques, leurs mécanismes et leur lien causal éventuel avec un sinistre. Une pratique professionnelle guidée par la rigueur et la manifestation de la vérité.':'Our experts examine evidence of attacks, their mechanisms and any causal link to an insured loss. A professional practice guided by rigour and a commitment to establishing the truth.'}</p><a class="text-link" href={cyberInsuranceHref(lang)}>{fr?'Découvrir notre démarche':'Explore our approach'}<Arrow /></a></aside>}{slug==='developpement'&&<aside class="insurance-callout"><p class="eyebrow icon-eyebrow"><Icon name="wallet" size={24}/>{fr?'Wallets et identité numérique':'Wallets and digital identity'}</p><h3>{fr?'Du protocole aux essais croisés.':'From protocols to cross-testing.'}</h3><p>{fr?'Émetteurs, wallets et vérificateurs : une expertise de développement ancrée dans les standards et l’interopérabilité réelle.':'Issuers, wallets and verifiers: development expertise grounded in standards and real interoperability.'}</p><a class="text-link" href={walletExpertiseHref(lang)}>{fr?'Découvrir cette expertise':'Explore this expertise'}<Arrow/></a></aside>}<a class="button" href={href(lang,'contact')}>{fr?'Parlons de vos enjeux':'Let’s discuss your needs'}<Arrow /></a></div><Image src={codeReview} alt={fr?'Une revue de code en équipe.':'A team code review.'} width={900} format="webp"/></section>

{slug==='developpement'&&<section class="container" style="padding-bottom:70px"><a class="insurance-feature" href={vdsVerifyHref(lang)}><div><p class="eyebrow icon-eyebrow"><Icon name="file-check" size={24}/>VDS Verify / 2D-DOC / CEV</p><h2>{fr?'La preuve dans le code.':'The proof in the code.'}</h2><p>{fr?'Des documents signés aux cachets électroniques visibles : découvrez notre vérifieur, ses intégrations dans France Identité et le travail d’experts derrière la lecture d’un code.':'From signed documents to visible digital seals: explore our verifier, its integrations into France Identité and the expert engineering behind reading a code.'}</p><span class="text-link">{fr?'Découvrir VDS Verify':'Explore VDS Verify'}<Arrow/></span></div><Arrow/></a></section>}
