---
import Icon from '@/components/Icon/Icon.astro';
import {expertiseIcons} from '@/data/icons';
import Arrow from '@/components/Arrow.astro';import {href,cyberInsuranceHref,type Locale} from '@/config/site';import {expertises} from '@/data/expertises';import {Image} from 'astro:assets';import codeReview from '@/assets/images/code-review.jpeg';
const {lang,slug}=Astro.props as {lang:Locale;slug:string};const fr=lang==='fr';const item=expertises.find(e=>e.slug===slug)!;const e=item[lang];
---
<div class="container page-intro"><a class="back-link" href={href(lang,'expertise')}>← {fr?'Toutes nos expertises':'All expertise'}</a><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name={expertiseIcons[slug]} size={22}/></span>/{item.number} · {e.tag}</p><h1>{e.title}<br/><em>{e.verb}</em></h1><p class="lead">{e.description}</p></div><section class="container detail-grid section-space"><div><h2>{fr?'Une expertise qui se traduit en actions.':'Expertise you can put to work.'}</h2><p>{e.body}</p><h3 class="icon-heading"><Icon name="clipboard-check" size={24}/>{fr?'Ce que nous vous apportons':'What we deliver'}</h3><ul class="deliverables">{e.deliverables.map(d=><li><Icon name="check" size={20}/><span>{d}</span></li>)}</ul>{slug==='conseil'&&<aside class="insurance-callout"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="file-check" size={22}/></span>IXI-Plus / {fr?'Expertise pour l’assurance':'Expertise for insurance'}</p><h3>{fr?'De l’attaque aux faits établis.':'From an attack to established facts.'}</h3><p>{fr?'Nos experts analysent la matérialité des attaques, leurs mécanismes et leur lien causal éventuel avec un sinistre. Une pratique professionnelle guidée par la rigueur et la manifestation de la vérité.':'Our experts examine evidence of attacks, their mechanisms and any causal link to an insured loss. A professional practice guided by rigour and a commitment to establishing the truth.'}</p><a class="text-link" href={cyberInsuranceHref(lang)}>{fr?'Découvrir notre démarche':'Explore our approach'}<Arrow /></a></aside>}<a class="button" href={href(lang,'contact')}>{fr?'Parlons de vos enjeux':'Let’s discuss your needs'}<Arrow /></a></div><Image src={codeReview} alt={fr?'Une revue de code en équipe.':'A team code review.'} width={900} format="webp"/></section>
