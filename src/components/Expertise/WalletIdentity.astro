---
import {Image} from 'astro:assets';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import WalletFieldGallery from './WalletFieldGallery.astro';
import {href,type Locale} from '@/config/site';
import type {IconName} from '@/data/icons';
import community from '@/assets/images/wallets-geneve/communaute-identite-numerique-geneve-2026.jpg';
const {lang} = Astro.props as {lang:Locale};
const fr = lang==='fr';
const stages: {icon:IconName;title:string;description:string}[] = fr ? [
  {icon:'id-card',title:'Émettre.',description:'Concevoir et intégrer les services d’émission d’attestations : une identité, un droit ou une preuve d’âge, avec une origine vérifiable.'},
  {icon:'wallet',title:'Présenter.',description:'Relier le wallet aux usages réels, en proximité ou en ligne. Préciser les données demandées et rendre le parcours compréhensible.'},
  {icon:'clipboard-check',title:'Vérifier.',description:'Implémenter les lecteurs et les vérificateurs, examiner les preuves cryptographiques et les conditions de confiance.'},
  {icon:'share-nodes',title:'Interopérer.',description:'Confronter les implémentations, analyser les écarts et faire progresser le code à partir d’essais documentés.'}
] : [
  {icon:'id-card',title:'Issue.',description:'Design and integrate credential issuance services: an identity, an entitlement or proof of age, with a verifiable origin.'},
  {icon:'wallet',title:'Present.',description:'Connect the wallet to real uses, in person or online. Specify the requested data and make the user journey understandable.'},
  {icon:'clipboard-check',title:'Verify.',description:'Implement readers and verifiers, examine cryptographic proofs and assess the conditions for trust.'},
  {icon:'share-nodes',title:'Interoperate.',description:'Compare implementations, investigate differences and improve the code through documented testing.'}
];
const protocols = [
  {label:'OpenID4VCI',text:fr?'Émission d’attestations vers un wallet.':'Issuing credentials to a wallet.',url:'https://openid.net/specs/openid-4-verifiable-credential-issuance-1_0.html'},
  {label:'OpenID4VP',text:fr?'Demande et présentation d’attestations.':'Requesting and presenting credentials.',url:'https://openid.net/specs/openid-4-verifiable-presentations-1_0.html'},
  {label:'ISO/IEC 18013-5',text:fr?'Documents mobiles et vérification en proximité.':'Mobile documents and proximity verification.',url:'https://www.iso.org/standard/69084.html'},
  {label:'ISO/IEC TS 18013-7',text:fr?'Présentation de documents mobiles à distance.':'Remote presentation of mobile documents.',url:'https://www.iso.org/standard/91154.html'}
];
---
<div class="container page-intro wallet-intro">
  <a class="back-link" href={href(lang,'expertise')}>← {fr?'Toutes nos expertises':'All expertise'}</a>
  <p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="wallet" size={24}/></span>{fr?'Wallets / Identité numérique / Interopérabilité':'Wallets / Digital identity / Interoperability'}</p>
  <h1>{fr?'De la norme':'From standards'}<br/><em>{fr?'à la confiance en pratique.':'to trust in practice.'}</em></h1>
  <p class="lead">{fr?'Un wallet prend tout son sens lorsqu’il fonctionne avec les autres. Nos experts relient les standards, la cryptographie et le développement pour construire des parcours d’identité numérique qui tiennent dans la réalité.':'A wallet fulfils its purpose when it works with others. Our experts connect standards, cryptography and development to build digital identity journeys that work in practice.'}</p>
  <div class="wallet-actions"><a class="button" href={href(lang,'contact')}>{fr?'Parlons de votre projet':'Let’s discuss your project'}<Arrow/></a><a class="text-link" href="#terrain">{fr?'Nous voir sur le terrain':'See us in the field'}<Arrow/></a></div>
</div>
<section class="container wallet-section" aria-labelledby="wallet-chain">
  <p class="eyebrow">01 / {fr?'Une chaîne de confiance':'A chain of trust'}</p>
  <h2 id="wallet-chain">{fr?'Quatre gestes. Un même niveau d’exigence.':'Four steps. The same commitment to rigour.'}</h2>
  <div class="wallet-stages">{stages.map((stage,i)=><article><div class="wallet-stage-top"><span class="mono">0{i+1}</span><Icon name={stage.icon} size={36}/></div><h3>{stage.title}</h3><p>{stage.description}</p></article>)}</div>
</section>
<section class="container wallet-section" aria-labelledby="wallet-protocols">
  <div class="wallet-split"><div><p class="eyebrow">02 / {fr?'Des experts qui codent':'Experts who code'}</p><h2 id="wallet-protocols">{fr?'Lire les spécifications.':'Read the specifications.'}<br/><em>{fr?'Éprouver les implémentations.':'Test the implementations.'}</em></h2><p>{fr?'Les protocoles ne sont pas interchangeables : émission, présentation et vérification répondent à des besoins distincts. Nous les articulons avec l’architecture de votre service, vos usages et vos exigences de sécurité.':'Protocols serve different purposes: issuance, presentation and verification address distinct needs. We align them with your service architecture, use cases and security requirements.'}</p><p>{fr?'Notre pratique va de l’analyse des flux à l’implémentation, puis aux essais croisés. Le périmètre, les versions et les profils retenus doivent être explicites : un test réussi renseigne un scénario précis, sans valoir à lui seul certification.':'Our practice spans flow analysis, implementation and cross-testing. Scope, versions and selected profiles must be explicit: a successful test demonstrates a specific scenario and does not, on its own, constitute certification.'}</p></div><div class="wallet-protocols">{protocols.map(p=><a href={p.url} target="_blank" rel="noopener noreferrer"><div><span class="mono">{p.label}</span><p>{p.text}</p></div><Arrow/></a>)}</div></div>
  <a class="text-link wallet-code-link" href={href(lang,'blog')+'mdoc-web-verifier-deep-dive/'}><Icon name="code" size={22}/>{fr?'Dans le code : notre vérificateur mDoc en navigateur':'Inside the code: our browser-based mDoc verifier'}<Arrow/></a>
</section>
<section id="terrain" class="container wallet-section" aria-labelledby="wallet-field">
  <p class="eyebrow icon-eyebrow"><Icon name="globe" size={24}/>03 / {fr?'Sur le terrain, avec l’écosystème':'In the field, with the ecosystem'}</p>
  <div class="wallet-split wallet-field-heading"><h2 id="wallet-field">{fr?'La confiance se construit aussi':'Trust is also built'}<br/><em>{fr?'autour d’une table.':'around a table.'}</em></h2><p>{fr?'À Genève, Nicolas Chalanset et Loïc Perry ont accompagné France Identité pendant une semaine de tests et d’échanges internationaux. Des rencontres qui donnent aux standards une réalité très concrète.':'In Geneva, Nicolas Chalanset and Loïc Perry supported France Identité during a week of international testing and discussions. These meetings give standards a very practical reality.'}</p></div>
  <figure class="wallet-community"><Image src={community} alt={fr?'Des participants de la communauté de l’identité numérique réunis à Genève lors de Global Digital Collaboration 2026.':'Members of the digital identity community gathered in Geneva during Global Digital Collaboration 2026.'} widths={[480,800,1248,1600]} sizes="(min-width: 1360px) 1248px, 92vw" width={1600} format="webp"/><figcaption>Global Digital Collaboration · {fr?'Genève, 1–3 septembre 2026. Photo issue du post de Nicolas Chalanset.':'Geneva, 1–3 September 2026. Photograph from Nicolas Chalanset’s post.'}</figcaption></figure>
  <div class="wallet-split"><div><h3 class="icon-heading"><Icon name="share-nodes" size={28}/>{fr?'Des essais croisés, des résultats concrets.':'Cross-testing, practical results.'}</h3><p>{fr?'Le 15e événement international d’interopérabilité ISO mdoc et PhotoID a permis de confronter le wallet et le vérificateur de proximité France Identité, ainsi que notre vérificateur en ligne ISO 18013-7, à d’autres implémentations.':'The 15th international ISO mdoc and PhotoID interoperability event enabled cross-testing of the France Identité wallet and proximity verifier, alongside our ISO 18013-7 online verifier, with other implementations.'}</p></div><div><h3 class="icon-heading"><Icon name="wallet" size={28}/>{fr?'De France Identité à Google Wallet.':'From France Identité to Google Wallet.'}</h3><p>{fr?'L’import réussi d’une attestation d’âge France Identité dans Google Wallet a concrétisé plusieurs mois de travail avec l’équipe Google Wallet, grâce à notre technologie d’émission OpenID4VCI.':'The successful import of a France Identité age credential into Google Wallet brought several months of work with the Google Wallet team to fruition, using our OpenID4VCI issuance technology.'}</p></div></div>
  <WalletFieldGallery lang={lang}/>
  <a class="text-link" href={href(lang,'blog')+'geneve-2026-wallets-interoperabilite/'}>{fr?'Lire le retour d’expérience de Genève':'Read our Geneva field report'}<Arrow/></a>
</section>
<section class="container wallet-section" aria-labelledby="wallet-collective"><div class="wallet-collective"><Icon name="users" size={40}/><div><p class="eyebrow">04 / {fr?'Le sens du collectif':'A shared purpose'}</p><h2 id="wallet-collective">{fr?'Des standards ouverts. Des échanges utiles.':'Open standards. Useful conversations.'}</h2><p>{fr?'Nicolas a participé à la première réunion en présentiel du groupe DCHP de l’OpenID Foundation. Ce groupe travaille à harmoniser les protocoles de présentation d’attestations entre les écosystèmes ISO et OpenID. Nous nourrissons notre pratique de ces échanges entre ingénieurs et contributeurs.':'Nicolas took part in the first in-person meeting of the OpenID Foundation’s DCHP working group. It works to harmonise credential presentation protocols across the ISO and OpenID ecosystems. These exchanges between engineers and contributors inform our practice.'}</p><a class="text-link" href="https://openid.net/wg/digital-credentials-harmonized-presentation-working-group/" target="_blank" rel="noopener noreferrer">{fr?'Découvrir le groupe DCHP':'Explore the DCHP working group'}<Arrow/></a></div></div></section>
<section class="container wallet-section wallet-close"><p class="eyebrow">{fr?'Votre prochain projet':'Your next project'}</p><h2>{fr?'Un wallet, un émetteur, un vérificateur ?':'A wallet, an issuer, a verifier?'}</h2><p>{fr?'Commençons par vos usages, les parties prenantes et les preuves attendues. Puis construisons une trajectoire claire, du cadrage aux essais d’interopérabilité.':'Let’s start with your use cases, stakeholders and required evidence. Then build a clear path from scoping to interoperability testing.'}</p><a class="button" href={href(lang,'contact')}>{fr?'Échangeons avec nos experts':'Talk to our experts'}<Arrow/></a></section>
<style>
  .wallet-intro .lead{max-width:900px}.wallet-actions{display:flex;gap:28px;align-items:center;flex-wrap:wrap;margin-top:30px}
  .wallet-section{padding-top:48px;padding-bottom:48px;scroll-margin-top:32px}.wallet-section h2{font-size:clamp(29px,3.5vw,46px);line-height:1.2;margin:16px 0 28px;letter-spacing:-.04em}.wallet-section h3{font-size:25px;line-height:1.3;margin:14px 0 20px}.wallet-section p:not(.eyebrow){font-size:17px;line-height:1.85}
  .wallet-stages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.wallet-stages article{padding:26px 22px;background:var(--surface);border:1px solid var(--line);border-radius:12px}.wallet-stage-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:30px}.wallet-stage-top .mono{color:var(--muted);font-size:13px}.wallet-stages article h3{font-size:30px}.wallet-stages article p{font-size:16px!important}
  .wallet-split{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:start}.wallet-protocols{border-top:1px solid var(--line);margin-top:16px}.wallet-protocols a{display:flex;justify-content:space-between;gap:22px;align-items:center;padding:24px 0;border-bottom:1px solid var(--line)}.wallet-protocols a:hover .mono{color:var(--brand)}.wallet-protocols .mono{font-size:18px;font-weight:600}.wallet-protocols p{font-size:15px!important;margin:8px 0 0}.wallet-protocols :global(.arrow){width:22px;flex-shrink:0;color:var(--brand)}.wallet-code-link{margin-top:30px}
  .wallet-field-heading{align-items:center}.wallet-community{margin:24px 0 44px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface)}.wallet-community :global(img){width:100%;height:auto;display:block}.wallet-community figcaption{padding:18px 22px;font-size:13px;line-height:1.7;color:var(--muted)}
  .wallet-collective{display:flex;gap:28px;padding:38px;border:1px solid var(--line);border-radius:12px;background:var(--soft)}.wallet-collective> :global(.fa-icon){margin-top:7px}.wallet-collective h2{font-size:clamp(28px,3vw,38px)}.wallet-close{padding-bottom:90px}.wallet-close p:not(.eyebrow){max-width:740px}.wallet-close .button{margin-top:18px}
  @media(max-width:1000px){.wallet-stages{grid-template-columns:repeat(2,minmax(0,1fr))}.wallet-split{gap:32px}}
  @media(max-width:720px){.wallet-section{padding-top:30px;padding-bottom:30px}.wallet-split{grid-template-columns:1fr;gap:20px}.wallet-collective{padding:24px;gap:18px}.wallet-collective> :global(.fa-icon){width:28px;height:28px}.wallet-section p:not(.eyebrow){font-size:16px}.wallet-close{padding-bottom:65px}}
  @media(max-width:450px){.wallet-stages{grid-template-columns:1fr}.wallet-stage-top{margin-bottom:12px}.wallet-collective{flex-direction:column}.wallet-actions{gap:20px}.wallet-code-link{align-items:start;line-height:1.6}}
</style>
