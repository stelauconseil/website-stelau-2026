---
import Icon from '@/components/Icon/Icon.astro';
import type {Locale} from '@/config/site';
import simulations from '@/data/vds-simulations.json';
const {lang,kind}=Astro.props as {lang:Locale;kind:'integrity'|'paper'};
const fr=lang==='fr';
const content=simulations[kind][lang];
const stem=`/media/vds-verify/${kind}-${lang}`;
// Deliberately decorative, not an encodable/scannable seal.
const cells=(changed:boolean)=>Array.from({length:144},(_,i)=>({x:i%12,y:Math.floor(i/12)})).filter(({x,y})=>(x*7+y*11+x*y+(changed?1:0))%5<2);
---
<figure class="proof" data-vds-proof data-lang={lang} data-stage="4">
 <div class="proof-header"><div><p class="eyebrow">STELAU / {fr?'LA PREUVE EN MOUVEMENT':'PROOF IN MOTION'}</p><h3>{content.title}</h3></div><span class="proof-counter" data-proof-counter aria-hidden="true">04 / 04</span></div>
 <p class="proof-fiction">{fr?'Simulation pédagogique · données fictives · code non scannable':'Educational simulation · fictional data · non-scannable code'}</p>
 <div class="proof-scenes" aria-hidden="true" data-pagefind-ignore>
  {content.steps.map((step,i)=><div class="proof-scene" data-scene={i+1}>
   <div class="proof-document"><span class="proof-doc-label">{step[3]}</span><span class="proof-field">{fr?'NOM':'NAME'}</span><strong class:list={['proof-name',{'proof-changed':kind==='integrity'&&i>1}]}>{step[2]}</strong><span class="proof-field">2D-DOC / CEV</span><svg viewBox="0 0 120 120" class="proof-seal">{cells(kind==='integrity'&&i>1).map(({x,y})=><rect x={x*10+1} y={y*10+1} width="8" height="8"/>)}</svg><span class="proof-fingerprint">signature / 7b9e…42af</span></div>
   <div class="proof-transfer"><span class="proof-transfer-label">{kind==='integrity'&&i>1?(fr?'Une donnée change':'One field changes'):(fr?'Données + signature':'Data + signature')}</span><span class="proof-wire"><i/><i/><i/></span><span class="proof-transfer-label">{kind==='paper'?(fr?'Écran → papier → lecture':'Screen → paper → scan'):(fr?'L’empreinte est recalculée':'The digest is recomputed')}</span></div>
   <div class:list={['proof-result',{'proof-failure':kind==='integrity'&&i===3,'proof-question':(kind==='paper'&&i===3)||(kind==='integrity'&&i===2)}]}><span class="proof-doc-label">{step[4]}</span><Icon name={i===3?(kind==='integrity'?'xmark':'question'):(kind==='integrity'&&i===2?'question':'file-check')} size={52}/><strong>{step[5]}</strong><span>{kind==='paper'&&i===3?(fr?'Signature ≠ lien au détenteur':'Signature ≠ holder binding'):(kind==='integrity'&&i>1?(fr?'Données : différentes / Signature : identique':'Data: different / Signature: unchanged'):(fr?'Intégrité des données signées':'Integrity of signed data'))}</span></div>
  </div>)}
 </div>
 <ol class="proof-steps">{content.steps.map((step,i)=><li><span class="proof-step-number">0{i+1}</span><div><strong>{step[0]}</strong><p>{step[1]}</p></div></li>)}</ol>
 <figcaption><p>{content.caption}</p><div class="proof-controls"><button type="button" data-proof-toggle aria-pressed="false">{fr?'Lire l’animation':'Play animation'}</button><button type="button" data-proof-replay>{fr?'Rejouer':'Replay'}</button><a class="proof-gif-light" href={stem+'-light.gif'} download>GIF ↓</a><a class="proof-gif-dark" href={stem+'-dark.gif'} download>GIF ↓</a></div></figcaption>
</figure>
<script>
 document.querySelectorAll<HTMLElement>('[data-vds-proof]').forEach(el=>{
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const toggle=el.querySelector<HTMLButtonElement>('[data-proof-toggle]')!;
  const fr=el.dataset.lang==='fr';
  let elapsed=0,previous=0,frame=0,visible=false,requested=!reduced.matches,playing=false;
  function render(){const stage=Math.min(4,Math.floor(elapsed/3800)+1);el.dataset.stage=String(stage);el.querySelector('[data-proof-counter]')!.textContent=`0${stage} / 04`;}
  function sync(){el.dataset.playing=String(playing);toggle.setAttribute('aria-pressed',String(playing));toggle.textContent=playing?'Pause':(fr?'Lire l’animation':'Play animation');}
  function stop(){playing=false;cancelAnimationFrame(frame);previous=0;sync();}
  function tick(time:number){if(!playing)return;if(previous)elapsed+=Math.min(time-previous,100);previous=time;if(elapsed>=16000)elapsed=0;render();frame=requestAnimationFrame(tick);}
  function start(){if(playing||!visible||document.hidden)return;playing=true;previous=0;sync();frame=requestAnimationFrame(tick);}
  toggle.addEventListener('click',()=>{requested=!playing;if(requested)start();else stop();});
  el.querySelector('[data-proof-replay]')!.addEventListener('click',()=>{elapsed=0;render();requested=true;start();});
  new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(visible&&requested)start();else stop();},{threshold:.15}).observe(el);
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();else if(requested)start();});
  reduced.addEventListener('change',()=>{requested=!reduced.matches;if(reduced.matches){stop();elapsed=11400;render();}else start();});
  elapsed=reduced.matches?11400:0;render();sync();
 });
</script>
<style>
 .proof{margin:32px 0 0;padding:28px;border:1px solid var(--line);border-radius:16px;background:var(--soft)}
 .proof-header{display:flex;align-items:center;justify-content:space-between;gap:20px}.proof-header .eyebrow{font-size:11px;margin:0 0 9px}.proof-header h3{font-size:25px;line-height:1.3;margin:0;letter-spacing:-.035em}.proof-counter{font:13px var(--font-mono);white-space:nowrap;color:var(--brand)}.proof-fiction{font-size:12px!important;color:var(--muted);margin:12px 0 26px}
 .proof-scene{display:none;grid-template-columns:1fr .9fr 1fr;align-items:center;gap:24px;min-height:285px}.proof[data-stage="1"] [data-scene="1"],.proof[data-stage="2"] [data-scene="2"],.proof[data-stage="3"] [data-scene="3"],.proof[data-stage="4"] [data-scene="4"]{display:grid}
 .proof-document,.proof-result{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:24px;min-height:275px;display:flex;flex-direction:column;align-items:start}.proof-doc-label{font:12px var(--font-mono);color:var(--muted);margin-bottom:22px}.proof-field{font:10px var(--font-mono);color:var(--muted);letter-spacing:.08em}.proof-name{font:600 25px var(--font-mono);margin:5px 0 17px}.proof-changed{color:var(--proof-warning)}.proof-seal{width:76px;height:76px;fill:var(--brand);margin:8px 0}.proof-fingerprint{font:10px var(--font-mono);color:var(--muted)}
 .proof-result{align-items:center;justify-content:center;text-align:center;gap:15px}.proof-result .proof-doc-label{margin:0 0 6px}.proof-result strong{font-size:21px;line-height:1.35}.proof-result>span:last-child{font-size:12px;line-height:1.6;color:var(--muted);max-width:230px}.proof-failure,.proof-question{border-color:var(--proof-warning)}.proof-failure :global(.fa-icon),.proof-question :global(.fa-icon){--fa-primary-color:var(--proof-warning)}
 .proof{--proof-warning:#965118}:global(.dark) .proof{--proof-warning:#ffba80}
 .proof-transfer{text-align:center}.proof-transfer-label{display:block;font:11px var(--font-mono);color:var(--muted);line-height:1.65}.proof-wire{height:2px;background:var(--line);display:block;position:relative;margin:25px 0}.proof-wire i{position:absolute;top:-3px;left:0;width:8px;height:8px;border-radius:50%;background:var(--brand)}.proof[data-playing="true"] .proof-wire i{animation:packet 2.4s linear infinite}.proof-wire i:nth-child(2){animation-delay:.8s}.proof-wire i:nth-child(3){animation-delay:1.6s}@keyframes packet{from{left:0;opacity:0}20%{opacity:1}80%{opacity:1}to{left:100%;opacity:0}}
 .proof-steps{padding:0;margin:28px 0 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;list-style:none}.proof-steps li{padding-top:16px;border-top:2px solid var(--line);display:flex;align-items:start;gap:10px}.proof-step-number{font:11px var(--font-mono);color:var(--muted);margin-top:4px}.proof-steps strong{font-size:15px}.proof-steps p{font-size:13px!important;line-height:1.7!important;margin:7px 0 0}.proof[data-stage="1"] .proof-steps li:nth-child(1),.proof[data-stage="2"] .proof-steps li:nth-child(2),.proof[data-stage="3"] .proof-steps li:nth-child(3),.proof[data-stage="4"] .proof-steps li:nth-child(4){border-color:var(--brand)}
 .proof figcaption{display:flex;align-items:center;justify-content:space-between;gap:25px;border-top:1px solid var(--line);margin-top:26px;padding-top:20px}.proof figcaption p{max-width:660px;font-size:13px!important;margin:0;line-height:1.7!important}.proof-controls{display:flex;gap:9px;flex-wrap:wrap;flex-shrink:0;justify-content:end}.proof-controls button,.proof-controls a{padding:8px 11px;font-size:12px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink)}.proof-controls button:hover,.proof-controls a:hover{border-color:var(--brand);color:var(--brand)}.proof-gif-dark{display:none}:global(.dark) .proof-gif-dark{display:inline-block}:global(.dark) .proof-gif-light{display:none}
 @media(max-width:900px){.proof-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.proof figcaption{align-items:start;flex-direction:column}.proof-scene{gap:14px;grid-template-columns:1fr .65fr 1fr}}
 @media(max-width:600px){.proof{padding:20px}.proof-header h3{font-size:22px}.proof-scene{grid-template-columns:1fr 1fr;gap:10px;min-height:240px}.proof-transfer{display:none}.proof-document,.proof-result{padding:15px 10px;min-height:230px}.proof-doc-label{font-size:10px}.proof-name{font-size:19px}.proof-result strong{font-size:17px}.proof-result>span:last-child{font-size:11px}.proof-fingerprint{font-size:8px}.proof-steps{gap:14px}.proof-steps li{display:block}.proof-step-number{display:block;margin-bottom:4px}.proof-steps p{font-size:12px!important}.proof-header{gap:10px}.proof-counter{font-size:11px}.proof-controls{justify-content:start}}
 @media(prefers-reduced-motion:reduce){.proof-wire i{animation:none!important}}
</style>
