---
import {expertiseSectionHref} from '@/config/site';
import {Image} from 'astro:assets';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import AuditCycle from './AuditCycle.astro';
import {href,walletExpertiseHref,type Locale} from '@/config/site';
import type {IconName} from '@/data/icons';
import meeting from '@/assets/images/audits-certification/ecoute-reunion-audit.jpg';
import technical from '@/assets/images/audits-certification/auditeur-travail-technique.jpg';
import equipment from '@/assets/images/audits-certification/controle-equipements-illustration-ia.png';
const {lang}=Astro.props as {lang:Locale};
const fr=lang==='fr';
const lsti=fr?'https://www.lsti-certification.fr/fr-FR/Nos-offres-entreprises/Confiance-Numerique/Certification-eIDAS':'https://www.lsti-certification.fr/en/Company-offers/Digital-Trust/eIDAS-certification';
const anssi='https://cyber.gouv.fr/offre-de-service/solutions-certifiees-et-qualifiees/comprendre-levaluation-de-securite/qualification-de-produit-et-services/referentiels-qualification/';
const iso=fr?'https://www.iso.org/fr/standard/19011':'https://www.iso.org/standard/19011';
const principles:{icon:IconName;title:string;lead:string;text:string;question:string}[]=fr?[
 {icon:'compass',title:'Discernement.',lead:'Savoir porter un constat qui engage.',text:'Relever un écart majeur réel exige de relier une exigence précise à des faits vérifiables et d’en apprécier l’impact sur le service. L’auditeur étaye sa proposition de classement selon les règles du dispositif ; LSTI en assure le classement dans son processus de certification.',question:'Quelle exigence ? Quels faits ? Quelle portée ?'},
 {icon:'scale-balanced',title:'Probité.',lead:'Rester intellectuellement honnête.',text:'Écouter ce que l’audité présente et défend, accepter de revoir une hypothèse, comprendre une solution différente de ses propres habitudes. L’évaluation reste attachée à l’esprit et à la lettre de l’exigence, avec impartialité et indépendance.',question:'Que démontre réellement ce qui m’est présenté ?'},
 {icon:'eye',title:'Mobilisation.',lead:'Garder sa curiosité jusqu’au bout.',text:'Cinq jours consécutifs d’audit peuvent être éprouvants. Il faut maintenir son attention, recouper les explications et revenir sur les points ouverts. Les outils soutiennent la traçabilité ; le jugement reste un travail humain, attentif et responsable.',question:'Ai-je assez d’éléments pour conclure ?'}
]:[
 {icon:'compass',title:'Discernment.',lead:'Make findings that carry weight.',text:'Identifying a genuine major nonconformity means connecting a specific requirement to verifiable facts and assessing its impact on the service. The auditor supports a proposed classification under the scheme’s rules; LSTI classifies it within its certification process.',question:'Which requirement? Which facts? What impact?'},
 {icon:'scale-balanced',title:'Integrity.',lead:'Remain intellectually honest.',text:'Listen to what the auditee presents and explains, be willing to revise a hypothesis and understand solutions that differ from your own habits. Assessment stays grounded in the intent and wording of the requirement, with impartiality and independence.',question:'What does the evidence actually demonstrate?'},
 {icon:'eye',title:'Sustained attention.',lead:'Stay curious to the very end.',text:'Five consecutive days of auditing can be demanding. Attention must be sustained, explanations cross-checked and open issues revisited. Tools support traceability; judgement remains attentive, responsible human work.',question:'Do I have enough evidence to conclude?'}
];
const skills:{icon:IconName;title:string;text:string}[]=fr?[
 {icon:'microchip',title:'Comprendre la technique.',text:'PKI, HSM, cryptographie, systèmes et protocoles : connaître les mécanismes aide à examiner ce qu’une mesure de sécurité assure réellement.'},
 {icon:'book-open',title:'Apprendre à auditer.',text:'Étudier les référentiels, préparer les entretiens, recueillir des éléments vérifiables et rédiger des constats précis : la méthode se travaille.'},
 {icon:'users',title:'Progresser avec le collectif.',text:'Formation, partage d’expérience et pratique encadrée nourrissent la progression. L’affectation aux missions tient compte des compétences évaluées et des procédures de l’organisme.'}
]:[
 {icon:'microchip',title:'Understand the technology.',text:'PKI, HSMs, cryptography, systems and protocols: understanding the mechanisms helps assess what a security measure actually achieves.'},
 {icon:'book-open',title:'Learn to audit.',text:'Study frameworks, prepare interviews, gather verifiable evidence and write precise findings: the method takes practice.'},
 {icon:'users',title:'Develop together.',text:'Training, shared experience and supervised practice support development. Assignment to audits considers assessed competence and the certification body’s procedures.'}
];
const frameworks:{icon:IconName;title:string;refs:string[];text:string;links:{label:string;url:string}[]}[]=[
 {icon:'building',title:fr?'Organisation des services de confiance':'Trust service governance',refs:['ETSI EN 319 401'],text:fr?'Gouvernance, risques, pratiques et sécurité de l’exploitation : le socle général des prestataires de services de confiance.':'Governance, risks, practices and operational security: the general baseline for trust service providers.',links:[{label:'ETSI EN 319 401',url:'https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.02.01_60/en_319401v030201p.pdf'}]},
 {icon:'file-check',title:fr?'Certificats et infrastructures PKI':'Certificates and PKI',refs:['ETSI EN 319 411-1','ETSI EN 319 411-2'],text:fr?'Exigences applicables aux prestataires qui délivrent des certificats, dont les exigences propres aux certificats qualifiés de l’Union européenne.':'Requirements for providers issuing certificates, including the specific requirements for EU qualified certificates.',links:[{label:'EN 319 411-1',url:'https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf'},{label:'EN 319 411-2',url:'https://www.etsi.org/deliver/etsi_en/319400_319499/31941102/02.06.01_60/en_31941102v020601p.pdf'}]},
 {icon:'clock',title:fr?'Horodatage':'Time-stamping',refs:['ETSI EN 319 421'],text:fr?'Politique et sécurité des services d’horodatage : examiner les mécanismes, les pratiques et les garanties du service.':'Policy and security for time-stamping services: assess mechanisms, practices and service guarantees.',links:[{label:'ETSI EN 319 421',url:'https://www.etsi.org/deliver/etsi_en/319400_319499/319421/01.03.01_60/en_319421v010301p.pdf'}]},
 {icon:'id-card',title:fr?'Vérification d’identité':'Identity verification',refs:['ETSI TS 119 461','ANSSI / PVID'],text:fr?'L’identity proofing des services de confiance et le référentiel français de vérification d’identité à distance : des cadres dont il faut préciser la portée et l’articulation.':'Identity proofing for trust services and the French remote identity verification framework: their scope and relationship must be made explicit.',links:[{label:'TS 119 461',url:'https://www.etsi.org/deliver/etsi_ts/119400_119499/119461/02.01.01_60/ts_119461v020101p.pdf'},{label:'ANSSI / PVID',url:anssi}]},
 {icon:'server',title:fr?'Audits de sécurité et cloud':'Security audits and cloud',refs:['ANSSI / PASSI','ANSSI / SecNumCloud'],text:fr?'Des référentiels de qualification portant sur les prestataires d’audit et sur les services d’informatique en nuage. Les exigences techniques et organisationnelles se vérifient ensemble.':'Qualification frameworks for audit providers and cloud services. Technical and organisational requirements are assessed together.',links:[{label:'ANSSI',url:anssi}]},
 {icon:'clipboard-check',title:fr?'Cadre français et hygiène':'French framework and cyber hygiene',refs:['RGS','ANSSI / GHI'],text:fr?'Du Référentiel général de sécurité au Guide d’hygiène informatique : une expérience des exigences de confiance et des mesures de sécurité concrètes. Le GHI est un guide de bonnes pratiques.':'From the French RGS security framework to ANSSI’s cyber hygiene guide: experience with trust requirements and practical security controls. GHI is a good-practice guide.',links:[{label:'RGS / ANSSI',url:anssi},{label:fr?'Guide d’hygiène':'Cyber hygiene guide',url:'https://messervices.cyber.gouv.fr/guides/guide-dhygiene-informatique'}]}
];
---
<div class="container page-intro certification-hero">
 <div><a class="back-link" href={expertiseSectionHref(lang,'audit')}>← {fr?'Audits & évaluations':'Audits & assessments'}</a><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="magnifying-glass" size={24}/></span>LSTI / eIDAS / {fr?'AUDITS DE CERTIFICATION':'CERTIFICATION AUDITS'}</p><h1>{fr?'Auditer.':'Auditing.'}<br/><em>{fr?'Une responsabilité.':'A responsibility.'}</em></h1><p class="lead">{fr?'Depuis plus de dix ans, Stelau accompagne LSTI dans ses audits de certification eIDAS. Nos ingénieurs consultants apprennent à porter un regard exigeant, à comprendre les organisations et à documenter des constats qui engagent.':'For more than ten years, Stelau has supported LSTI in its eIDAS certification audits. Our consulting engineers learn to assess rigorously, understand organisations and document findings that carry real responsibility.'}</p><div class="certification-actions"><a class="button" href="#metier">{fr?'Comprendre le métier':'Understand the profession'}<Arrow/></a><a class="text-link" href="#demarche">{fr?'Voir la démarche en mouvement':'See the process in motion'}<Arrow/></a></div></div>
 <figure class="certification-cover"><Image src={meeting} alt={fr?'Un professionnel travaille sur ordinateur pendant une réunion, photographie d’illustration.':'A professional working on a laptop during a meeting, an illustrative photograph.'} widths={[480,800,1200]} sizes="(max-width: 720px) 90vw, 43vw" width={1200} format="webp" loading="eager"/><span class="certification-image-tag">{fr?'Illustration':'Illustration'}</span><figcaption><Icon name="comments" size={23}/><span>{fr?'Écouter. Comprendre. Vérifier.':'Listen. Understand. Verify.'}</span></figcaption></figure>
</div>
<div class="container certification-strip"><span><Icon name="clock" size={22}/>{fr?'Plus de 10 ans aux côtés de LSTI':'Over 10 years alongside LSTI'}</span><span><Icon name="globe" size={22}/>{fr?'Des missions en France et en Europe':'Assignments in France and Europe'}</span><span><Icon name="book-open" size={22}/>RGS · eIDAS · ANSSI · ETSI</span></div>
<section id="metier" class="container certification-section" aria-labelledby="certification-profession"><p class="eyebrow">01 / {fr?'Un métier qui s’apprend':'A profession to learn'}</p><div class="certification-split"><h2 id="certification-profession">{fr?'Devenir auditeur à 25 ans.':'Becoming an auditor at 25.'}<br/><em>{fr?'Un vrai défi.':'A real challenge.'}</em></h2><div><p>{fr?'La responsabilité d’un auditeur est considérable. Un constat peut peser sur un service de confiance, ses utilisateurs et une décision de certification. Le métier demande une compétence technique solide, une méthode et une maturité dans la relation.':'An auditor’s responsibility is substantial. A finding can affect a trust service, its users and a certification decision. The profession calls for strong technical competence, a sound method and maturity in working with others.'}</p><p>{fr?'Nos jeunes ingénieurs peuvent relever ce défi en se formant, en pratiquant et en développant trois qualités indissociables.':'Our young engineers can meet this challenge through training, practice and the development of three inseparable qualities.'}</p></div></div><div class="certification-principles">{principles.map((p,i)=><article><div class="certification-card-top"><span class="mono">0{i+1}</span><Icon name={p.icon} size={34}/></div><h3>{p.title}</h3><strong>{p.lead}</strong><p>{p.text}</p><span class="certification-question">{p.question}</span></article>)}</div></section>
<section class="container certification-section" aria-labelledby="certification-conformity"><div class="certification-manifesto"><p class="eyebrow">{fr?'LE CŒUR DU TRAVAIL':'THE CORE OF THE WORK'}</p><h2 id="certification-conformity">{fr?'Évaluer la conformité':'Assess conformity'}<br/><em>{fr?'à un référentiel d’exigences.':'against defined requirements.'}</em></h2><p>{fr?'La relation humaine rend cette évaluation possible : une écoute réelle, des questions justes et l’envie de comprendre. L’auditeur revient à l’exigence, recherche les éléments qui l’éclairent et poursuit le sujet jusqu’à pouvoir en rendre compte avec précision, y compris lorsque des limites subsistent.':'Human interaction makes that assessment possible: attentive listening, well-chosen questions and a desire to understand. The auditor returns to the requirement, seeks evidence that clarifies it and pursues the issue until it can be reported accurately, including any remaining limitations.'}</p><div class="certification-proof-chain"><span><Icon name="book-open" size={22}/>{fr?'Une exigence':'A requirement'}</span><Arrow/><span><Icon name="eye" size={22}/>{fr?'Des faits vérifiables':'Verifiable facts'}</span><Arrow/><span><Icon name="file-check" size={22}/>{fr?'Un constat étayé':'A supported finding'}</span></div></div></section>
<section id="formation" class="container certification-section" aria-labelledby="certification-training"><p class="eyebrow">02 / {fr?'Des ingénieurs qui deviennent auditeurs':'Engineers becoming auditors'}</p><div class="certification-split certification-training"><figure class="certification-technical"><Image src={technical} alt={fr?'Un professionnel analyse des informations techniques devant ses écrans, photographie d’illustration.':'A professional analysing technical information on screens, an illustrative photograph.'} widths={[480,800,1200]} sizes="(max-width:720px) 90vw, 44vw" width={1200} format="webp"/><figcaption>{fr?'Illustration / Comprendre les mécanismes pour examiner les preuves.':'Illustration / Understand the mechanisms to examine the evidence.'}</figcaption></figure><div><h2 id="certification-training">{fr?'La technique donne des prises.':'Technology gives us a foothold.'}<br/><em>{fr?'La formation donne une méthode.':'Training gives us a method.'}</em></h2><p>{fr?'Les ingénieurs consultants de Stelau connaissent les systèmes qu’ils examinent. Cette capacité technique les aide à approfondir les parties cybersécurité des audits : protection des clés, contrôle des accès, exploitation, traçabilité ou continuité des services.':'Stelau’s consulting engineers understand the systems they examine. That technical competence helps them investigate cybersecurity aspects of audits: key protection, access control, operations, traceability and service continuity.'}</p><div class="certification-skills">{skills.map(s=><article><Icon name={s.icon} size={25}/><div><h3>{s.title}</h3><p>{s.text}</p></div></article>)}</div></div></div></section>
<section id="demarche" class="container certification-section" aria-labelledby="certification-process"><p class="eyebrow">03 / {fr?'Une démarche structurée':'A structured process'}</p><div class="certification-split"><h2 id="certification-process">{fr?'Tenir le fil de l’exigence.':'Follow the requirement through.'}<br/><em>{fr?'Jusqu’à la restitution.':'Through to the report.'}</em></h2><div><p>{fr?'ISO 19011 fournit des lignes directrices pour la conduite des audits et les compétences des auditeurs. Notre animation en illustre une lecture simple : préparer les investigations, recueillir des éléments, les évaluer et documenter les conclusions.':'ISO 19011 provides guidance on conducting audits and auditor competence. Our animation illustrates a simple reading of that approach: prepare the investigation, gather evidence, assess it and document conclusions.'}</p><a class="text-link" href={iso} target="_blank" rel="noopener noreferrer">ISO 19011:2026<Arrow/></a></div></div><AuditCycle lang={lang}/><aside class="certification-role"><Icon name="scale-balanced" size={26}/><p>{fr?'Dans les missions de certification eIDAS, les auditeurs produisent les constats et le rapport. LSTI assure la revue et la décision de certification. Le statut qualifié du service relève ensuite de l’autorité de supervision compétente.':'For eIDAS certification assignments, auditors produce findings and the report. LSTI conducts the review and makes the certification decision. The service’s qualified status is then a matter for the competent supervisory authority.'} <a href={lsti} target="_blank" rel="noopener noreferrer">{fr?'Le cadre LSTI ↗':'LSTI’s framework ↗'}</a></p></aside></section>
<section id="referentiels" class="container certification-section" aria-labelledby="certification-frameworks"><p class="eyebrow">04 / {fr?'Une pratique qui traverse les référentiels':'Practice across frameworks'}</p><h2 id="certification-frameworks">{fr?'Du RGS aux services eIDAS.':'From RGS to eIDAS services.'}<br/><em>{fr?'La même exigence de compréhension.':'The same commitment to understanding.'}</em></h2><p class="certification-section-lead">{fr?'Notre expérience s’est construite au fil des référentiels français et européens. Le périmètre, les versions et les exigences applicables sont précisés pour chaque mission ; chaque cadre garde sa fonction propre.':'Our experience has grown across French and European frameworks. The scope, versions and applicable requirements are defined for each assignment; each framework serves its own purpose.'}</p><div class="certification-frameworks">{frameworks.map(f=><article><Icon name={f.icon} size={29}/><h3>{f.title}</h3><div class="certification-tags">{f.refs.map(ref=><span>{ref}</span>)}</div><p>{f.text}</p><div class="certification-reference-links">{f.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></article>)}</div></section>
<section id="terrain" class="container certification-section" aria-labelledby="certification-field"><p class="eyebrow icon-eyebrow"><Icon name="globe" size={24}/>05 / {fr?'Sur le terrain, en Europe':'In the field, across Europe'}</p><div class="certification-split"><div><h2 id="certification-field">{fr?'Des organisations exigeantes.':'Demanding organisations.'}<br/><em>{fr?'Des rencontres qui font progresser.':'Encounters that help us grow.'}</em></h2><p>{fr?'Auditer donne accès à des structures dont le niveau d’exigence est élevé. Comprendre leurs pratiques, échanger avec leurs équipes et confronter les explications à la réalité du terrain fait aussi le plaisir de ce métier.':'Auditing brings us into organisations with demanding standards. Understanding their practices, talking with their teams and checking explanations against the reality on site are also part of the profession’s appeal.'}</p><p>{fr?'Nos missions conduisent les ingénieurs de Stelau en France et à l’étranger, notamment en Europe. Les déplacements, les échanges en anglais et la découverte d’organisations différentes enrichissent leur expérience autant que leur regard technique.':'Our assignments take Stelau engineers across France and abroad, particularly in Europe. Travel, discussions in English and encounters with different organisations enrich both their experience and their technical perspective.'}</p><div class="certification-five-days"><span class="mono">{fr?'5 JOURS CONSÉCUTIFS':'5 CONSECUTIVE DAYS'}</span><h3>{fr?'Une mobilisation de chaque instant.':'Attention throughout.'}</h3><p>{fr?'Lorsqu’une mission s’étend sur cinq jours, il faut préserver sa disponibilité intellectuelle : préparer, écouter, noter, vérifier, partager les points ouverts et reprendre les investigations. La durée dépend du périmètre ; l’exigence d’attention, elle, accompagne toute la mission.':'When an assignment runs over five days, mental availability must be sustained: prepare, listen, take notes, verify, share open issues and resume investigations. Duration depends on scope; attentive work is required throughout.'}</p></div></div><figure class="certification-field-image"><Image src={equipment} alt={fr?'Deux professionnels examinent du matériel électronique dans un atelier générique ; scène reconstituée par IA.':'Two professionals examining electronic equipment in a generic workshop; an AI-reconstructed scene.'} widths={[480,800,1200,1448]} sizes="(max-width:720px) 90vw, 44vw" width={1448} format="webp"/><figcaption>{fr?'Illustration IA / Scène d’audit reconstituée.':'AI illustration / Reconstructed audit scene.'}</figcaption><div class="certification-field-caption"><Icon name="globe" size={28}/><span>{fr?'Comprendre une organisation. Vérifier ses pratiques.':'Understand an organisation. Verify its practices.'}</span></div></figure></div><p class="certification-confidentiality">{fr?'La confidentialité des missions nous conduit à utiliser ici des photographies d’illustration et une scène reconstituée. Les photographies prises lors des audits restent des archives professionnelles et ne sont pas publiées sur cette page.':'To preserve assignment confidentiality, this page uses illustrative photographs and a reconstructed scene. Photographs taken during audits remain professional archives and are not published here.'}</p></section>
<section class="container certification-section" aria-labelledby="certification-next"><div class="certification-next"><Icon name="wallet" size={42}/><div><p class="eyebrow">06 / {fr?'Les exigences évoluent':'Requirements evolve'}</p><h2 id="certification-next">eIDAS v2.<br/><em>{fr?'De nouveaux services, de nouvelles preuves.':'New services, new evidence.'}</em></h2><p>{fr?'Le cadre européen s’étend aux attestations électroniques d’attributs. Les Pub-EAA sont délivrées par un organisme public responsable d’une source authentique, ou pour son compte ; les QEAA sont des attestations qualifiées. Leurs cadres respectifs doivent être distingués pour préparer les futures évaluations.':'The European framework extends to electronic attestations of attributes. Pub-EAAs are issued by, or on behalf of, a public sector body responsible for an authentic source; QEAAs are qualified attestations. Their respective frameworks must be distinguished when preparing future assessments.'}</p><p>{fr?'Cette évolution prolonge notre travail : comprendre l’origine des attributs, les mécanismes de preuve et les exigences applicables à leurs émetteurs. La veille et la formation accompagnent le passage des nouveaux textes aux pratiques d’audit.':'This development extends our work: understand the origin of attributes, proof mechanisms and requirements for issuers. Standards monitoring and training connect new texts with auditing practice.'}</p><div class="certification-actions"><a class="text-link" href={walletExpertiseHref(lang)}>{fr?'Notre expertise wallets':'Our wallet expertise'}<Arrow/></a><a class="text-link" href={`https://eur-lex.europa.eu/legal-content/${fr?'FR':'EN'}/TXT/?uri=CELEX:32025R1569`} target="_blank" rel="noopener noreferrer">{fr?'Cadre européen des attestations':'European attestation framework'}<Arrow/></a></div></div></div></section>
<section class="container certification-section certification-close"><p class="eyebrow">{fr?'DES INGÉNIEURS. DES AUDITEURS. DES EXPERTS.':'ENGINEERS. AUDITORS. EXPERTS.'}</p><h2>{fr?'L’envie de comprendre.':'The desire to understand.'}<br/><em>{fr?'La rigueur pour conclure.':'The rigour to conclude.'}</em></h2><p>{fr?'Notre pratique de l’audit se nourrit de la technique et du collectif. Parlons de ce métier, de ses exigences et de la manière dont nos ingénieurs y prennent leur place.':'Our auditing practice draws on technical expertise and teamwork. Let’s talk about this profession, its responsibilities and how our engineers develop within it.'}</p><div class="certification-actions"><a class="button" href={href(lang,'contact')}>{fr?'Échanger avec nos experts':'Talk to our experts'}<Arrow/></a><a class="text-link" href={href(lang,'about')}>{fr?'Rencontrer l’équipe':'Meet the team'}<Arrow/></a></div></section>
<style>
 .certification-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:65px;align-items:center;padding-top:48px;padding-bottom:48px}.certification-hero>div{min-width:0}.certification-hero .eyebrow{font-size:11px;margin-top:30px}.certification-hero h1{font-size:clamp(48px,5.4vw,78px);line-height:1.1;margin:25px 0;letter-spacing:-.045em}.certification-hero .lead{font-size:18px;line-height:1.85;margin:0}.certification-actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:28px}.certification-actions .button{font-size:15px;gap:18px}.certification-actions .text-link{font-size:14px;gap:12px}
 .certification-cover{margin:0;position:relative;padding-bottom:28px}.certification-cover>img{width:100%;height:565px;object-fit:cover;object-position:69% center;border-radius:14px}.certification-image-tag{position:absolute;top:18px;right:18px;background:#ffffffec;color:#212529;font-size:10px;padding:6px 10px;border-radius:5px}.certification-cover figcaption{position:absolute;bottom:0;left:24px;right:24px;padding:19px 22px;display:flex;align-items:center;gap:14px;background:var(--surface);border:1px solid var(--line);border-radius:10px;font-size:14px}
 .certification-strip{display:flex;align-items:center;justify-content:space-between;gap:25px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding-top:25px;padding-bottom:25px}.certification-strip>span{display:flex;gap:12px;align-items:center;font-size:12px;color:var(--muted)}
 .certification-section{padding-top:60px;padding-bottom:35px;scroll-margin-top:32px}.certification-section h2{font-size:clamp(30px,3.5vw,46px);line-height:1.22;letter-spacing:-.04em;margin:18px 0 25px}.certification-section h3{font-size:24px;line-height:1.35;margin:16px 0}.certification-section p:not(.eyebrow){font-size:17px;line-height:1.85;color:var(--muted)}.certification-split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}.certification-split>div>p:first-child{margin-top:18px}.certification-section-lead{max-width:830px}
 .certification-principles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:28px}.certification-principles article{display:flex;flex-direction:column;min-width:0;border:1px solid var(--line);border-radius:12px;background:var(--surface);padding:26px}.certification-card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}.certification-card-top .mono{font-size:11px;color:var(--muted)}.certification-principles h3{font-size:30px;letter-spacing:-.035em;margin:0 0 18px}.certification-principles article>strong{font-size:16px;line-height:1.65;font-weight:550}.certification-principles p{font-size:15px!important;line-height:1.85!important;margin:18px 0 25px}.certification-question{font-size:12px;line-height:1.7;color:var(--brand);padding-top:18px;border-top:1px solid var(--line);margin-top:auto}
 .certification-manifesto{background:var(--soft);border:1px solid var(--line);border-radius:16px;padding:42px 46px}.certification-manifesto h2{font-size:clamp(34px,4.2vw,58px)}.certification-manifesto>p:not(.eyebrow){max-width:940px}.certification-proof-chain{display:flex;align-items:center;gap:28px;flex-wrap:wrap;margin-top:30px}.certification-proof-chain>span{display:flex;gap:12px;align-items:center;font-size:14px}.certification-proof-chain>:global(.arrow){width:18px;height:18px;color:var(--brand)}
