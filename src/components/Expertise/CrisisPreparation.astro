---
import Icon from '@/components/Icon/Icon.astro';
import type {Locale} from '@/config/site';
import copy from '@/data/crisis-preparation.json';
const {lang}=Astro.props as {lang:Locale};
const fr=lang==='fr';
const c=copy[lang];
const icons=['compass','envelope','clock','clipboard-check'] as const;
const stem=`/media/exercices-crise-cyber/preparation-${lang}`;
---
<figure class="crisis-preparation" data-crisis-preparation data-lang={lang} data-step="4">
 <header><div><p class="eyebrow">STELAU / {fr?'AVANT LA PREMIÈRE ALERTE':'BEFORE THE FIRST ALERT'}</p><h3>{c.title}</h3></div><span class="preparation-counter" data-preparation-counter aria-hidden="true">04 / 04</span></header>
 <div class="preparation-scenes" aria-hidden="true" data-pagefind-ignore>{c.steps.map((s,i)=><div class="preparation-scene" data-preparation-scene={i+1}><div class="preparation-artifact"><span class="preparation-marker">{c.marker}</span><div class="preparation-artifact-title"><span>{s[2]}</span><Icon name={icons[i]} size={30}/></div><strong>{s[3]}</strong><p>{s[4]}</p><span class="preparation-marker preparation-marker-end">{c.marker}</span></div><div class="preparation-clocks"><div class="preparation-clock-labels"><span>{fr?'Temps de la crise':'Crisis time'}</span><span>{fr?'Temps du jeu':'Exercise time'}</span></div>{c.gameTimes.map((time,j)=><div class:list={['preparation-time',{'preparation-weekend':j===1||j===2}]}><span>{c.crisisDays[j]}</span><span class="preparation-time-track"><i style={`--tick:${j}`}/></span><span>{time}</span></div>)}<p>{fr?'Week-end inclus · horaires de jeu donnés en exemple':'Weekend included · example exercise times'}</p></div></div>)}</div>
 <ol class="preparation-steps">{c.steps.map((s,i)=><li><button type="button" data-preparation-select={i+1} aria-label={`${fr?'Étape':'Step'} ${i+1} : ${s[0]}`} aria-current={i===3?'step':undefined}><span>0{i+1}</span><strong>{s[0]}</strong></button><p>{s[1]}</p></li>)}</ol>
 <figcaption><p>{c.caption}</p><div class="preparation-controls"><button type="button" data-preparation-toggle aria-pressed="false">{fr?'Lire l’animation':'Play animation'}</button><button type="button" data-preparation-replay>{fr?'Rejouer':'Replay'}</button><a class="preparation-gif-light" href={stem+'-light.gif'} download>GIF ↓</a><a class="preparation-gif-dark" href={stem+'-dark.gif'} download>GIF ↓</a></div></figcaption>
</figure>
<script>
 document.querySelectorAll<HTMLElement>('[data-crisis-preparation]').forEach(el=>{
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const fr=el.dataset.lang==='fr';const toggle=el.querySelector<HTMLButtonElement>('[data-preparation-toggle]')!;
  const selectors=el.querySelectorAll<HTMLButtonElement>('[data-preparation-select]');
  let elapsed=reduced.matches?12000:0,previous=0,frame=0,visible=false,playing=false,requested=!reduced.matches;
  function render(){const step=Math.min(4,Math.floor(elapsed/4000)+1);el.dataset.step=String(step);el.querySelector('[data-preparation-counter]')!.textContent=`0${step} / 04`;selectors.forEach((button,i)=>{if(i+1===step)button.setAttribute('aria-current','step');else button.removeAttribute('aria-current');});}
  function sync(){el.dataset.playing=String(playing);toggle.setAttribute('aria-pressed',String(playing));toggle.textContent=playing?'Pause':(fr?'Lire l’animation':'Play animation');}
  function stop(){playing=false;cancelAnimationFrame(frame);previous=0;sync();}
  function tick(time:number){if(!playing)return;if(previous)elapsed+=Math.min(time-previous,100);previous=time;if(elapsed>=16000)elapsed=0;render();frame=requestAnimationFrame(tick);}
  function start(){if(playing||!visible||document.hidden)return;playing=true;previous=0;sync();frame=requestAnimationFrame(tick);}
  toggle.addEventListener('click',()=>{requested=!playing;if(requested)start();else stop();});
  el.querySelector('[data-preparation-replay]')!.addEventListener('click',()=>{elapsed=0;render();requested=true;start();});
  selectors.forEach((button,i)=>button.addEventListener('click',()=>{requested=false;stop();elapsed=i*4000;render();}));
  new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(visible&&requested)start();else stop();},{threshold:.15}).observe(el);
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();else if(requested)start();});
  reduced.addEventListener('change',()=>{requested=!reduced.matches;if(reduced.matches){stop();elapsed=12000;render();}else start();});
  render();sync();
 });
</script>
<style>
 .crisis-preparation{margin:28px 0 0;padding:28px;background:var(--soft);border:1px solid var(--line);border-radius:16px}.crisis-preparation header{display:flex;justify-content:space-between;align-items:center;gap:20px}.crisis-preparation header .eyebrow{font-size:10px;margin:0 0 10px}.crisis-preparation header h3{font-size:25px;line-height:1.3;letter-spacing:-.025em;margin:0}.preparation-counter{font:12px var(--font-mono);color:var(--brand);white-space:nowrap}
 .preparation-scenes{margin:26px 0}.preparation-scene{display:none;grid-template-columns:1.15fr .85fr;gap:42px;align-items:center}.crisis-preparation[data-step="1"] [data-preparation-scene="1"],.crisis-preparation[data-step="2"] [data-preparation-scene="2"],.crisis-preparation[data-step="3"] [data-preparation-scene="3"],.crisis-preparation[data-step="4"] [data-preparation-scene="4"]{display:grid}.preparation-artifact{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:22px;min-height:320px;display:flex;flex-direction:column}.preparation-marker{font:10px var(--font-mono);color:var(--brand);letter-spacing:.03em;display:block}.preparation-artifact-title{display:flex;align-items:center;justify-content:space-between;gap:15px;margin:20px 0 14px;font-size:13px;color:var(--muted)}.preparation-artifact>strong{font-size:22px;line-height:1.4;letter-spacing:-.025em;display:block}.preparation-artifact>p{font-size:12px!important;line-height:1.75!important;color:var(--muted);margin:14px 0 18px!important}.preparation-marker-end{margin-top:auto;border-top:1px solid var(--line);padding-top:12px}
 .preparation-clock-labels{display:flex;justify-content:space-between;font:11px var(--font-mono);color:var(--muted);margin-bottom:20px}.preparation-time{display:grid;grid-template-columns:42px 1fr 50px;gap:16px;align-items:center;padding:9px 0;font:13px var(--font-mono)}.preparation-weekend>span:first-child{color:var(--brand)}.preparation-time-track{height:2px;background:var(--line);position:relative;display:block}.preparation-time-track i{width:6px;height:6px;position:absolute;top:-2px;left:calc(var(--tick)*28%);border-radius:50%;background:var(--brand)}.crisis-preparation[data-playing="true"] .preparation-time-track i{animation:prepared-event 2s ease-in-out infinite;animation-delay:calc(var(--tick)*.3s)}@keyframes prepared-event{50%{transform:translateX(15px);opacity:.5}}.preparation-clocks>p{font-size:10px!important;line-height:1.8!important;color:var(--muted);margin:18px 0 0}
 .preparation-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px;list-style:none;padding:0;margin:0 0 24px}.preparation-steps button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;border-top:2px solid var(--line);padding:14px 0 8px;background:none;color:var(--ink)}.preparation-steps button[aria-current]{border-color:var(--brand);color:var(--brand)}.preparation-steps button:hover{color:var(--brand)}.preparation-steps button>span{font:10px var(--font-mono);color:var(--muted)}.preparation-steps button>strong{font-size:15px}.preparation-steps p{font-size:12px!important;line-height:1.75!important;margin:4px 0 0}
 .crisis-preparation figcaption{display:flex;align-items:center;justify-content:space-between;gap:24px;border-top:1px solid var(--line);padding-top:20px}.crisis-preparation figcaption>p{font-size:12px!important;line-height:1.8!important;margin:0;max-width:650px;color:var(--muted)}.preparation-controls{display:flex;gap:8px;flex-wrap:wrap;flex-shrink:0}.preparation-controls button,.preparation-controls a{font-size:12px;background:var(--surface);color:var(--ink);padding:9px 12px;border:1px solid var(--line);border-radius:6px}.preparation-controls button:hover,.preparation-controls a:hover{border-color:var(--brand)}.preparation-gif-dark{display:none}:global(.dark) .preparation-gif-dark{display:inline-block}:global(.dark) .preparation-gif-light{display:none}
 @media(max-width:900px){.preparation-scene{gap:25px;grid-template-columns:1.1fr 1fr}.crisis-preparation figcaption{align-items:start;flex-direction:column}.preparation-steps{gap:16px}}
 @media(max-width:600px){.crisis-preparation{padding:20px}.crisis-preparation header{align-items:start;gap:12px}.crisis-preparation header h3{font-size:22px}.preparation-counter{font-size:10px;margin-top:2px}.preparation-scene{grid-template-columns:1fr;gap:22px}.preparation-artifact{padding:18px;min-height:320px}.preparation-artifact>strong{font-size:20px}.preparation-marker{font-size:8px;letter-spacing:0}.preparation-artifact-title{margin-top:17px;font-size:12px}.preparation-clocks{padding:0 3px}.preparation-steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 18px}.preparation-steps button>strong{font-size:14px}.preparation-controls button,.preparation-controls a{padding:9px 10px;font-size:11px}}
 @media(prefers-reduced-motion:reduce){.preparation-time-track i{animation:none!important}}
</style>
