---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import {Code} from 'astro:components';
import githubDark from '@shikijs/themes/github-dark';
import Icon from '@/components/Icon/Icon.astro';
import Arrow from '@/components/Arrow.astro';
import VdsProofSimulation from './VdsProofSimulation.astro';
import {href,walletExpertiseHref,type Locale} from '@/config/site';
import type {IconName} from '@/data/icons';
const {lang}=Astro.props as {lang:Locale};
const fr=lang==='fr';
const screenshots=import.meta.glob<{default:ImageMetadata}>('/src/assets/images/vds-verify/*.webp',{eager:true});
const screen=(name:string,theme:string)=>screenshots[`/src/assets/images/vds-verify/${name}-${lang}-${theme}.webp`].default;
const darkCodeTheme={...githubDark,name:'vds-stelau-dark',colors:{...githubDark.colors,'editor.background':'#20262d'},tokenColors:[...(githubDark.tokenColors||[]),{scope:['keyword','storage.type','storage.modifier','entity.name.function','support.function'],settings:{foreground:'#ffae73'}}]};
const code=`const response = await integrityFetch(
    apiUrl,
    "/api/v1/decode",
    JSON.stringify({ vds: b64encodedvds }),
);
const { success, message, vds } = await response
    .json()
    .catch(() => ({}));
if (success === true) {
    const normalized = normalizeVdsResult(vds);
    if (!normalized) {
        showError("error_invalid_qr");
        return;
    }
    // …
}`;
const standards=fr?[
 {tag:'FRANCE TITRES / ANTS',title:'2D-DOC',text:'Les spécifications du format, les profils de documents et les ressources de confiance de l’écosystème français.',note:'Spécifications & profils',url:'https://pub.ants.gouv.fr/2D-DOC/DOCUMENTATION/00_HTML/Espace_de_Publication_2D-DOC_PRD.htm'},
 {tag:'NORME INTERNATIONALE',title:'ISO 22376:2023',text:'Un cadre pour la structure, la représentation, la production et la vérification des cachets électroniques visibles.',note:'Norme publiée en 2023',url:'https://www.iso.org/fr/standard/50278.html'},
 {tag:'COMPATIBILITÉ HISTORIQUE',title:'AFNOR XP Z42-105',text:'Un format pris en charge pour les cachets existants. La norme de septembre 2020 est désormais annulée.',note:'Norme annulée / formats existants',url:'https://www.boutique.afnor.org/fr-fr/norme/xp-z42105/specifications-relatives-a-la-mise-en-oeuvre-du-cachet-electronique-visible/fa199910/238577'}
] : [
 {tag:'FRANCE TITRES / ANTS',title:'2D-DOC',text:'Format specifications, document profiles and trust resources for the French ecosystem.',note:'Specifications & profiles',url:'https://pub.ants.gouv.fr/2D-DOC/DOCUMENTATION/00_HTML/Espace_de_Publication_2D-DOC_PRD.htm'},
 {tag:'INTERNATIONAL STANDARD',title:'ISO 22376:2023',text:'A framework for the structure, representation, production and verification of visible digital seals.',note:'Published in 2023',url:'https://www.iso.org/standard/50278.html'},
 {tag:'LEGACY COMPATIBILITY',title:'AFNOR XP Z42-105',text:'A supported format for existing seals. The September 2020 standard has since been withdrawn.',note:'Withdrawn standard / existing formats',url:'https://www.boutique.afnor.org/fr-fr/norme/xp-z42105/specifications-relatives-a-la-mise-en-oeuvre-du-cachet-electronique-visible/fa199910/238577'}
];
const challenges:{icon:IconName;title:string;text:string}[]=fr?[
 {icon:'code',title:'Lire les bons octets.',text:'Encodage, en-têtes, versions et schémas : une signature se vérifie sur une représentation précise des données, pas sur une approximation du texte affiché.'},
 {icon:'scale-balanced',title:'Construire la confiance.',text:'Une signature mathématiquement correcte ne suffit pas. Il faut examiner le certificat de l’émetteur, sa validité et les informations de révocation applicables.'},
 {icon:'sliders',title:'Faire coexister les formats.',text:'Distinguer les familles de cachets et les profils documentaires ; gérer les évolutions sans perdre la lecture des documents déjà émis.'},
 {icon:'eye',title:'Restituer sans surpromettre.',text:'Données décodées, signature vérifiée, résultat indéterminé : des états distincts, compréhensibles pour la personne qui prend une décision.'}
]:[
 {icon:'code',title:'Read the right bytes.',text:'Encoding, headers, versions and schemas: verification applies to an exact representation of the data, not an approximation of the displayed text.'},
 {icon:'scale-balanced',title:'Establish trust.',text:'A mathematically correct signature is not enough. The issuer’s certificate, its validity and applicable revocation information must be examined.'},
 {icon:'sliders',title:'Support coexisting formats.',text:'Distinguish seal families and document profiles; handle changes while preserving the ability to read documents already issued.'},
 {icon:'eye',title:'Explain the result accurately.',text:'Decoded data, verified signature, indeterminate result: distinct states that the person making a decision can understand.'}
];
---
<div class="container page-intro vds-hero">
 <div class="vds-hero-copy"><a class="back-link" href={href(lang,'expertise')}>← {fr?'Toutes nos expertises':'All expertise'}</a><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="file-check" size={24}/></span>VDS VERIFY / 2D-DOC / CEV</p><h1>{fr?'La preuve':'The proof'}<br/><em>{fr?'dans le code.':'in the code.'}</em></h1><p class="lead">{fr?'Un petit carré imprimé. Des données signées. Et tout un travail d’experts pour les lire, les vérifier et en comprendre la portée. Avec VDS Verify, Stelau rend cette preuve accessible.':'A small printed square. Signed data. And expert engineering to read it, verify it and understand what it proves. With VDS Verify, Stelau makes that proof accessible.'}</p><div class="vds-actions"><a class="button" href="https://vds-verify.stelau.com/" target="_blank" rel="noopener noreferrer">{fr?'Découvrir VDS Verify':'Explore VDS Verify'}<Arrow/></a><a class="text-link" href="#signature">{fr?'Comprendre la preuve':'Understand the proof'}<Arrow/></a></div><p class="vds-hero-note"><Icon name="code" size={20}/>{fr?'Une application mobile, une API et un SDK conçus par Stelau.':'A mobile app, an API and an SDK built by Stelau.'}</p></div>
 <figure class="vds-product-hero"><div class="vds-product-grid" aria-hidden="true"></div><span class="vds-product-label mono">VDS VERIFY / {fr?'DONNÉES VÉRIFIABLES':'VERIFIABLE DATA'}</span><div class="vds-phone"><Image class="screen-light" src={screen('identity','light')} alt={fr?'VDS Verify affiche les données d’un justificatif d’identité et le résultat de vérification de sa signature.':'VDS Verify displays identity document data and the signature verification result.'} width={300} loading="eager"/><Image class="screen-dark" src={screen('identity','dark')} alt={fr?'VDS Verify : données d’un justificatif et résultat de vérification, en thème sombre.':'VDS Verify: document data and verification result, in dark mode.'} width={300} loading="eager"/></div><figcaption>{fr?'Capture de démonstration de l’application.':'Demonstration screenshot of the app.'}</figcaption></figure>
</div>
<section class="container vds-reach" aria-label={fr?'VDS Verify dans France Identité':'VDS Verify in France Identité'}><div class="vds-reach-number"><strong>5 M<span>+</span></strong><span>{fr?'utilisateurs de France Identité':'France Identité users'}</span></div><div><h2>{fr?'Du code Stelau. Dans les usages quotidiens.':'Stelau code. In everyday use.'}</h2><p>{fr?'Notre SDK est intégré à France Identité. Notre API intervient aussi dans la génération de ses cachets électroniques visibles et dans le service de vérification 2D-DOC de France Titres.':'Our SDK is integrated into France Identité. Our API is also used to generate its visible digital seals and in France Titres’ 2D-DOC verification service.'}</p><p class="vds-source">{fr?'Le chiffre concerne les utilisateurs de France Identité, pas un nombre de scans.':'The figure refers to France Identité users, not a scan count.'} <a href="https://france-identite.gouv.fr/actualite/5M-utilisateurs-FI.html" target="_blank" rel="noopener noreferrer">France Identité · {fr?'1er octobre 2026':'1 October 2026'}</a> · <a href="https://vds-verify.stelau.com/" target="_blank" rel="noopener noreferrer">{fr?'Intégrations VDS Verify':'VDS Verify integrations'}</a></p></div></section>
<nav class="container vds-chapters" aria-label={fr?'Dans cette page':'On this page'}>{(fr?[['signature','01','La signature'],['normes','02','Les normes'],['verifieur','03','VDS Verify'],['code','04','Le code'],['papier','05','Papier & wallet']]:[['signature','01','The signature'],['normes','02','Standards'],['verifieur','03','VDS Verify'],['code','04','The code'],['papier','05','Paper & wallets']]).map(([id,n,label])=><a href={'#'+id}><span>{n}</span>{label}<Arrow/></a>)}</nav>
<section id="signature" class="container vds-section" aria-labelledby="vds-signature"><p class="eyebrow">01 / {fr?'Ce que protège le code':'What the code protects'}</p><div class="vds-split"><h2 id="vds-signature">{fr?'Un 2D-DOC, c’est d’abord':'A 2D-DOC is first'}<br/><em>{fr?'une signature électronique.':'an electronic signature.'}</em></h2><div><p>{fr?'Le code transporte des données et leur signature. Cette signature permet de vérifier que les données couvertes n’ont pas été modifiées, et d’en établir l’origine dans un cadre de confiance défini. Le QR code ou le Data Matrix est le support de cette preuve.':'The code carries data and its signature. This signature makes it possible to check that the covered data has not been changed, and establish its origin within a defined trust framework. The QR code or Data Matrix carries that proof.'}</p><p>{fr?'Le cachet électronique visible (CEV, ou VDS en anglais) fait ainsi le pont entre un document et une preuve vérifiable par une machine.':'A visible digital seal (VDS, or CEV in French) bridges a document and a proof that a machine can verify.'}</p></div></div><VdsProofSimulation lang={lang} kind="integrity"/><aside class="vds-note"><Icon name="circle-info" size={24}/><p>{fr?'Un point décisif : modifier seulement le texte visible, sans toucher au code, ne rend pas sa signature invalide. Le lecteur doit comparer les données signées avec celles du document présenté.':'A crucial point: changing only the visible text, without changing the code, does not invalidate its signature. The reader must compare the signed data with the document being presented.'}</p></aside></section>
<section id="normes" class="container vds-section" aria-labelledby="vds-standards"><p class="eyebrow">02 / {fr?'Des normes au terrain':'From standards to practice'}</p><h2 id="vds-standards">{fr?'Lire les spécifications.':'Read the specifications.'}<br/><em>{fr?'Faire fonctionner les formats.':'Make the formats work.'}</em></h2><p class="vds-section-lead">{fr?'Notre travail relie les spécifications 2D-DOC, les cachets normalisés et les documents déjà en circulation. Un intitulé de norme ne dispense jamais de préciser le profil, la version et les conditions de confiance.':'Our work connects 2D-DOC specifications, standardised seals and documents already in circulation. A standard’s name never removes the need to specify the profile, version and trust conditions.'}</p><div class="vds-standard-grid">{standards.map((s,i)=><article><div class="vds-card-top"><span class="mono">0{i+1}</span><Icon name={i===2?'clock':'book-open'} size={32}/></div><p class="eyebrow">{s.tag}</p><h3>{s.title}</h3><p>{s.text}</p><span class="vds-status">{s.note}</span><a class="text-link" href={s.url} target="_blank" rel="noopener noreferrer">{fr?'Consulter la source':'Read the source'}<Arrow/></a></article>)}</div><p class="vds-source">{fr?'ISO 22376 ne remplace pas à elle seule les spécifications nationales ni les règles de gouvernance de la confiance.':'ISO 22376 does not, on its own, replace national specifications or trust governance rules.'} <a href="https://www.iso.org/fr/standard/50278.html" target="_blank" rel="noopener noreferrer">ISO 22376:2023</a></p></section>
<section id="verifieur" class="container vds-section" aria-labelledby="vds-product"><p class="eyebrow icon-eyebrow"><Icon name="clipboard-check" size={24}/>03 / {fr?'Notre vérifieur':'Our verifier'}</p><div class="vds-split"><div><h2 id="vds-product">{fr?'Voir les données.':'See the data.'}<br/><em>{fr?'Comprendre le résultat.':'Understand the result.'}</em></h2><p>{fr?'VDS Verify lit les codes sur papier ou à l’écran, restitue les données décodées et affiche le résultat de vérification. Les détails du cachet et du certificat permettent d’aller au-delà d’un simple voyant vert.':'VDS Verify reads codes on paper or on screen, displays decoded data and shows the verification result. Seal and certificate details take the result beyond a simple green indicator.'}</p><div class="vds-product-parts"><article><Icon name="id-card" size={26}/><div><h3>{fr?'L’application':'The app'}</h3><p>{fr?'Un lecteur mobile pour examiner un document et ses données signées. Son code est publié sous licence Apache 2.0.':'A mobile reader for examining documents and signed data. Its code is published under Apache 2.0.'}</p></div></article><article><Icon name="server" size={26}/><div><h3>{fr?'L’API':'The API'}</h3><p>{fr?'Des services pour générer, décoder et vérifier des cachets dans vos parcours métier.':'Services for generating, decoding and verifying seals within your workflows.'}</p></div></article><article><Icon name="microchip" size={26}/><div><h3>{fr?'Le SDK':'The SDK'}</h3><p>{fr?'Une intégration au sein d’autres applications, comme France Identité.':'Integration within other applications, such as France Identité.'}</p></div></article></div><div class="vds-actions"><a class="button" href="https://vds-verify.stelau.com/" target="_blank" rel="noopener noreferrer">{fr?'Accéder à l’application':'Get the app'}<Arrow/></a><a class="text-link" href="https://github.com/stelauconseil/vds-verify" target="_blank" rel="noopener noreferrer"><Icon name="code" size={20}/>{fr?'Le dépôt public':'Public repository'}<Arrow/></a></div></div><figure class="vds-details"><div class="vds-phone"><Image class="screen-light" src={screen('details','light')} alt={fr?'L’écran des détails de VDS Verify présente l’en-tête technique du cachet et les informations de son certificat.' : 'The VDS Verify details screen shows the seal’s technical header and certificate information.'} width={300}/><Image class="screen-dark" src={screen('details','dark')} alt={fr?'En-tête technique et certificat dans VDS Verify, en thème sombre.':'Technical header and certificate in VDS Verify, in dark mode.'} width={300}/></div><figcaption>{fr?'La preuve se lit aussi dans les détails.':'The proof is also in the details.'}</figcaption></figure></div></section>
<section id="code" class="container vds-section" aria-labelledby="vds-code"><p class="eyebrow icon-eyebrow"><Icon name="code" size={24}/>04 / {fr?'Des experts qui codent':'Experts who code'}</p><div class="vds-split"><div><h2 id="vds-code">{fr?'Décoder':'Decoding'}<br/><em>{fr?'n’est pas vérifier.':'is not verification.'}</em></h2><p>{fr?'Dans l’application publique, le code scanné est transmis à une API pour son décodage et sa vérification. L’application contrôle ensuite la forme du résultat avant de le restituer. Cet extrait montre cette frontière entre lecteur et service ; le moteur cryptographique n’est pas présenté ici.':'In the public app, the scanned code is sent to an API for decoding and verification. The app then checks the result’s structure before displaying it. This excerpt shows the boundary between reader and service; it does not show the cryptographic engine.'}</p><p>{fr?'C’est derrière cette simplicité apparente que se concentre le travail d’implémentation : traiter les données exactement, expliciter les erreurs et ne jamais confondre une lecture réussie avec une preuve valide.':'Behind this apparent simplicity lies the implementation work: handling data precisely, explaining errors and never confusing a successful read with a valid proof.'}</p></div><div class="vds-code-window"><div class="vds-code-title"><span class="window-dots"><i/><i/><i/></span><span>index.tsx / {fr?'EXTRAIT':'EXCERPT'}</span><span>TS</span></div><Code code={code} lang="typescript" themes={{light:'github-light',dark:darkCodeTheme}} defaultColor="light"/><p><a href="https://github.com/stelauconseil/vds-verify/blob/1b06131bd2b8671978cb2c8eb6403efd5e4ebe9b/src/app/%28tabs%29/index.tsx#L197-L215" target="_blank" rel="noopener noreferrer">{fr?'Code de l’application mobile · Stelau · Apache 2.0':'Mobile app code · Stelau · Apache 2.0'} ↗</a></p></div></div><div class="vds-challenges">{challenges.map(c=><article><Icon name={c.icon} size={30}/><h3>{c.title}</h3><p>{c.text}</p></article>)}</div></section>
<section id="papier" class="container vds-section" aria-labelledby="vds-paper"><p class="eyebrow">05 / {fr?'Papier, copie et détenteur':'Paper, copies and the holder'}</p><div class="vds-split"><h2 id="vds-paper">{fr?'Une preuve qui voyage.':'A proof that travels.'}<br/><em>{fr?'Une portée à bien comprendre.':'A scope to understand.'}</em></h2><div><p>{fr?'Un cachet peut être imprimé puis relu : si le code reste lisible, les données et leur signature traversent le changement de support. Cette rematérialisation papier est un atout concret pour les usages actuels.':'A seal can be printed and read again: if the code stays readable, its data and signature survive the change of medium. This ability to move back to paper is a practical benefit for today’s uses.'}</p><p>{fr?'En revanche, un cachet statique peut être copié. Sa signature peut rester valide sans établir que la personne qui le présente en est le détenteur légitime. L’intégrité et la protection contre la transférabilité indue sont deux questions distinctes.':'A static seal can also be copied. Its signature can remain valid without establishing that the presenter is its legitimate holder. Integrity and protection against unauthorised transfer are distinct questions.'}</p></div></div><VdsProofSimulation lang={lang} kind="paper"/><div class="vds-wallet"><Icon name="wallet" size={40}/><div><h3>{fr?'Le lien au détenteur : une autre couche de preuve.':'Holder binding: another layer of proof.'}</h3><p>{fr?'Selon le protocole et son implémentation, un wallet peut ajouter une preuve de possession et une présentation liée à un défi du vérificateur. Ces mécanismes complètent la signature du document. Nos travaux sur les cachets imbriqués explorent aussi le lien entre données certifiées et appareil de présentation.':'Depending on the protocol and its implementation, a wallet can add proof of possession and bind a presentation to a verifier’s challenge. These mechanisms complement the document’s signature. Our work on nested seals also explores binding certified data to the presenting device.'}</p><div class="vds-actions"><a class="text-link" href={walletExpertiseHref(lang)}>{fr?'Notre expertise wallets':'Our wallet expertise'}<Arrow/></a><a class="text-link" href={href(lang,'cases')+'nested-vds/'}>Nested VDS<Arrow/></a></div></div></div></section>
<section class="container vds-section vds-close" aria-labelledby="vds-next"><p class="eyebrow">{fr?'Votre prochain usage':'Your next use case'}</p><h2 id="vds-next">{fr?'Un document à signer.':'A document to sign.'}<br/><em>{fr?'Une preuve à intégrer.':'A proof to integrate.'}</em></h2><p>{fr?'Émission de cachets, lecture de documents, intégration d’un vérifieur : nos experts vous accompagnent du choix du format à la mise en œuvre, avec une lecture précise des garanties attendues.':'Seal issuance, document reading, verifier integration: our experts support you from choosing the format to implementation, with a precise understanding of the guarantees required.'}</p><a class="button" href={href(lang,'contact')}>{fr?'Parlons de votre projet':'Let’s discuss your project'}<Arrow/></a><div class="vds-resources"><span class="mono">{fr?'POUR ALLER PLUS LOIN':'FURTHER READING'}</span><a href="https://ants.gouv.fr/nos-missions/les-solutions-numeriques/2d-doc" target="_blank" rel="noopener noreferrer">France Titres / 2D-DOC ↗</a><a href="https://france-identite.gouv.fr/justificatif/" target="_blank" rel="noopener noreferrer">{fr?'Le justificatif France Identité':'France Identité identity proof'} ↗</a><a href="https://github.com/stelauconseil/vds-verify/blob/1b06131bd2b8671978cb2c8eb6403efd5e4ebe9b/LICENSE" target="_blank" rel="noopener noreferrer">{fr?'Licence du code de l’application':'App source code licence'} ↗</a></div></section>
<style>
 .vds-hero{display:grid;grid-template-columns:1.25fr .8fr;gap:65px;align-items:center;padding-top:48px;padding-bottom:50px}.vds-hero-copy{min-width:0}.vds-hero .eyebrow{margin-top:36px;font-size:12px}.vds-hero h1{font-size:clamp(52px,5.8vw,84px);line-height:1.07;margin:25px 0 28px;letter-spacing:-.045em}.vds-hero .lead{font-size:19px;line-height:1.8;margin:0;max-width:660px}.vds-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:26px}.vds-actions .button{font-size:15px;gap:18px}.vds-actions .text-link{font-size:14px;gap:10px}.vds-hero-note{display:flex;align-items:start;gap:12px;color:var(--muted);font-size:13px;margin-top:26px;max-width:430px}
 .vds-product-hero{position:relative;isolation:isolate;margin:0;padding:36px 22px 18px;border:1px solid var(--line);border-radius:24px;background:var(--soft);text-align:center;overflow:hidden}.vds-product-grid{position:absolute;inset:0;z-index:-1;opacity:.3;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:25px 25px;mask-image:linear-gradient(135deg,#000,transparent 80%)}.vds-product-label{font-size:10px;letter-spacing:.05em;display:block;color:var(--muted);margin-bottom:24px}.vds-phone{max-width:248px;margin:0 auto;border:6px solid #212529;border-radius:28px;overflow:hidden;box-shadow:0 20px 40px #21252918;background:#212529}.vds-phone img{display:block;width:100%;height:auto}.vds-phone .screen-dark{display:none}:global(.dark) .vds-phone .screen-light{display:none}:global(.dark) .vds-phone .screen-dark{display:block}.vds-product-hero figcaption,.vds-details figcaption{font-size:11px;color:var(--muted);margin:20px 0 0}
 .vds-reach{display:grid;grid-template-columns:.6fr 1.6fr;gap:65px;align-items:center;padding-top:36px;padding-bottom:40px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.vds-reach-number{display:flex;flex-direction:column}.vds-reach-number>strong{font-size:clamp(56px,6vw,86px);line-height:1;letter-spacing:-.065em;color:var(--brand);font-weight:550}.vds-reach-number strong span{font-size:.5em;vertical-align:top;margin-left:6px}.vds-reach-number>span{font-size:13px;color:var(--muted);margin-top:14px}.vds-reach h2{font-size:28px;line-height:1.3;margin:0 0 15px}.vds-reach p{font-size:16px;margin:0 0 12px;line-height:1.8}.vds-source{font-size:12px!important;color:var(--muted);line-height:1.7!important;margin-top:20px!important}.vds-source a{text-decoration:underline;text-underline-offset:3px}
 .vds-chapters{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:15px;padding-top:30px;padding-bottom:22px}.vds-chapters a{display:flex;align-items:center;gap:10px;font-size:13px}.vds-chapters a span{font:11px var(--font-mono);color:var(--brand)}.vds-chapters :global(.arrow){width:16px;height:16px;margin-left:auto;color:var(--brand)}.vds-chapters a:hover{text-decoration:underline;text-underline-offset:4px}
 .vds-section{padding-top:62px;padding-bottom:38px;scroll-margin-top:32px}.vds-section h2{font-size:clamp(30px,3.5vw,46px);line-height:1.18;letter-spacing:-.04em;margin:16px 0 25px}.vds-section h3{font-size:25px;line-height:1.3;margin:16px 0 18px}.vds-section p:not(.eyebrow){font-size:17px;line-height:1.85;color:var(--muted)}.vds-section-lead{max-width:830px}.vds-split{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:start}.vds-split>div>p:first-child{margin-top:18px}.vds-note{display:flex;align-items:start;gap:16px;padding:21px 0;border-bottom:1px solid var(--line)}.vds-note p{font-size:14px!important;margin:0}.vds-note :global(.fa-icon){margin-top:4px}
 .vds-standard-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:32px}.vds-standard-grid article{display:flex;flex-direction:column;padding:26px;border:1px solid var(--line);background:var(--surface);border-radius:12px}.vds-card-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:11px;margin-bottom:30px}.vds-standard-grid .eyebrow{font-size:10px;letter-spacing:.05em}.vds-standard-grid h3{font-size:26px;margin-top:13px}.vds-standard-grid p:not(.eyebrow){font-size:15px}.vds-status{font-size:11px;color:var(--muted);border-top:1px solid var(--line);padding-top:15px;margin-top:auto}.vds-standard-grid .text-link{margin-top:20px;font-size:13px;align-self:start}
