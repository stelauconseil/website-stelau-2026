---
import Icon from '@/components/Icon/Icon.astro';
import copy from '@/data/presentation-flow.json';
import {claims} from '@/lib/identity-demo/protocol';
import type {Locale} from '@/config/site';
const {lang}=Astro.props as {lang:Locale};
const c=copy[lang],fr=lang==='fr';
const roles=['issuer','wallet','rp'] as const;
const icons=['building','wallet','graduation-cap'] as const;
---
<figure id="presentation-oid4vp" class="presentation-flow" data-presentation-flow data-lang={lang} data-phase="0" data-demo-state="pending">
 <header><span class="flow-kicker">STELAU / OID4VCI → OID4VP / SD-JWT VC</span><h3>{c.title}</h3><p>{c.subtitle}</p></header>
 <div class="protocol-map" data-flow-scene>
  <div class="protocol-actors">
   {roles.map((role,i)=><section class={`protocol-actor actor-${role}`} data-flow-actor={i} aria-label={c.roles[i]}>
    <span class="actor-icon"><Icon name={icons[i]} size={28}/></span><h4>{c.roles[i]}</h4><p class="actor-note">{c.roleNotes[i]}</p>
    {role==='issuer'&&<div class="actor-detail"><span class="actor-token">SD-JWT VC</span><code>iss · vct · _sd<br/>cnf.jwk = <b class="key-h">H</b></code><span class="issuer-seal"><Icon name="file-signature" size={14}/>{c.issuerSeal}</span></div>}
    {role==='wallet'&&<div class="actor-detail"><span class="actor-token">{c.ready}</span><div class="wallet-key"><Icon name="fingerprint" size={25}/><strong>{c.keyPrivate}</strong></div><span class="wallet-key-note">{c.keyStays}</span></div>}
    {role==='rp'&&<div class="actor-detail"><span class="actor-token" data-active-rp>RP-A</span><code>qualification_valid<br/><b>true</b></code><span class="rp-wait">{c.waiting}</span><span class="rp-verified"><span class="rp-good"><Icon name="check" size={14}/></span><span class="rp-bad"><Icon name="xmark" size={14}/></span><span data-rp-verdict>{c.verified}</span></span></div>}
   </section>)}
  </div>
  <div class="protocol-routes" aria-hidden="true"><span>← OID4VCI →</span><span>← OID4VP →</span></div>
  <div class="protocol-packet" data-flow-packet aria-hidden="true" data-pagefind-ignore><Icon name="paper-plane" size={18}/><div><b data-packet-title>SD-JWT VC</b><span data-packet-note/></div></div>
 </div>
 <nav class="flow-step-nav" aria-label={fr?'Étapes des protocoles':'Protocol steps'} data-flow-interactive hidden>{c.steps.map((s,i)=><button type="button" data-flow-select={i} aria-controls="flow-narrator" aria-current={i===0?'step':undefined}><span>0{i+1}</span>{s[0]}</button>)}</nav>
 <div class="flow-narrator" id="flow-narrator">
  {c.steps.map((step,i)=><section data-flow-description={i} hidden={i!==0}>
   <header class="stage-heading"><span class="flow-kicker">0{i+1} / {step[3]}</span><h4>{step[1]}</h4><p>{step[2]}</p></header>
   {i===0&&<div class="issue-layout"><div class="signed-vc"><span class="object-label">{c.vcLabel}</span><dl><div><dt>iss</dt><dd>issuer.example.test</dd></div><div><dt>vct</dt><dd>…/qualification</dd></div><div><dt>_sd_alg</dt><dd>sha-256</dd></div><div><dt>_sd</dt><dd><span data-vc-digest>4 × SHA-256</span></dd></div><div class="key-binding-row"><dt>cnf.jwk</dt><dd><Icon name="fingerprint" size={15}/><strong>H</strong> <span data-holder-tag>P-256</span></dd></div></dl><span class="object-seal"><Icon name="file-signature" size={16}/>{c.issuerSeal} · ES256</span></div><div class="decoded-claims"><span class="object-label">{c.decoded}</span><dl>{claims.map(claim=><div><dt>{claim.name}</dt><dd>{String(claim.value)}</dd></div>)}</dl><p class="small-note">{c.claimsNote}</p></div></div>}
   {i===1&&<div class="request-card"><span class="object-label">RP-A → Wallet · {c.requestLabel}</span><dl><div><dt>client_id</dt><dd>x509_san_dns:rp-a.example.test</dd></div><div><dt>nonce</dt><dd data-nonce>…</dd></div><div><dt>dcql_query</dt><dd data-request-claims>claims: [ qualification_valid ]</dd></div></dl><label class="profile-label" for={`request-profile-${lang}`}>{c.profileLabel}</label><select id={`request-profile-${lang}`} data-request-profile><option value="minimal">{c.profiles[0]}</option><option value="named">{c.profiles[1]}</option></select><span class="request-footer">DCQL · dc+sd-jwt</span></div>}
   {i===2&&<div class="disclosure-layout"><fieldset class="claim-picker"><legend>{c.decoded}</legend>{claims.map((claim,j)=><label class:list={['claim-choice',{'claim-required':j===0}]}><input type="checkbox" name="disclosed-claim" value={claim.name} checked={j===0} disabled={j>0} data-disclosure/><span><strong>{c.attrs[j]}</strong><code>{claim.name}: {String(claim.value)}</code></span><small data-claim-demand>{j===0?c.required:c.optional}</small></label>)}</fieldset><div class="disclosure-preview"><span class="object-label">{c.selectionTitle}</span><div data-selected-claims><code>qualification_valid: true</code></div><span class="disclosure-count" data-disclosure-count>1 / 4 {c.selected}</span><p class="small-note">{c.selectionNote}</p></div></div>}
   {i===3&&<><div class="binding-layout"><div class="binding-card issuer-binding"><span class="object-label">{c.bindingFrom}</span><code>cnf.jwk</code><div class="binding-key"><Icon name="fingerprint" size={30}/><strong>{c.keyPublic}</strong></div><span class="binding-key-tag" data-holder-tag>P-256</span><span class="object-seal">{c.issuerSeal} · ES256</span></div><div class="binding-card holder-binding"><span class="object-label">{c.bindingTo}</span><span class="holder-stamp"><Icon name="file-signature" size={18}/>{c.holderSeal}</span><dl><div><dt>aud</dt><dd>…rp-a.example.test</dd></div><div><dt>nonce</dt><dd data-nonce>…</dd></div><div><dt>iat</dt><dd data-kb-iat>…</dd></div><div><dt>sd_hash</dt><dd data-sd-hash>SHA-256( SD-JWT ~ disclosures ~ )</dd></div></dl></div></div><p class="small-note">{c.bindingNote}</p></>}
   {i===4&&<><div class="verify-layout"><div class="rp-result"><span class="object-label">{c.received}</span><div data-received-claims><code>qualification_valid: true</code></div><strong class="verification-verdict" data-verification-verdict>{c.loading}</strong></div><ul class="verification-checks">{c.checks.map((check,j)=><li data-check={j} data-valid="pending"><span class="check-pass"><Icon name="check" size={15}/></span><span class="check-fail"><Icon name="xmark" size={15}/></span><span>{check}</span><b data-check-result>—</b></li>)}</ul></div><div class="transfer-tests" data-flow-interactive hidden><button type="button" data-copy-test><Icon name="users" size={17}/>{c.copyTest}</button><button type="button" data-replay-test><Icon name="share-nodes" size={17}/>{c.replayTest}</button><button type="button" data-reset-test>{c.resetTest}</button></div><p class="attack-result" data-attack-result hidden role="status"/><p class="small-note transfer-limit">{c.limit}</p></>}
  </section>)}
  <p class="request-missing" data-request-missing hidden role="status">{c.missing}</p>
  <p class="flow-refused" data-flow-refused hidden role="status">{c.denied}</p>
 </div>
 <div class="flow-consent" data-flow-consent hidden><span>{c.consent}</span><button type="button" data-flow-accept>{c.accept}<Icon name="check" size={15}/></button><button type="button" data-flow-refuse>{c.refuse}</button></div>
 <div class="flow-controls" data-flow-interactive hidden><button type="button" data-flow-play aria-pressed="false">{c.play}</button><button type="button" data-flow-replay>{c.replay}</button><button type="button" data-flow-next aria-label={c.next}>→</button></div>
 <span class="sr-only" role="status" data-flow-announcement/>
 <p class="demo-unavailable" data-demo-unavailable hidden>{c.unavailable}</p>
 <figcaption>{c.caption}</figcaption>
 <details class="flow-technical flow-transcript"><summary>{c.technical}</summary><div class="technical-content"><p>{c.technicalNote}</p><p>{c.localNote}</p>{c.payloads.map((title,i)=><details class="payload-detail"><summary>{title}</summary><pre><code data-protocol-json={i}>{fr?'Calcul local au lancement de la démonstration.':'Computed locally when the demo starts.'}</code></pre></details>)}<h4>{c.transcript}</h4><ol>{c.steps.map(s=><li><strong>{s[0]}.</strong> {s[2]}</li>)}</ol><p class="protocol-sources"><a href="https://openid.net/specs/openid-4-verifiable-credential-issuance-1_0-final.html">OID4VCI 1.0</a> · <a href="https://openid.net/specs/openid-4-verifiable-presentations-1_0-final.html">OID4VP 1.0</a> · <a href="https://www.rfc-editor.org/rfc/rfc9901.html#section-4.3">RFC 9901 §4.3</a></p></div></details>
</figure>
<script>
 import {initPresentationFlows} from './presentation';
 initPresentationFlows();
</script>
<style>
 .presentation-flow{--flow-purple:#7952aa;--flow-green:#167960;--flow-amber:#a56b12;--flow-red:#b43f59;container:protocol/inline-size;background:var(--soft);border:1px solid var(--line);border-radius:20px;padding:26px;margin:28px 0 34px;isolation:isolate;overflow:hidden}
 :global(.dark) .presentation-flow{--flow-purple:#c2a4ef;--flow-green:#77d5b7;--flow-amber:#efbf73;--flow-red:#ffa2b7}
 .flow-kicker{font:10px/1.6 var(--font-mono);letter-spacing:.05em;color:var(--brand)}.presentation-flow>header h3{font-size:29px!important;line-height:1.15!important;letter-spacing:-.04em;margin:12px 0!important}.presentation-flow>header p{font-size:13px!important;line-height:1.7!important;color:var(--muted);margin:0!important}
 .protocol-map{position:relative;margin:26px 0 22px}.protocol-actors{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.protocol-actor{position:relative;z-index:1;background:var(--surface);border:1px solid var(--line);border-radius:13px;padding:17px 14px;min-width:0;transition:border-color .3s}.actor-icon{height:30px;display:block;margin-bottom:10px}.actor-wallet .actor-icon{--fa-primary-color:var(--flow-purple)}.actor-rp .actor-icon{--fa-primary-color:var(--flow-green)}.protocol-actor h4{margin:0 0 4px;font-size:15px;line-height:1.4;letter-spacing:-.025em}.presentation-flow .actor-note{font-size:10px!important;line-height:1.6!important;min-height:32px;margin:0 0 13px!important;color:var(--muted)}.actor-detail{border-top:1px solid var(--line);padding-top:12px}.actor-token{font:9px/1.6 var(--font-mono);display:block;color:var(--muted);margin-bottom:8px}.actor-detail>code{font:11px/1.8 var(--font-mono);display:block;background:none;padding:0;overflow-wrap:anywhere}.actor-detail>code>b:not(.key-h){color:var(--flow-green)}.key-h{color:var(--flow-purple)}.issuer-seal{display:flex;gap:6px;align-items:center;font-size:9px;line-height:1.6;color:var(--brand);margin-top:10px}.wallet-key{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--flow-purple);--fa-primary-color:var(--flow-purple)}.wallet-key-note{display:block;font-size:9px;line-height:1.6;color:var(--muted);margin-top:9px}.rp-wait,.rp-verified{font-size:9px;line-height:1.6;margin-top:10px;display:block;color:var(--muted)}.rp-verified{display:none;--fa-primary-color:var(--flow-green);color:var(--flow-green);align-items:center;gap:5px}
 .rp-bad{display:none}.presentation-flow[data-verification="false"] .rp-good{display:none}.presentation-flow[data-verification="false"] .rp-bad{display:inline-flex}.presentation-flow[data-verification="false"] .rp-verified{color:var(--flow-red);--fa-primary-color:var(--flow-red)}
 .protocol-routes{position:relative;display:grid;grid-template-columns:1fr 1fr;margin:12px 14% 0;gap:28px;align-items:center;pointer-events:none}.protocol-routes>span{border-top:1px solid var(--line);text-align:center;font:9px var(--font-mono);color:var(--brand);padding-top:6px}.protocol-packet{position:absolute;top:0;left:0;z-index:3;background:var(--surface);border:1px solid var(--brand);box-shadow:0 6px 24px #00000018;border-radius:10px;padding:12px;display:flex;gap:10px;align-items:center;width:max-content;max-width:220px;pointer-events:none;opacity:0}.protocol-packet b{display:block;font:11px/1.5 var(--font-mono);color:var(--brand)}.protocol-packet span{display:block;font:9px/1.6 var(--font-mono);color:var(--muted);margin-top:3px}
 .flow-step-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:18px}.flow-step-nav button{border:0;border-top:2px solid var(--line);background:none;color:var(--muted);text-align:left;padding:11px 0;font-size:11px;line-height:1.4}.flow-step-nav button span{display:block;font:9px var(--font-mono);margin-bottom:4px}.flow-step-nav button[aria-current]{border-color:var(--brand);color:var(--brand);font-weight:600}
 .flow-narrator{background:var(--surface);border:1px solid var(--line);border-radius:13px;padding:22px}.stage-heading{margin-bottom:20px}.stage-heading h4{font-size:22px;letter-spacing:-.03em;line-height:1.3;margin:9px 0}.presentation-flow .stage-heading p{font-size:13px!important;line-height:1.75!important;margin:0!important;color:var(--muted)}.object-label{display:block;font:9px/1.6 var(--font-mono);text-transform:uppercase;letter-spacing:.025em;color:var(--muted);margin-bottom:13px}
 .issue-layout,.disclosure-layout,.binding-layout,.verify-layout{display:grid;grid-template-columns:1fr 1fr;gap:18px}.signed-vc,.decoded-claims,.request-card,.disclosure-preview,.binding-card,.rp-result{min-width:0;border:1px solid var(--line);border-radius:10px;background:var(--soft);padding:17px}.signed-vc{border-top:3px solid var(--brand)}.presentation-flow dl{margin:0}.presentation-flow dl>div{display:grid;grid-template-columns:75px minmax(0,1fr);gap:7px;margin:0 0 9px;align-items:start}.presentation-flow dt{font:10px/1.7 var(--font-mono);color:var(--muted)}.presentation-flow dd{font:11px/1.65 var(--font-mono);margin:0;overflow-wrap:anywhere;color:var(--ink)}.presentation-flow .key-binding-row{border-top:1px solid var(--line);padding-top:11px;margin-top:12px}.key-binding-row dd{display:flex;gap:5px;align-items:center;flex-wrap:wrap;color:var(--flow-purple);--fa-primary-color:var(--flow-purple)}.key-binding-row dd span{font-size:9px}.object-seal{display:flex;align-items:center;gap:6px;font:9px/1.6 var(--font-mono);color:var(--brand);margin-top:13px}.decoded-claims dl>div{grid-template-columns:1fr}.decoded-claims dd{font-size:12px}.presentation-flow .small-note{font-size:11px!important;line-height:1.75!important;color:var(--muted);margin:15px 0 0!important}.request-card{border-top:3px solid var(--flow-amber)}.request-card dl>div{grid-template-columns:90px minmax(0,1fr)}.request-card dd{color:var(--flow-amber)}.profile-label{display:block;font-size:11px;line-height:1.5;color:var(--muted);margin:16px 0 7px}.request-card select{width:100%;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:7px;padding:9px;font-size:12px}.request-missing{font-size:12px!important;line-height:1.7!important;color:var(--flow-red);margin:14px 0 0!important}.request-footer{font:9px var(--font-mono);color:var(--muted);display:block;margin-top:15px}
 .claim-picker{border:0;padding:0;margin:0;min-width:0}.claim-picker legend{font:9px/1.6 var(--font-mono);color:var(--muted);margin-bottom:11px}.claim-choice{display:flex;gap:10px;align-items:flex-start;padding:11px 0;border-bottom:1px solid var(--line);cursor:pointer}.claim-choice input{accent-color:var(--flow-purple);margin-top:4px;width:15px;height:15px;flex-shrink:0}.claim-choice>span{min-width:0}.claim-choice strong{font-size:12px;line-height:1.5;display:block}.claim-choice code{display:block;font:9px/1.6 var(--font-mono);padding:0;background:none;color:var(--muted);overflow-wrap:anywhere;margin-top:3px}.claim-choice small{font-size:9px;line-height:1.5;margin-left:auto;color:var(--muted)}.claim-required{color:var(--flow-green)}.disclosure-preview{border-top:3px solid var(--flow-purple)}[data-selected-claims] :global(code),[data-received-claims] :global(code){display:block;background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:8px 10px;font:10px/1.7 var(--font-mono);overflow-wrap:anywhere;margin-bottom:8px;color:var(--flow-green)}.disclosure-count{display:block;font:10px var(--font-mono);color:var(--flow-purple);margin-top:14px}
 .binding-card{border-top:3px solid var(--brand)}.holder-binding{border-top-color:var(--flow-purple)}.binding-card>code{background:none;padding:0;font:11px var(--font-mono);color:var(--muted)}.binding-key{display:flex;align-items:center;gap:10px;margin:18px 0;color:var(--flow-purple);--fa-primary-color:var(--flow-purple);font-size:14px}.binding-key-tag{display:block;font:9px/1.7 var(--font-mono);color:var(--flow-purple);overflow-wrap:anywhere}.holder-stamp{display:flex;gap:8px;align-items:center;color:var(--flow-purple);--fa-primary-color:var(--flow-purple);font-size:12px;margin:15px 0}.holder-binding dl>div{grid-template-columns:53px minmax(0,1fr)}.holder-binding dd{font-size:10px;color:var(--flow-purple)}
 .rp-result{border-top:3px solid var(--flow-green)}.verification-verdict{font-size:13px;line-height:1.6;display:block;color:var(--muted);margin-top:16px}.verification-verdict[data-valid="true"]{color:var(--flow-green)}.verification-verdict[data-valid="false"]{color:var(--flow-red)}.presentation-flow .verification-checks{padding:0;margin:0;list-style:none;display:grid;align-content:start;gap:13px}.verification-checks li{font-size:11px;line-height:1.65;display:flex;align-items:center;gap:7px;color:var(--muted);margin:0}.verification-checks li :global(.fa-icon){opacity:.3}.verification-checks b{margin-left:auto;font:10px var(--font-mono)}.verification-checks li[data-valid="true"]{color:var(--flow-green);--fa-primary-color:var(--flow-green)}.verification-checks li[data-valid="true"] :global(.fa-icon){opacity:1}.verification-checks li[data-valid="false"]{color:var(--flow-red);--fa-primary-color:var(--flow-red)}.check-pass,.check-fail{display:inline-flex}.check-fail{display:none}.verification-checks li[data-valid="false"] .check-pass{display:none}.verification-checks li[data-valid="false"] .check-fail{display:inline-flex}.verification-checks li[data-valid="false"] :global(.fa-icon){opacity:1}.transfer-tests{display:flex;flex-wrap:wrap;gap:8px;margin-top:19px}.transfer-tests button{font-size:10px;line-height:1.6;display:flex;align-items:center;gap:7px;padding:9px 11px;border:1px solid var(--line);border-radius:7px;background:var(--soft);color:var(--ink)}.transfer-tests button:disabled{opacity:.5}.presentation-flow .attack-result{color:var(--flow-red);font-size:12px!important;line-height:1.75!important;margin:14px 0 0!important}.transfer-limit{border-top:1px solid var(--line);padding-top:13px}
 .flow-consent{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:14px}.flow-consent>span{width:100%;font-size:10px;line-height:1.6;color:var(--muted)}.flow-consent button,.flow-controls button{font-size:11px;line-height:1.5;border:1px solid var(--line);border-radius:7px;background:var(--surface);color:var(--ink);padding:10px 12px}.flow-consent button:first-of-type{display:flex;gap:8px;align-items:center;color:var(--flow-purple);--fa-primary-color:var(--flow-purple)}.flow-controls{display:flex;gap:8px;margin-top:18px}.flow-controls button:last-child{margin-left:auto}.flow-controls button:disabled{opacity:.4}.flow-controls button:hover:not(:disabled),.transfer-tests button:hover:not(:disabled){border-color:var(--brand)}.flow-consent[hidden],.flow-controls[hidden],.flow-step-nav[hidden],.transfer-tests[hidden]{display:none}.presentation-flow .flow-refused,.presentation-flow .demo-unavailable{font-size:12px!important;line-height:1.7!important;color:var(--flow-red);margin:14px 0 0!important}
 .presentation-flow figcaption{font-size:10px;line-height:1.8;color:var(--muted);margin-top:18px}.flow-technical{border-top:1px solid var(--line);padding-top:16px;margin-top:17px}.flow-technical summary{cursor:pointer;color:var(--brand);font-size:12px;font-weight:600;line-height:1.7}.technical-content{padding-top:16px}.presentation-flow .technical-content p,.technical-content li{font-size:11px!important;line-height:1.8!important}.presentation-flow .technical-content p{margin:0 0 13px!important}.payload-detail{margin:12px 0}.payload-detail summary{font-size:11px;font-weight:500}.payload-detail pre{padding:15px!important;margin:10px 0!important;background:var(--surface)!important;border:1px solid var(--line);border-radius:8px;white-space:pre-wrap!important;overflow-wrap:anywhere;max-height:400px;overflow:auto}.payload-detail code{font:10px/1.8 var(--font-mono)!important;background:none!important;padding:0!important;color:var(--ink)}.technical-content h4{font-size:14px;line-height:1.5;margin:22px 0 10px}.technical-content ol{padding-left:20px;margin:0 0 15px}.technical-content li{margin-bottom:10px}.protocol-sources a{text-decoration:underline;text-underline-offset:3px}
 .presentation-flow[data-phase="0"] .actor-issuer{border-color:var(--brand)}.presentation-flow[data-phase="1"] .actor-rp{border-color:var(--flow-amber)}.presentation-flow[data-phase="2"] .actor-wallet,.presentation-flow[data-phase="3"] .actor-wallet{border-color:var(--flow-purple);box-shadow:0 0 0 2px color-mix(in srgb,var(--flow-purple) 9%,transparent)}.presentation-flow[data-phase="4"] .actor-rp{border-color:var(--flow-green)}.presentation-flow[data-phase="4"][data-demo-state="ready"] .rp-wait{display:none}.presentation-flow[data-phase="4"][data-demo-state="ready"] .rp-verified{display:flex}
 .presentation-flow[data-phase="4"][data-verification="false"] .actor-rp{border-color:var(--flow-red)}
