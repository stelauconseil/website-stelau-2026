---
import Icon from '@/components/Icon/Icon.astro';
import PostCard from '@/components/PostCard/PostCard.astro';import {getAllPosts} from '@/js/blogUtils';import {href,categoriesHref,categoryLabel,type Locale} from '@/config/site';
const {lang,category}=Astro.props as {lang:Locale;category?:string};const fr=lang==='fr';const all=await getAllPosts(lang);const posts=category?all.filter(p=>p.data.categories.includes(category)):all;const categories=[...new Set(all.flatMap(p=>p.data.categories))];
---
<div class="container page-intro journal-intro"><p class="eyebrow icon-eyebrow"><span class="section-icon"><Icon name="book-open" size={22}/></span>{fr?'Le Blog / Recherche, code et idées':'Journal / Research, code and ideas'}</p><h1>{fr?'Dans les coulisses':'Behind the scenes'}<br/><em>{fr?'de la confiance.':'of digital trust.'}</em></h1><p class="lead">{fr?'Nos implémentations, nos analyses et ce que nous apprenons en chemin. Écrit par les ingénieurs qui font le travail.':'Our implementations, our analysis and what we learn along the way. Written by the engineers doing the work.'}</p></div><section class="container blog-list"><nav class="category-tabs" aria-label={fr?'Catégories du Blog':'Journal categories'}><a href={href(lang,'blog')} aria-current={!category?'page':undefined}><Icon name="list" size={18}/>{fr?'Tous les articles':'All articles'}</a>{categories.map(c=><a href={categoriesHref(lang,c)} aria-current={category===c?'page':undefined}><Icon name="tags" size={18}/>{categoryLabel(c,lang)}</a>)}</nav><div class="posts-grid">{posts.map((p,i)=><PostCard post={p} lang={lang} featured={i===0&&!category}/>)}</div></section>
